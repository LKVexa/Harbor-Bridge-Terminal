**/node_modules/
**/dist/
**/_runs/
**/__pycache__/
*.pyc
.DS_Store
Thumbs.db

# QVM product junction / accidental full tree — keep PRODUCT_LINK.txt only
qvm/product/
qvm/product/**
# Per-instance runtime caches (results, last_probe)
qnodes/**/runtime/**
!qnodes/**/runtime/.gitkeep
bridge-terminal/.vws-local/

# Full QVM product copies under each QN-XX (~17 MB × 50). Recreate with:
#   scripts\materialize-qnode-copies.cmd
# Keep Harbor metadata tracked (IDENTITY.json, QNODE.cmd).
qnodes/QN-*/**
!qnodes/QN-*/
!qnodes/QN-*/IDENTITY.json
!qnodes/QN-*/QNODE.cmd
!qnodes/QN-*/HARBOR_README.md
!qnodes/QN-*/runtime/
!qnodes/QN-*/runtime/.gitkeep
