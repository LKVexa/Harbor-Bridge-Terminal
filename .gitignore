**/node_modules/
**/dist/
**/_runs/
**/__pycache__/
*.pyc
.DS_Store
Thumbs.db

# QVM product junction / accidental full tree - keep PRODUCT_LINK.txt only
qvm/product/
qvm/product/**
# Per-instance runtime caches (results, last_probe)
qnodes/**/runtime/**
!qnodes/**/runtime/.gitkeep
bridge-terminal/.vws-local/

# Full QVM product copies under each QN-XX (~17 MB x 50). Recreate with:
#   scripts\materialize-qnode-copies.cmd
# Keep Harbor metadata tracked (IDENTITY.json, QNODE.cmd).
qnodes/QN-*/**
!qnodes/QN-*/
!qnodes/QN-*/IDENTITY.json
!qnodes/QN-*/QNODE.cmd
!qnodes/QN-*/HARBOR_README.md
!qnodes/QN-*/runtime/
!qnodes/QN-*/runtime/.gitkeep

# Local loopback sign-in token (never commit)
ACCESS_TOKEN.txt
bridge-terminal/.vws-local/

# VB-JA21 Portable Optical Desktop junction / bulk tree (~800 MB).
# Keep PRODUCT_LINK.txt + VERSION + README; rematerialize with:
#   scripts\link-optical-desktop.cmd
optical-desktop/portable/
optical-desktop/portable/**
optical-desktop/JA21-Portable-Desktop-*/
optical-desktop/workspace/
# Mobile platform junctions / bulky product trees + compiler output.
# Keep PRODUCT_LINK/VERSION/IDENTITY/README/compiler sources; rematerialize with:
#   scripts\link-mobile-platform.cmd
mobile-platform/bottle-rocket/product/
mobile-platform/bottle-rocket/product/**
mobile-platform/nodes/*/product/
mobile-platform/nodes/*/product/**
mobile-platform/nodes/*/sidecar-*/product/
mobile-platform/nodes/*/sidecar-*/product/**
mobile-platform/compiler/out/
mobile-platform/compiler/out/**
mobile-platform/compiler/auth-queue/*.json
!mobile-platform/compiler/auth-queue/README.md
mobile-platform/compiler/auth-queue/processed/

# Mobile compiler build/delivery logs (evidence snapshots live under docs/verification/)
mobile-platform/compiler/logs/
mobile-platform/compiler/logs/**
!mobile-platform/compiler/bin/
!mobile-platform/compiler/bin/**

# Mobile cubby runtime sessions (registry fleet/CUBBIES.json stays tracked; mobile_cubbies grow there)
mobile-platform/compiler/cubbies/sessions/
mobile-platform/compiler/cubbies/sessions/**
# Mobile BR serve state prefixes (per-cubby brctl serve --state)
mobile-platform/compiler/cubbies/serve-states/
mobile-platform/compiler/cubbies/serve-states/**

# Windows path hygiene / local bulky trees
containership/**/build/
containership/**/*.egg-info/
mobile-platform/compiler/out/
mobile-platform/compiler/cubbies/sessions/
mobile-platform/compiler/cubbies/serve-states/
mobile-platform/compiler/auth-queue/*.json
mobile-platform/compiler/logs/
mobile-platform/**/product/
optical-desktop/portable/
