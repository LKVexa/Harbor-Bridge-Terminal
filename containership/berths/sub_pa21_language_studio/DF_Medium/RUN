#!/bin/sh
# sub_pa21_language_studio/DF_Medium/RUN -- delegates to the ship (uc.py slot-run sub_pa21_language_studio DF_Medium). Offline; NETWORK=deny.
set -eu
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PY="${PYTHON:-python3}"
exec "$PY" -B "$HERE/../../../uc.py" slot-run sub_pa21_language_studio DF_Medium "$@"
