HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PY="${PYTHON:-python3}"
exec "$PY" -B "$HERE/../../../uc.py" slot-run sub_pa21_language_studio DF_Small "$@"
