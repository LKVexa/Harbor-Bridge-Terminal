    "history": [
      {
        "change": "initial policy (UC-1.0.0)",
        "version": "1.0.0"
      },
      {
        "change": "measurement fix: the binary sniff tolerates a UTF-8 multibyte character cut at the 4096-byte sniff boundary; 1.0.0 misread a columned-LCTL unit longer than the sniff (its U+2502 separators) as binary and sent it to N_XLARGE as bulk instead of its own node",
        "version": "1.0.1"
      }
    ],
    "nodes": [
      "N_SMALL",
      "N_MEDIUM",
      "N_LARGE",
      "N_XLARGE"
    ],
    "rules": [
      {
        "id": "S0",
        "rule": "a script written in a node's own guest dialect goes to that node: MSSL assembly -> N_SMALL, LCTLC/1.1 -> N_MEDIUM, LCTLC/1.2 -> N_LARGE, LCTLC/1.0 (QVM profile) -> N_XLARGE"
      },
      {
        "id": "S1",
        "rule": "a PA-LCTL bundle (.pal) goes to N_MEDIUM, the reference node the corpora's own adapter binds"
      },
      {
        "id": "S2",
        "rule": "bulk cargo -- archives, images, binaries, media, PDFs, or anything >= 1 MiB -- goes to N_XLARGE, the roomiest, hosted node"
      },
      {
        "id": "S3",
        "rule": "hosted-runtime source (Python, Java, JavaScript/TypeScript, HTML/CSS/SVG, notebooks) and Columned LCTL plans (.lctl, verified by the JVM column verifier) go to N_XLARGE, the Python-hosted node with the JVM verifier"
      },
      {
        "id": "S4",
        "rule": "native/system source (C, C++, headers, assembly, Makefiles, linker scripts) goes to N_LARGE, the freestanding C core with the device I/O and service architecture"
      },
      {
        "id": "S5",
        "rule": "integrity and contract artifacts (sums, signatures, keys, manifests, schemas, provenance, ledgers, trust stores) go to N_MEDIUM, the node with signing, the trust chain and the independent verifier"
      },
      {
        "id": "S6",
        "rule": "structured data and configuration go by size: <= 4 KiB -> N_SMALL, <= 256 KiB -> N_MEDIUM, larger -> N_LARGE"
      },
      {
        "id": "S7",
        "rule": "launchers and shell/batch scripts go by complexity band: LOW -> N_SMALL, MID -> N_MEDIUM, HIGH -> N_LARGE, VERY_HIGH -> N_XLARGE"
      },
      {
        "id": "S8",
        "rule": "documents and notes go by size: <= 8 KiB -> N_SMALL (teaching), <= 128 KiB -> N_MEDIUM, larger -> N_LARGE"
      },
      {
        "id": "S9",
        "rule": "everything else goes by complexity band: LOW -> N_SMALL, MID -> N_MEDIUM, HIGH -> N_LARGE, VERY_HIGH -> N_XLARGE"
      }
    ],
    "schema": "UC/SORT_POLICY/1",
    "version": "1.0.1"
  },
