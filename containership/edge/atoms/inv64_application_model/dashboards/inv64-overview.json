{
  "format": "PK_APP_DASHBOARD/1",
  "title": "INV-64 Application model",
  "tenant_safe": "No panel uses tenant/workload as a label; tenant breakdowns come from logs with viewer-scoped queries.",
  "rows": [
    {"title": "Golden signals", "panels": [
      {"title": "Requests by outcome", "metric": "inv64_requests_total", "by": ["operation", "outcome"]},
      {"title": "Latency p50/p95/p99", "metric": "inv64_latency_ms", "by": ["operation"]},
      {"title": "Rejections by code", "metric": "inv64_rejections_total", "by": ["code"]},
      {"title": "In-flight vs limit", "metric": "inv64_inflight", "by": []}]},
    {"title": "Classification (C080)", "panels": [
      {"title": "Load: admission rejections", "metric": "inv64_admission_rejected_total", "by": ["reason"]},
      {"title": "Dependency outage", "metric": "inv64_dependency_failures_total", "by": ["dependency"]},
      {"title": "Policy rejection (manifest/secret codes)", "metric": "inv64_rejections_total", "by": ["code"]},
      {"title": "Attack: authn denied / replay", "metric": "inv64_authn_total", "by": ["outcome"]},
      {"title": "Defect: internal errors", "metric": "inv64_rejections_total", "by": ["code"]}]},
    {"title": "Change safety", "panels": [
      {"title": "Activations", "metric": "inv64_activation_total", "by": ["result"]},
      {"title": "Rollbacks", "metric": "inv64_rollback_total", "by": ["trigger"]}]},
    {"title": "Integrity & self-health", "panels": [
      {"title": "Audit dropped (must be 0)", "metric": "inv64_audit_dropped_total", "by": []},
      {"title": "Audit buffered", "metric": "inv64_audit_buffered", "by": []},
      {"title": "Log drops / sink errors", "metric": "inv64_log_dropped_total", "by": []},
      {"title": "Label overflow", "metric": "inv64_telemetry_label_overflow_total", "by": ["metric"]}]}
  ]
}
