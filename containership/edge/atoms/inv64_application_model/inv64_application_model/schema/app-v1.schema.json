{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv64:application-model:app-v1",
  "title": "INV-64 Application Manifest app/v1",
  "type": "object",
  "required": ["schema"],
  "properties": {
    "schema": {"const": "app/v1"},
    "components": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/namedDeclaration"}
    },
    "providers": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/namedDeclaration"}
    },
    "links": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {"$ref": "#/$defs/name"},
          "to": {"$ref": "#/$defs/name"}
        },
        "additionalProperties": true
      }
    },
    "traits": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "required": ["type", "component"],
        "properties": {
          "type": {"$ref": "#/$defs/name"},
          "component": {"$ref": "#/$defs/name"}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,127})$"
    },
    "namedDeclaration": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/name"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
