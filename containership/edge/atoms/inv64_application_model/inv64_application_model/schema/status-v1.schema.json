{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv64:status:v1",
  "title": "PK_APP_STATUS/1",
  "type": "object",
  "required": [
    "format",
    "live",
    "ready",
    "state",
    "reasons",
    "versions",
    "capabilities",
    "isolation_profile",
    "dependencies"
  ],
  "properties": {
    "format": {
      "const": "PK_APP_STATUS/1"
    },
    "live": {
      "type": "boolean"
    },
    "ready": {
      "type": "boolean"
    },
    "state": {
      "enum": [
        "ready",
        "degraded",
        "blocked"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "runbook"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "degraded",
              "blocked"
            ]
          },
          "runbook": {
            "type": "string"
          }
        }
      }
    },
    "versions": {
      "type": "object"
    },
    "capabilities": {
      "type": "array"
    },
    "isolation_profile": {
      "type": "string"
    },
    "config": {},
    "dependencies": {
      "type": "object"
    },
    "inflight": {
      "type": "integer"
    }
  }
}
