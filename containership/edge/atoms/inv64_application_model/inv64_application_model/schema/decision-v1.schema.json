{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv64:decision:v1",
  "title": "PK_APP_DECISION/1",
  "type": "object",
  "required": [
    "schema",
    "decision_id",
    "type",
    "outcome",
    "reason_codes",
    "dominant_constraint",
    "inputs",
    "versions",
    "lineage",
    "infrastructure",
    "alternatives",
    "tenant",
    "correlation_id",
    "ts"
  ],
  "properties": {
    "schema": {
      "const": "PK_APP_DECISION/1"
    },
    "dominant_constraint": {
      "enum": [
        null,
        "security",
        "residency",
        "isolation",
        "capacity",
        "slo",
        "cost",
        "validity",
        "defect"
      ]
    },
    "infrastructure": {
      "type": "object",
      "properties": {
        "graph_state": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        }
      }
    }
  }
}
