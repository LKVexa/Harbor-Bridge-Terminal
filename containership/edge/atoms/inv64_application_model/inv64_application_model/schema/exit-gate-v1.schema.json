{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv64:exit-gate:v1",
  "title": "PK_APP_EXIT_GATE/1",
  "type": "object",
  "required": [
    "schema",
    "element",
    "version",
    "gate_policy_version",
    "spec_version",
    "oam_baseline",
    "isolation_profile",
    "build_digest",
    "source_corpus_sha256",
    "source_revision",
    "python",
    "today",
    "verdict",
    "blockers",
    "conditions",
    "controls",
    "evidence_digests",
    "input_digest",
    "generated_at"
  ],
  "properties": {
    "schema": {
      "const": "PK_APP_EXIT_GATE/1"
    },
    "element": {
      "const": "INV-64"
    },
    "verdict": {
      "enum": [
        "GO",
        "CONDITIONAL_GO",
        "NO_GO"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control",
          "file",
          "severity",
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    },
    "evidence_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
