{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv64:error:v1",
  "title": "PK_APP_ERROR/1",
  "type": "object",
  "required": [
    "version",
    "code",
    "status",
    "message",
    "retryable",
    "correlation_id",
    "details"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "PK_APP_ERROR/1"
    },
    "code": {
      "enum": [
        "activation.conflict",
        "activation.no_known_good",
        "activation.quarantined",
        "activation.state",
        "admission.overloaded",
        "admission.tenant_quota",
        "artifact.digest",
        "artifact.provenance",
        "artifact.revoked",
        "artifact.signature",
        "artifact.version",
        "auth.algorithm",
        "auth.audience",
        "auth.expired",
        "auth.issuer",
        "auth.lifetime",
        "auth.malformed",
        "auth.missing",
        "auth.not_yet_valid",
        "auth.rate_limited",
        "auth.replay",
        "auth.revoked",
        "auth.signature",
        "auth.trust_unavailable",
        "authz.denied",
        "authz.policy_invalid",
        "crypto.key_retired",
        "crypto.unavailable",
        "deadline.exceeded",
        "deadline.invalid",
        "idempotency.conflict",
        "idempotency.invalid",
        "internal",
        "manifest.duplicate_key",
        "manifest.invalid",
        "manifest.parse",
        "manifest.too_deep",
        "manifest.too_large",
        "overlay.conflict",
        "overlay.immutable",
        "overlay.invalid",
        "overlay.scope",
        "overlay.stale_parent",
        "request.cancelled",
        "request.invalid",
        "secret.inline",
        "service.disabled",
        "tenant.cross_reference",
        "tenant.mismatch",
        "version.downgrade_refused",
        "version.unsupported"
      ]
    },
    "status": {
      "type": "integer"
    },
    "message": {
      "type": "string",
      "maxLength": 200
    },
    "retryable": {
      "type": "boolean"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": "object",
      "maxProperties": 64
    }
  },
  "x-compatibility": "adding a code = minor; removing or changing meaning/retryability = major"
}
