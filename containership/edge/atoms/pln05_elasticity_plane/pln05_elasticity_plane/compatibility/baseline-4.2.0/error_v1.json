{
  "$id": "urn:pk:schema:PK_ERROR:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "category": {
      "type": "string"
    },
    "code": {
      "pattern": "^E_[A-Z_]+$",
      "type": "string"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "detail": {
      "type": "object"
    },
    "message": {
      "maxLength": 200,
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "schema": {
      "const": "PK_ERROR/1"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    }
  },
  "required": [
    "schema",
    "code",
    "category",
    "retryable",
    "severity",
    "message",
    "detail",
    "correlation_id"
  ],
  "title": "PK_ERROR/1 structured error",
  "type": "object"
}
