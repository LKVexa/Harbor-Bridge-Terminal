   "name": "process crash/restart",
   "failures": [
    "F01",
    "F06"
   ],
   "injection": "kill plane mid-stream; restart from state dir",
   "expected": "next decision continues hysteresis exactly; no duplicate effect",
   "max_detection_s": 0,
   "max_recovery_s": 0,
   "test": "tests/fault/test_faults.py::Faults.test_FS01"
  },
  "FS02": {
   "name": "exception loop",
   "failures": [
    "F02"
   ],
   "injection": "sink raises internal errors repeatedly",
   "expected": "decisions persisted; breaker opens; plane stays live",
   "max_detection_s": 0,
   "max_recovery_s": 0,
   "test": "tests/fault/test_faults.py::Faults.test_FS02"
  },
  "FS03": {
   "name": "event-loop stall",
   "failures": [
    "F03"
   ],
   "injection": "queue items, advance monotonic clock without processing",
