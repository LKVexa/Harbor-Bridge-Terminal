{
 "manifest": "PLN05_FAULT_SCENARIOS/1",
 "invariants": [
  "INV-A target within [floor, ceiling] of the active envelope",
  "INV-B nothing published without a valid lease",
  "INV-C fencing tokens applied downstream are non-decreasing per scope",
  "INV-D audit chain verifies after the scenario",
  "INV-E no authority expansion (ceiling never above declared)"
 ],
 "scenarios": {
