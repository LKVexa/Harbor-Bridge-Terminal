{
  "$id": "urn:pk:schema:PK_CAPACITY_TARGET:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ceiling": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "config_checksum": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 64,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]{8,64}$",
      "type": "string"
    },
    "decided_at": {
      "description": "Unix epoch seconds (UTC); freshness is judged against the plane's trusted clock",
      "maximum": 32503680000,
      "minimum": 0,
      "type": "number"
    },
    "decision_id": {
      "maxLength": 64,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9._:-]{8,64}$",
      "type": "string"
    },
    "demand_message_id": {
      "maxLength": 64,
      "type": [
        "string",
        "null"
      ]
    },
    "epoch": {
      "minimum": 1,
      "type": "integer"
    },
    "fencing_token": {
      "description": "Downstream consumers must reject a token lower than the highest seen",
      "minimum": 1,
      "type": "integer"
    },
    "floor": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "scale-up",
        "scale-down",
        "hold",
        "constrained-hold",
        "stale-input-hold",
        "frozen",
        "degraded",
        "recovery"
      ]
    },
    "previous": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "reason": {
      "maxLength": 120,
      "type": "string"
    },
    "reason_code": {
      "pattern": "^R_[A-Z_]{2,40}$",
      "type": "string"
    },
    "schema": {
      "const": "PK_CAPACITY_TARGET/1"
    },
    "site": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "target": {
      "description": "Absolute target (not a delta)",
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "tenant": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "traceparent": {
      "description": "W3C traceparent",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "type": "string"
    },
    "workload": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "decision_id",
    "tenant",
    "site",
    "workload",
    "target",
    "previous",
    "outcome",
    "reason_code",
    "floor",
    "ceiling",
    "epoch",
    "fencing_token",
    "config_checksum",
    "decided_at"
  ],
  "title": "PK_CAPACITY_TARGET/1 emitted absolute capacity target",
  "type": "object",
  "x-compatibility": "Adding an optional field or an x- extension is non-breaking (minor). Removing/renaming a field, tightening a range, or changing units is breaking and requires a new major schema id (/2).",
  "x-extension-rule": "Top-level keys beginning with 'x-' are non-critical extensions and are ignored; any other unknown key is a critical extension and is rejected (E_SCHEMA_UNKNOWN_CRITICAL).",
  "x-schema-version": "1.0.0"
}
