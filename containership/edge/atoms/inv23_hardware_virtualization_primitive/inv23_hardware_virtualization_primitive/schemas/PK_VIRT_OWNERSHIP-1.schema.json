{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linearfinance.org/schemas/inv23/PK_VIRT_OWNERSHIP-1.schema.json",
  "title": "PK_VIRT_OWNERSHIP/1",
  "description": "Persisted ownership record. token_sha256 is sensitive (hash of the authority token) and must not be logged.",
  "type": "object",
  "required": [
    "schema",
    "resource",
    "state",
    "generation",
    "provider"
  ],
  "properties": {
    "schema": {
      "const": "PK_VIRT_OWNERSHIP/1"
    },
    "resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "state": {
      "enum": [
        "held",
        "released"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "claim_id": {
      "type": "string"
    },
    "token_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "x-sensitive": true
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "process_start": {
      "type": [
        "string",
        "null"
      ]
    },
    "boot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "host": {
      "type": "string"
    },
    "holder": {
      "type": "string"
    },
    "acquired_at": {
      "type": "number"
    },
    "lease_expires_at": {
      "type": "number"
    },
    "lease_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "released_at": {
      "type": "number"
    },
    "provider": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "maxItems": 16
    }
  },
  "additionalProperties": false
}
