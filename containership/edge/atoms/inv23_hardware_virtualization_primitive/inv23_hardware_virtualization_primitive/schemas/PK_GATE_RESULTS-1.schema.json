{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linearfinance.org/schemas/inv23/PK_GATE_RESULTS-1.schema.json",
  "title": "PK_GATE_RESULTS/1",
  "description": "INV-23 production gate result emitted by tools/gate.py.",
  "type": "object",
  "required": [
    "schema",
    "element",
    "version",
    "verdict",
    "certifiable",
    "generated_at",
    "source",
    "environment",
    "counts",
    "checks",
    "mandatory_jobs",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "PK_GATE_RESULTS/1"
    },
    "element": {
      "const": "INV-23"
    },
    "version": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "GO",
        "CONDITIONAL_GO",
        "NO_GO",
        "BLOCKED"
      ]
    },
    "certifiable": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "environment": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    },
    "checks": {
      "type": "array"
    },
    "mandatory_jobs": {
      "type": "object"
    },
    "artifacts": {
      "type": "object"
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "previous_head": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
