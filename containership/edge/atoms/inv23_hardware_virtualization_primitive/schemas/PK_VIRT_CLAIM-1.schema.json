{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linearfinance.org/schemas/inv23/PK_VIRT_CLAIM-1.schema.json",
  "title": "PK_VIRT_CLAIM/1",
  "description": "Legacy in-process claim (VirtPrimitive.claim). Frozen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "host",
    "holder",
    "nesting_depth",
    "bare_metal"
  ],
  "properties": {
    "schema": {
      "const": "PK_VIRT_CLAIM/1"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "holder": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "nesting_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "bare_metal": {
      "type": "boolean"
    }
  }
}
