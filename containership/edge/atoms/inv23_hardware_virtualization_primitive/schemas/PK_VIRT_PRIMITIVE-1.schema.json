{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linearfinance.org/schemas/inv23/PK_VIRT_PRIMITIVE-1.schema.json",
  "title": "PK_VIRT_PRIMITIVE/1",
  "description": "Legacy in-process primitive report (VirtPrimitive.report). Frozen; decoding historical evidence only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "host",
    "state",
    "nesting_depth",
    "bare_metal"
  ],
  "properties": {
    "schema": {
      "const": "PK_VIRT_PRIMITIVE/1"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^\\S(.*\\S)?$"
    },
    "state": {
      "enum": [
        "usable",
        "present-disabled",
        "absent",
        "claimed"
      ]
    },
    "nesting_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "bare_metal": {
      "type": "boolean"
    }
  }
}
