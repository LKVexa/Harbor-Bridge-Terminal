{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PK_ERROR/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "code",
    "message",
    "details"
  ],
  "properties": {
    "schema": {
      "const": "PK_ERROR/1"
    },
    "code": {
      "enum": [
        "attestation_bad_mac",
        "attestation_clock_skew",
        "attestation_expired",
        "attestation_expired_key",
        "attestation_malformed",
        "attestation_node_mismatch",
        "attestation_oversize",
        "attestation_payload_mismatch",
        "attestation_replay",
        "attestation_revoked_key",
        "attestation_schema",
        "attestation_unknown_key",
        "authn_failed",
        "authz_denied",
        "bad_request",
        "circuit_open",
        "cross_tenant_disabled",
        "cross_tenant_forbidden_by_policy",
        "deadline_exceeded",
        "dependency_unavailable",
        "gap02_readback_contradiction",
        "idempotency_conflict",
        "internal_error",
        "node_quarantined",
        "not_found",
        "overloaded",
        "payload_too_large",
        "placement_frozen",
        "posture_absent",
        "posture_stale",
        "posture_stale_epoch",
        "rate_limited",
        "required_mitigation_missing",
        "schema_version_unrepresentable",
        "unsafe_smt",
        "version_unsupported"
      ],
      "description": "4.3.0 widened this enum additively. Consumers MUST treat any code they do not recognise as a refusal (fail closed)."
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    }
  }
}