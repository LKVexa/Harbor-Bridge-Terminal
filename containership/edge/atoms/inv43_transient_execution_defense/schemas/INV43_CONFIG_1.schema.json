{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INV43_CONFIG/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cross_tenant_placement_enabled",
    "log_redact_tenants",
    "max_inflight",
    "max_request_bytes",
    "policy_path",
    "posture_ttl_s",
    "rate_per_s",
    "request_timeout_s",
    "require_attestation",
    "schema",
    "unknown_smt_is_enabled"
  ],
  "properties": {
    "schema": {
      "const": "INV43_CONFIG/1"
    },
    "posture_ttl_s": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 3600.0
    },
    "require_attestation": {
      "const": true
    },
    "unknown_smt_is_enabled": {
      "type": "boolean"
    },
    "max_request_bytes": {
      "type": "integer",
      "minimum": 256,
      "maximum": 1048576
    },
    "max_inflight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "rate_per_s": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 100000.0
    },
    "request_timeout_s": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 30.0
    },
    "cross_tenant_placement_enabled": {
      "type": "boolean"
    },
    "log_redact_tenants": {
      "type": "boolean"
    },
    "policy_path": {
      "type": "string"
    }
  }
}