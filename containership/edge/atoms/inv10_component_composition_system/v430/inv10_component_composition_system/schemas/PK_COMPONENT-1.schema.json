{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_COMPONENT/1",
  "title": "PK_COMPONENT/1",
  "description": "A component with declared imports and exports. Closed: unknown top-level fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name"],
  "properties": {
    "schema": {"const": "PK_COMPONENT/1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 512},
    "imports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}, "default": []},
    "exports": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}, "default": []},
    "metadata": {"type": "object", "description": "Non-identity metadata (language, module digest, tenant); not hashed into PK_COMPOSITION_ID/2."}
  }
}
