{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_HEARTBEAT/1",
  "title": "Signed control-plane heartbeat v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "site",
    "nonce",
    "time",
    "key_id",
    "issuer",
    "alg",
    "sig"
  ],
  "properties": {
    "version": {
      "const": "PK_HEARTBEAT/1"
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "alg": {
      "const": "Ed25519"
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
