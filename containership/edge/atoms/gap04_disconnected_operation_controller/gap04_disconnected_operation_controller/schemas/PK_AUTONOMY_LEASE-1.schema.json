{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_AUTONOMY_LEASE/1",
  "title": "PK Autonomy Lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "site",
    "granted_at",
    "expires_at",
    "remaining_ticks",
    "policy_cached_at",
    "max_policy_staleness_ticks"
  ],
  "properties": {
    "schema": {
      "const": "PK_AUTONOMY_LEASE/1"
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "granted_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "remaining_ticks": {
      "type": "integer",
      "minimum": 0
    },
    "policy_cached_at": {
      "type": "integer",
      "minimum": 0
    },
    "max_policy_staleness_ticks": {
      "type": "integer",
      "minimum": 1
    }
  }
}
