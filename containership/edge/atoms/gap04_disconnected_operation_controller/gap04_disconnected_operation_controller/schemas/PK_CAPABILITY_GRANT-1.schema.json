{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_CAPABILITY_GRANT/1",
  "title": "PLN-07 capability grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "grant_id",
    "site",
    "principal",
    "capabilities",
    "epoch",
    "not_before",
    "expires_at",
    "key_id",
    "issuer",
    "alg",
    "sig"
  ],
  "properties": {
    "version": {
      "const": "PK_CAPABILITY_GRANT/1"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "not_before": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "alg": {
      "const": "Ed25519"
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
