{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_DEGRADATION_TIER/1",
  "title": "PK Degradation Tier v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "site",
    "at",
    "tier",
    "permitted",
    "partition_epoch"
  ],
  "properties": {
    "schema": {
      "const": "PK_DEGRADATION_TIER/1"
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "at": {
      "type": "integer",
      "minimum": 0
    },
    "tier": {
      "enum": [
        "full",
        "sustain",
        "freeze",
        "expired"
      ]
    },
    "permitted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "partition_epoch": {
      "type": "integer",
      "minimum": 0
    }
  }
}
