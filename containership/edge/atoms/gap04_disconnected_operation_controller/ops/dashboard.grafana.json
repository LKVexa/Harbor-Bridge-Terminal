{
  "title": "GAP-04 Disconnected Operation",
  "schemaVersion": 39,
  "uid": "gap04-main",
  "tags": [
    "gap04"
  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "type": "query",
        "query": "label_values(gap04_tier, site)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tier",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "gap04_tier"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Lease remaining (s)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "gap04_lease_remaining_seconds"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Policy staleness (s)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "gap04_policy_staleness_seconds"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Journal utilization",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "gap04_journal_utilization_ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Decisions/s by kind",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(gap04_decisions_total[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Denials/s by code",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(gap04_denials_total[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Reachability",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "gap04_reachability_state"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Reconcile outcomes",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(gap04_reconcile_outcomes_total[1h]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "decide() p99",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gap04_decision_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Verification failures",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (code) (increase(gap04_verification_failures_total[1h]))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Quarantined",
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "gap04_quarantined"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Load shed/s",
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(gap04_admission_rejections_total[5m])"
        }
      ]
    }
  ]
}