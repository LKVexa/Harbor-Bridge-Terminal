{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_GAP04_ERROR/1",
  "title": "Machine-readable error v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "code",
    "category",
    "retryable",
    "http_status",
    "summary",
    "message",
    "details"
  ],
  "properties": {
    "schema": {
      "const": "PK_GAP04_ERROR/1"
    },
    "code": {
      "type": "string",
      "pattern": "^GAP04-E\\d{4}$"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "retryable": {
      "type": "boolean"
    },
    "http_status": {
      "type": "integer",
      "minimum": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "message": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4096
    },
    "details": {
      "type": "object"
    }
  }
}
