{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_GAP04_CONFIG/1",
  "title": "Site configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "config_version",
    "scope",
    "lease",
    "tier_schedule",
    "max_policy_staleness_s",
    "max_decisions_per_partition",
    "journal",
    "clock",
    "reachability",
    "admission",
    "overrides",
    "reconcile",
    "quotas"
  ],
  "properties": {
    "version": {
      "const": "PK_GAP04_CONFIG/1"
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "object"
    },
    "lease": {
      "type": "object"
    },
    "tier_schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2
      }
    },
    "max_policy_staleness_s": {
      "type": "integer",
      "minimum": 60
    },
    "max_decisions_per_partition": {
      "type": "integer",
      "minimum": 1
    },
    "journal": {
      "type": "object"
    },
    "clock": {
      "type": "object"
    },
    "reachability": {
      "type": "object"
    },
    "admission": {
      "type": "object"
    },
    "overrides": {
      "type": "object"
    },
    "reconcile": {
      "type": "object"
    },
    "quotas": {
      "type": "object"
    }
  }
}
