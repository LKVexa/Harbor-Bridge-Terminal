{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_SUPERVISOR_COMMAND/1",
  "title": "GAP-01 supervisor command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "command_id",
    "kind",
    "subject",
    "authority_epoch",
    "generation",
    "traceparent"
  ],
  "properties": {
    "contract": {
      "const": "PK_SUPERVISOR_COMMAND/1"
    },
    "command_id": {
      "type": "string",
      "pattern": "^d-[0-9a-f]{32}$"
    },
    "kind": {
      "enum": [
        "restart",
        "rebalance",
        "admit-known",
        "admit-new",
        "scale"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authority_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    }
  }
}
