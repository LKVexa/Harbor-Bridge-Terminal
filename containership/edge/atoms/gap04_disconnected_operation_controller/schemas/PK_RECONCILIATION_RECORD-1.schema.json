{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_RECONCILIATION_RECORD/1",
  "title": "PK Reconciliation Record v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "site",
    "partition_epoch",
    "partitioned_since",
    "reconnected_at",
    "lease_granted_at",
    "lease_expires_at",
    "decisions",
    "decision_count",
    "max_policy_age"
  ],
  "properties": {
    "schema": {
      "const": "PK_RECONCILIATION_RECORD/1"
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "partition_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "partitioned_since": {
      "type": "integer",
      "minimum": 0
    },
    "reconnected_at": {
      "type": "integer",
      "minimum": 0
    },
    "lease_granted_at": {
      "type": "integer",
      "minimum": 0
    },
    "lease_expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "decision_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_policy_age": {
      "type": "integer",
      "minimum": 0
    },
    "renewed_until": {
      "type": "integer",
      "minimum": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "partition_epoch",
          "kind",
          "subject",
          "at",
          "tier",
          "policy_age",
          "lease_granted_at",
          "lease_expires_at",
          "reason"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "partition_epoch": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "at": {
            "type": "integer",
            "minimum": 0
          },
          "tier": {
            "enum": [
              "full",
              "sustain",
              "freeze"
            ]
          },
          "policy_age": {
            "type": "integer",
            "minimum": 0
          },
          "lease_granted_at": {
            "type": "integer",
            "minimum": 0
          },
          "lease_expires_at": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  }
}
