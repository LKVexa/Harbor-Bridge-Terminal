{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_POLICY_BUNDLE/1",
  "title": "Signed policy bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "issuer",
    "trust_domain",
    "policy_version",
    "activated_at",
    "author",
    "approver",
    "rules",
    "key_id",
    "alg",
    "sig"
  ],
  "properties": {
    "version": {
      "const": "PK_POLICY_BUNDLE/1"
    },
    "issuer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "trust_domain": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 0
    },
    "activated_at": {
      "type": "integer",
      "minimum": 0
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rules": {
      "type": "object"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "alg": {
      "const": "Ed25519"
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
