{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_GAP04_LOG/1",
  "title": "Structured log record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ts",
    "level",
    "event",
    "site",
    "node",
    "op",
    "workload",
    "trace_id",
    "span_id",
    "fields"
  ],
  "properties": {
    "schema": {
      "const": "PK_GAP04_LOG/1"
    },
    "ts": {
      "type": "number"
    },
    "level": {
      "enum": [
        "debug",
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "event": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "node": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "op": {
      "type": [
        "string",
        "null"
      ]
    },
    "workload": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fields": {
      "type": "object"
    }
  }
}
