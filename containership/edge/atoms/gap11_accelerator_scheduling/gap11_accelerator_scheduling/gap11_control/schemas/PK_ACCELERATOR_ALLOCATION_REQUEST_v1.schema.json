{
 "$id": "PK_ACCELERATOR_ALLOCATION_REQUEST/1",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "deadline_ms": {
   "maximum": 600000,
   "minimum": 1,
   "type": "integer"
  },
  "features": {
   "items": {
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._:\\-]+$",
    "type": "string"
   },
   "maxItems": 64,
   "type": "array",
   "uniqueItems": true
  },
  "generation": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "type": "string"
  },
  "kind": {
   "enum": [
    "gpu",
    "npu",
    "fpga",
    "generic"
   ]
  },
  "memory_gb": {
   "maximum": 4096,
   "minimum": 0,
   "type": "integer"
  },
  "partition": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "type": "string"
  },
  "priority": {
   "enum": [
    "low",
    "normal",
    "high"
   ]
  },
  "request_id": {
   "maxLength": 128,
   "minLength": 8,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "type": "string"
  },
  "schema": {
   "const": "PK_ACCELERATOR_ALLOCATION_REQUEST/1"
  },
  "tenant": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "type": "string"
  },
  "traceparent": {
   "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$",
   "type": "string"
  },
  "workload": {
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "type": "string"
  }
 },
 "required": [
  "schema",
  "request_id",
  "tenant",
  "workload"
 ],
 "type": "object"
}
