 "additionalProperties": false,
 "properties": {
  "lease_id": {
   "pattern": "^[0-9a-f]{32}$",
   "type": "string"
  },
  "request_id": {
   "maxLength": 128,
   "minLength": 8,
   "pattern": "^[A-Za-z0-9._:\\-]+$",
   "type": "string"
  },
  "schema": {
   "const": "PK_ACCELERATOR_RELEASE_REQUEST/1"
  },
  "traceparent": {
   "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$",
   "type": "string"
  }
 },
 "required": [
  "schema",
  "request_id",
  "lease_id"
 ],
 "type": "object"
}
