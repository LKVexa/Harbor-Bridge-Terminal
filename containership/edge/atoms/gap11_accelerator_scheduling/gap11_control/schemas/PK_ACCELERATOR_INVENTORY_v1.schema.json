{
 "$id": "PK_ACCELERATOR_INVENTORY/1",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": true,
 "properties": {
  "devices": {
   "items": {
    "properties": {
     "device": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:\\-]+$",
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "memory_gb": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "device",
     "kind",
     "memory_gb"
    ],
    "type": "object"
   },
   "maxItems": 4096,
   "type": "array"
  },
  "schema": {
   "const": "PK_ACCELERATOR_INVENTORY/1"
  }
 },
 "required": [
  "schema",
  "devices"
 ],
 "type": "object"
}
