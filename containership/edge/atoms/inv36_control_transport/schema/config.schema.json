{
  "$id": "inv36.config/1",
  "additionalProperties": false,
  "properties": {
    "accept_rate_per_s": {
      "description": "accept admission rate [1/s] hot_reload=True",
      "maximum": 10000.0,
      "minimum": 0.1,
      "type": "number"
    },
    "auth_failure_limit": {
      "description": "auth failures before a peer is isolated [count] hot_reload=True",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "breaker_failure_threshold": {
      "description": "circuit breaker failures to open [count] hot_reload=True",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "breaker_reset_ms": {
      "description": "circuit breaker open duration [ms] hot_reload=True",
      "maximum": 3600000,
      "minimum": 100,
      "type": "integer"
    },
    "connect_timeout_ms": {
      "description": "connect deadline [ms] hot_reload=True",
      "maximum": 60000,
      "minimum": 10,
      "type": "integer"
    },
    "dev_allow_insecure_test_keys": {
      "description": "DEV ONLY - refused in prod/stage [bool] hot_reload=False",
      "type": "boolean"
    },
    "environment": {
      "description": "dev|test|stage|prod key namespace [enum] hot_reload=False",
      "enum": [
        "dev",
        "test",
        "stage",
        "prod"
      ],
      "type": "string"
    },
    "feature_flags": {
      "description": "boolean feature flags [map] hot_reload=True",
      "type": "object"
    },
    "handshake_timeout_ms": {
      "description": "handshake deadline [ms] hot_reload=True",
      "maximum": 60000,
      "minimum": 50,
      "type": "integer"
    },
    "heartbeat_interval_ms": {
      "description": "heartbeat interval [ms] hot_reload=True",
      "maximum": 600000,
      "minimum": 100,
      "type": "integer"
    },
    "identity_key_ref": {
      "description": "identity signing key handle [secretref] hot_reload=False",
      "pattern": "secretref://(?P<ns>dev|test|stage|prod)/(?P<name>[a-z0-9][a-z0-9._/-]{0,127})$",
      "type": "string"
    },
    "listen_port": {
      "description": "vsock listen port [port] hot_reload=False",
      "maximum": 65535,
      "minimum": 1024,
      "type": "integer"
    },
    "log_level": {
      "description": "debug|info|warning|error [enum] hot_reload=True",
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ],
      "type": "string"
    },
    "max_frame_bytes": {
      "description": "plaintext ceiling <= protocol maximum [bytes] hot_reload=False",
      "maximum": 65536,
      "minimum": 1,
      "type": "integer"
    },
    "max_sessions": {
      "description": "concurrent session limit per process [count] hot_reload=True",
      "maximum": 65536,
      "minimum": 1,
      "type": "integer"
    },
    "max_sessions_per_tenant": {
      "description": "per-tenant session limit [count] hot_reload=True",
      "maximum": 65536,
      "minimum": 1,
      "type": "integer"
    },
    "node": {
      "description": "node identifier [id] hot_reload=False",
      "type": "string"
    },
    "peer_cid": {
      "description": "peer context id (host=2) [cid] hot_reload=False",
      "maximum": 4294967294,
      "minimum": 2,
      "type": "integer"
    },
    "policy_ref": {
      "description": "authorization policy source [uri] hot_reload=True",
      "type": "string"
    },
    "read_timeout_ms": {
      "description": "per-record read deadline [ms] hot_reload=True",
      "maximum": 600000,
      "minimum": 10,
      "type": "integer"
    },
    "retry_base_ms": {
      "description": "backoff base [ms] hot_reload=True",
      "maximum": 60000,
      "minimum": 1,
      "type": "integer"
    },
    "retry_cap_ms": {
      "description": "backoff cap [ms] hot_reload=True",
      "maximum": 600000,
      "minimum": 1,
      "type": "integer"
    },
    "retry_max_attempts": {
      "description": "retry attempts [count] hot_reload=True",
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
    },
    "send_queue_high_water": {
      "description": "send queue high-water mark [frames] hot_reload=True",
      "maximum": 1048576,
      "minimum": 2,
      "type": "integer"
    },
    "send_queue_low_water": {
      "description": "send queue low-water mark [frames] hot_reload=True",
      "maximum": 1048576,
      "minimum": 1,
      "type": "integer"
    },
    "session_max_age_s": {
      "description": "rekey (re-handshake) after this age [s] hot_reload=True",
      "maximum": 604800,
      "minimum": 60,
      "type": "integer"
    },
    "session_max_frames": {
      "description": "rekey after this many frames [frames] hot_reload=True",
      "maximum": 4611686018427387904,
      "minimum": 1000,
      "type": "integer"
    },
    "site": {
      "description": "site identifier [id] hot_reload=False",
      "type": "string"
    },
    "stall_threshold_ms": {
      "description": "no-progress stall threshold [ms] hot_reload=True",
      "maximum": 3600000,
      "minimum": 200,
      "type": "integer"
    },
    "telemetry_buffer": {
      "description": "bounded exporter buffer [events] hot_reload=True",
      "maximum": 1048576,
      "minimum": 16,
      "type": "integer"
    },
    "telemetry_endpoint": {
      "description": "telemetry export endpoint (https://) [uri] hot_reload=True",
      "type": "string"
    },
    "write_timeout_ms": {
      "description": "per-record write deadline [ms] hot_reload=True",
      "maximum": 600000,
      "minimum": 10,
      "type": "integer"
    }
  },
  "required": [
    "accept_rate_per_s",
    "auth_failure_limit",
    "breaker_failure_threshold",
    "breaker_reset_ms",
    "connect_timeout_ms",
    "dev_allow_insecure_test_keys",
    "environment",
    "feature_flags",
    "handshake_timeout_ms",
    "heartbeat_interval_ms",
    "identity_key_ref",
    "listen_port",
    "log_level",
    "max_frame_bytes",
    "max_sessions",
    "max_sessions_per_tenant",
    "node",
    "peer_cid",
    "policy_ref",
    "read_timeout_ms",
    "retry_base_ms",
    "retry_cap_ms",
    "retry_max_attempts",
    "send_queue_high_water",
    "send_queue_low_water",
    "session_max_age_s",
    "session_max_frames",
    "site",
    "stall_threshold_ms",
    "telemetry_buffer",
    "telemetry_endpoint",
    "write_timeout_ms"
