{
  "$id": "inv36.error/1",
  "title": "INV-36 structured error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code", "number", "disposition", "retryable", "terminal", "message", "detail"],
  "properties": {
    "schema": {"const": "inv36.error/1"},
    "code": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64},
    "number": {"type": "integer", "minimum": 0, "maximum": 65535},
    "disposition": {"enum": ["success", "degraded", "retryable", "denied", "protocol_error", "integrity_failure", "terminal"]},
    "retryable": {"type": "boolean"},
    "terminal": {"type": "boolean"},
    "message": {"type": "string", "maxLength": 256},
    "detail": {"type": "object"},
    "retry_after_s": {"type": "number", "minimum": 0}
  }
}
