include VERSION README.md CHANGELOG.md SECURITY.md COMPATIBILITY.md CHECKLIST.json AUDIT_MATRIX.json AUDIT_REPORT.md MC_CHECKLIST_STATUS.json THIRD-PARTY-NOTICES.md
recursive-include schema *.json
recursive-include docs *.md *.json
recursive-include tests *.py
recursive-include fixtures *.json *.hex
recursive-include perf *.json
recursive-include release *.json
recursive-include .github *.yml
prune dist
prune evidence
global-exclude *.pyc *.pem *.key
