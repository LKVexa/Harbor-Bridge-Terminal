{
  "$id": "PK_BYPASS_ERROR/1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "detail": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "RETRYABLE_FAILURE",
        "TERMINAL_FAILURE",
        "REJECTED_POLICY",
        "DEGRADED"
      ]
    },
    "reason_code": {
      "pattern": "^PK_BYPASS_[A-Z_]+$",
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "schema": {
      "const": "PK_BYPASS_ERROR/1"
    }
  },
  "required": [
    "schema",
    "outcome",
    "reason_code",
    "retryable"
  ],
  "title": "Structured error",
  "type": "object"
}