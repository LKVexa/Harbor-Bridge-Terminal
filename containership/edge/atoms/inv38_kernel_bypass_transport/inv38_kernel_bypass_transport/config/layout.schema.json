{
  "$id": "config-layout/1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Declares which paths are immutable artifacts vs mutable config vs runtime state.",
  "properties": {
    "config": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "immutable": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "state": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "immutable",
    "config",
    "state"
  ],
  "type": "object"
}