{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "PK release manifest v1",
 "type": "object",
 "required": [
  "element",
  "version",
  "files",
  "sbom_sha256",
  "provenance_sha256",
  "evidence_head",
  "gate_verdict"
 ],
 "properties": {
  "element": {
   "const": "INV-65"
  },
  "version": {
   "type": "string"
  },
  "files": {
   "type": "object"
  },
  "sbom_sha256": {
   "type": "string"
  },
  "provenance_sha256": {
   "type": "string"
  },
  "evidence_head": {
   "type": "string"
  },
  "gate_verdict": {
   "enum": [
    "GO",
    "CONDITIONAL_GO",
    "NO_GO"
   ]
  },
  "signed": {
   "type": "boolean"
  }
 }
}
