{
  "$id": "urn:pk:inv65:call_metadata:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "maximum": 16,
      "minimum": 1,
      "type": "integer"
    },
    "correlation_id": {
      "pattern": "^[0-9a-f]{16,64}$",
      "type": "string"
    },
    "deadline_ms": {
      "maximum": 600000,
      "minimum": 1,
      "type": "integer"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "type": "string"
    },
    "trace_parent": {
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-0[01]$",
      "type": "string"
    }
  },
  "required": [
    "correlation_id",
    "deadline_ms"
  ],
  "title": "PK call metadata v1",
  "type": "object",
  "x-compat": "additive-only within v1; breaking changes require v2",
  "x-version": "1.0"
}
