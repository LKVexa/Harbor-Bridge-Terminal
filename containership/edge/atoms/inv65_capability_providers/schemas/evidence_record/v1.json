{
  "$id": "urn:pk:inv65:evidence_record:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "type": "string"
    },
    "artifact_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "check": {
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "element": {
      "const": "INV-65"
    },
    "note": {
      "type": "string"
    },
    "prev": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "PK_EVIDENCE/1"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "not_run"
      ]
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "element",
    "version",
    "check",
    "status",
    "artifact",
    "artifact_digest",
    "prev",
    "digest"
  ],
  "title": "PK evidence record v1",
  "type": "object",
  "x-compat": "additive-only within v1; breaking changes require v2",
  "x-version": "1.0"
}
