{
  "$defs": {
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f\\s]([^\\x00-\\x1f\\x7f]*[^\\x00-\\x1f\\x7f\\s])?$",
      "type": "string"
    }
  },
  "$id": "urn:pk:inv65:pk_provider_contract:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_class": {
      "enum": [
        "keyvalue",
        "http",
        "messaging",
        "blobstore",
        "other"
      ]
    },
    "contract_id": {
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*(@[0-9]+\\.[0-9]+)?$",
      "type": "string"
    },
    "implementation": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "schema": {
      "const": "PK_PROVIDER_CONTRACT/1"
    },
    "versions": {
      "items": {
        "pattern": "^[0-9]+\\.[0-9]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "contract_id",
    "versions",
    "capability_class",
    "implementation"
  ],
  "title": "PK_PROVIDER_CONTRACT/1",
  "type": "object",
  "x-compat": "additive-only within v1; breaking changes require v2",
  "x-version": "1.0"
}
