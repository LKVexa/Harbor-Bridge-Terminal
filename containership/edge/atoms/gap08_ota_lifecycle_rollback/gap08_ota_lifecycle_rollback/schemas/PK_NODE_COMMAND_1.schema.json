{
  "$id": "PK_NODE_COMMAND_1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "pattern": "^cmd_[0-9a-f]{32}$",
      "type": "string"
    },
    "deadline": {
      "type": "number"
    },
    "digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "fence": {
      "minimum": 1,
      "type": "integer"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "issued_at": {
      "type": "number"
    },
    "node": {
      "minLength": 1,
      "type": "string"
    },
    "nonce": {
      "minLength": 1,
      "type": "string"
    },
    "op": {
      "enum": [
        "drain",
        "stage",
        "install",
        "activate",
        "rollback",
        "quarantine",
        "query"
      ]
    },
    "rollout_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "PK_NODE_COMMAND/1"
    },
    "target_version": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "command_id",
    "idempotency_key",
    "rollout_id",
    "node",
    "op",
    "fence",
    "target_version",
    "digest",
    "nonce",
    "issued_at",
    "deadline"
  ],
  "title": "PK_NODE_COMMAND/1",
  "type": "object"
}
