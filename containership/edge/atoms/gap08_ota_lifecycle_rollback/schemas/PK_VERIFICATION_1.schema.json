{
  "$id": "PK_VERIFICATION_1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "enum": [
        "ed25519",
        "ecdsa-p256-sha256",
        "rsa-pss-sha256",
        "hmac-sha256-test"
      ]
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "expires_at": {
      "type": "number"
    },
    "kind": {
      "const": "bundle"
    },
    "provenance_ref": {
      "type": "string"
    },
    "schema": {
      "const": "PK_VERIFICATION/1"
    },
    "size": {
      "minimum": 0,
      "type": "integer"
    },
    "subject": {
      "minLength": 1,
      "type": "string"
    },
    "verified": {
      "const": true
    },
    "verified_at": {
      "type": "number"
    },
    "verifier": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "kind",
    "verified",
    "subject",
    "digest",
    "algorithm",
    "verifier",
    "verified_at",
    "expires_at"
  ],
  "title": "PK_VERIFICATION/1",
  "type": "object"
}
