{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:pln04:PK_TIER_CATALOGUE:1",
  "title": "PK_TIER_CATALOGUE/1",
  "description": "Versioned attested-tier catalogue snapshot for PLN-04.",
  "type": "object",
  "required": ["schema", "node_id", "generation", "tiers"],
  "properties": {
    "schema": {"const": "PK_TIER_CATALOGUE/1"},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "generation": {"type": "integer", "minimum": 0},
    "tiers": {
      "type": "object",
      "propertyNames": {"enum": ["process", "wasm", "unikernel", "microvm", "vm"]},
      "additionalProperties": {"type": "boolean"}
    },
    "attestation_epoch": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
