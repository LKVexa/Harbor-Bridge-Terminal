{
  "$id": "urn:inv11:schema:PK_INTERFACE_DIFF/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "class": {
            "enum": [
              "additive",
              "compatible",
              "breaking"
            ]
          },
          "code": {
            "enum": [
              "alias-retargeted",
              "alias-retargeted-equal",
              "enum-case-added",
              "enum-cases-changed",
              "flags-added",
              "flags-changed",
              "func-added",
              "func-async-changed",
              "func-kind-changed",
              "func-removed",
              "gate-changed",
              "interface-added",
              "interface-removed",
              "named-type-swapped",
              "param-count-changed",
              "param-renamed",
              "param-type-changed",
              "record-field-type-changed",
              "record-fields-changed",
              "resource-method-added",
              "resource-method-changed",
              "resource-method-removed",
              "result-changed",
              "type-added",
              "type-kind-changed",
              "type-removed",
              "variant-case-added",
              "variant-cases-changed",
              "variant-payload-changed",
              "version-only",
              "world-added",
              "world-export-added",
              "world-export-changed",
              "world-export-removed",
              "world-import-added",
              "world-import-changed",
              "world-import-removed",
              "world-removed"
            ]
          },
          "detail": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "class",
          "detail"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "class": {
      "enum": [
        "additive",
        "compatible",
        "breaking"
      ]
    },
    "fingerprints": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "to": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "from": {
      "type": [
        "string",
        "null"
      ]
    },
    "linkable": {
      "type": "boolean"
    },
    "policy": {
      "const": "INV11-COMPAT-POLICY/1"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "const": "PK_INTERFACE_DIFF/1"
    },
    "subject": {
      "type": "string"
    },
    "to": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "policy",
    "subject",
    "from",
    "to",
    "class",
    "linkable",
    "changes",
    "reasons",
    "fingerprints"
  ],
  "type": "object"
}
