package ex:clocks@0.2.0;
interface monotonic {
  type instant = u64;
  type duration = u64;
  now: func() -> instant;
  resolution: func() -> duration;
}
interface wall {
  record datetime { seconds: u64, nanoseconds: u32 }
  now: func() -> datetime;
}
world imports { import monotonic; import wall; }
