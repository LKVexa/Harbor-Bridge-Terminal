{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:orch:reconcile:1",
  "title": "PK_ORCH_RECONCILE/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes",
    "pods",
    "desired"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workload",
          "node"
        ],
        "properties": {
          "workload": {
            "type": "string",
            "minLength": 1
          },
          "node": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "desired": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "min_available": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "default": {}
    }
  },
  "x-revision": "1.0"
}
