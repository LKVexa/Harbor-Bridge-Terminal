[Unit]
Description=GAP-01 state backup (38)
After=gap01-supervisor.service

[Service]
Type=oneshot
User=gap01
Group=gap01
ExecStart=/usr/bin/python3 -m gap01_edge_node_supervisor.tools.backup /var/lib/gap01 /var/backups/gap01 --keep 14
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/gap01
ReadOnlyPaths=/var/lib/gap01
