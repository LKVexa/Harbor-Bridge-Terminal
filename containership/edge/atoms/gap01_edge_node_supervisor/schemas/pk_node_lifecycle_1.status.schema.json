{
  "$id": "urn:pk:PK_NODE_LIFECYCLE:1:status",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "generation": {
      "minimum": 0,
      "type": "integer"
    },
    "last_reason": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "partition": {
      "enum": [
        "connected",
        "suspect",
        "partitioned",
        "autonomy-expired"
      ]
    },
    "schema": {
      "const": "PK_NODE_LIFECYCLE/1"
    },
    "state": {
      "enum": [
        "joining",
        "ready",
        "cordoned",
        "draining",
        "stopped"
      ]
    },
    "workloads": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "node",
    "state",
    "workloads",
    "generation"
  ],
  "type": "object"
}
