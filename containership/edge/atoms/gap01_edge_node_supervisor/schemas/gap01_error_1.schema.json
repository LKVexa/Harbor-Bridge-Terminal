{
  "$id": "urn:pk:GAP01:error:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cause": {
      "type": "string"
    },
    "code": {
      "pattern": "^E_[A-Z_]+$",
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "fault_domain": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "retryable",
    "fault_domain",
    "message"
  ],
  "type": "object"
}
