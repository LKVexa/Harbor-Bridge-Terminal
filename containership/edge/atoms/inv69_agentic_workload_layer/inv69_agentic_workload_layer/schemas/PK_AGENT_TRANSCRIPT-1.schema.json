{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:agent:transcript:1",
  "title": "PK_AGENT_TRANSCRIPT/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "agent",
    "head",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "PK_AGENT_TRANSCRIPT/1"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "PK_AGENT_STEP-1.schema.json"
          },
          {
            "$ref": "PK_AGENT_APPROVAL-1.schema.json"
          }
        ]
      }
    }
  }
}
