{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:agent:error:1",
  "title": "PK_AGENT_ERROR/1",
  "type": "object",
  "required": [
    "schema",
    "registry",
    "code",
    "category",
    "severity",
    "retryable",
    "rpc_status",
    "http_status",
    "message",
    "details",
    "correlation_id"
  ],
  "properties": {
    "schema": {
      "const": "PK_AGENT_ERROR/1"
    },
    "code": {
      "enum": [
        "AGT-VAL-001",
        "AGT-VAL-002",
        "AGT-AUTHZ-001",
        "AGT-AUTHZ-002",
        "AGT-APR-001",
        "AGT-APR-002",
        "AGT-POL-001",
        "AGT-POL-002",
        "AGT-LCY-001",
        "AGT-LCY-002",
        "AGT-DEP-001",
        "AGT-DEP-002",
        "AGT-SBX-001",
        "AGT-SBX-002",
        "AGT-TMO-001",
        "AGT-CAN-001",
        "AGT-CAP-001",
        "AGT-CAP-002",
        "AGT-CAP-003",
        "AGT-CAP-004",
        "AGT-INT-001",
        "AGT-INT-002",
        "AGT-INT-003",
        "AGT-CFG-001",
        "AGT-CFG-002",
        "AGT-CFG-003",
        "AGT-CMP-001",
        "AGT-TRU-001",
        "AGT-INTERNAL-001"
      ]
    },
    "category": {
      "enum": [
        "validation",
        "authorization",
        "approval",
        "policy",
        "lifecycle",
        "dependency",
        "sandbox",
        "timeout",
        "cancellation",
        "capacity",
        "integrity",
        "configuration",
        "compatibility",
        "trust",
        "internal"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "http_status": {
      "type": "integer"
    },
    "details": {
      "type": "object"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^corr-[0-9a-f]{16}$"
    },
    "cause": {
      "$ref": "#"
    },
    "registry": {
      "const": "PK_AGENT_ERRORS/1.0.0"
    },
    "rpc_status": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "maxLength": 1024
    }
  },
  "additionalProperties": false
}