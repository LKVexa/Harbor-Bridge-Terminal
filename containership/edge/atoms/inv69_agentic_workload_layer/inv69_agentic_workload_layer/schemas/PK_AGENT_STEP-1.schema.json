{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:agent:step:1",
  "title": "PK_AGENT_STEP/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "agent",
    "step",
    "tool",
    "outcome",
    "reason",
    "arg_ref",
    "arg_shape"
  ],
  "properties": {
    "schema": {
      "const": "PK_AGENT_STEP/1"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "ran",
        "pending",
        "refused"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "arg_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "arg_shape": {},
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "type": "integer",
      "minimum": 1
    },
    "cost_used": {
      "type": "integer",
      "minimum": 0
    },
    "sandbox": {
      "enum": [
        "fast",
        "heavy"
      ]
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
