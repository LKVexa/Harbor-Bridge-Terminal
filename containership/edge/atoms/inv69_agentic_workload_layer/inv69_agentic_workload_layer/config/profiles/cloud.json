{
  "schema": "PK_AGENT_PROFILE/1",
  "context": "cloud",
  "applicability": "required",
  "rationale": "Primary target: managed regions with reliable control plane, durable remote audit and both sandbox tiers.",
  "mandatory_capabilities": [
    "allowlist",
    "step_budget",
    "cost_budget",
    "transcript",
    "approval_gate",
    "heavy_sandbox",
