      "max_queue": 0
    }
  },
  "environment": {
    "network": "reliable, low-latency to INV-59/INV-57",
    "control_plane": "always available (SLO-backed)",
    "storage": "durable remote",
    "clock": "NTP/PTP, skew <= 5s",
    "hardware": "unconstrained",
    "operator_access": "24x7 remote"
  },
  "resource_envelope": {
    "max_active_runs": 64,
    "memory_mb_per_1k_runs": "see evidence/PERF_RESULTS.json"
  },
  "security_posture": "fail-closed on every trust dependency; no offline approvals"
