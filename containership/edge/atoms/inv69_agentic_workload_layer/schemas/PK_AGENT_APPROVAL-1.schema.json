{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:agent:approval:1",
  "title": "PK_AGENT_APPROVAL/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "agent",
    "step",
    "tool",
    "outcome",
    "reason",
    "arg_ref",
    "arg_shape",
    "by"
  ],
  "properties": {
    "schema": {
      "const": "PK_AGENT_APPROVAL/1"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "const": "approved"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "arg_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "arg_shape": {},
    "by": {
      "type": "string",
      "minLength": 1
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
