{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:agent:run_event:1",
  "title": "PK_AGENT_RUN_EVENT/1",
  "type": "object",
  "required": [
    "schema",
    "seq",
    "kind",
    "at",
    "executor",
    "correlation_id",
    "trace_id",
    "config_digest",
    "config_generation",
    "profile",
    "precedence_policy",
    "lineage",
    "prev_hash",
    "event_hash"
  ],
  "properties": {
    "schema": {
      "const": "PK_AGENT_RUN_EVENT/1"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "run_started",
        "run_ended",
        "invocation",
        "invocation_failed",
        "approval_recorded",
        "approval_refused",
        "failover_adopted",
        "failover_planned",
        "containment"
      ]
    },
    "at": {
      "type": "number"
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{32}$"
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_generation": {
      "type": "integer",
      "minimum": 0
    },
    "profile": {
      "enum": [
        "cloud",
        "datacenter",
        "near_edge",
        "far_edge"
      ]
    },
    "precedence_policy": {
      "type": "string"
    },
    "lineage": {
      "type": "object",
      "required": [
        "release_id",
        "node",
        "site",
        "topology_snapshot"
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "AGT-VAL-001",
        "AGT-VAL-002",
        "AGT-AUTHZ-001",
        "AGT-AUTHZ-002",
        "AGT-APR-001",
        "AGT-APR-002",
        "AGT-POL-001",
        "AGT-POL-002",
        "AGT-LCY-001",
        "AGT-LCY-002",
        "AGT-DEP-001",
        "AGT-DEP-002",
        "AGT-SBX-001",
        "AGT-SBX-002",
        "AGT-TMO-001",
        "AGT-CAN-001",
        "AGT-CAP-001",
        "AGT-CAP-002",
        "AGT-CAP-003",
        "AGT-CAP-004",
        "AGT-INT-001",
        "AGT-INT-002",
        "AGT-INT-003",
        "AGT-CFG-001",
        "AGT-CFG-002",
        "AGT-CFG-003",
        "AGT-CMP-001",
        "AGT-TRU-001",
        "AGT-INTERNAL-001"
      ]
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}