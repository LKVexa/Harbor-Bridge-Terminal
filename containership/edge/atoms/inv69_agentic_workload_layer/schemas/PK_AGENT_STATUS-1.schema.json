{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:agent:status:1",
  "title": "PK_AGENT_STATUS/1",
  "type": "object",
  "required": [
    "schema",
    "live",
    "ready",
    "version",
    "reasons"
  ],
  "properties": {
    "schema": {
      "const": "PK_AGENT_STATUS/1"
    },
    "live": {
      "type": "boolean"
    },
    "ready": {
      "type": "object",
      "required": [
        "new_runs",
        "readonly_tools",
        "side_effect_tools",
        "approvals"
      ],
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "version": {
      "type": "string"
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^HLT-"
      }
    },
    "config": {
      "type": "object",
      "required": [
        "digest",
        "layers"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}