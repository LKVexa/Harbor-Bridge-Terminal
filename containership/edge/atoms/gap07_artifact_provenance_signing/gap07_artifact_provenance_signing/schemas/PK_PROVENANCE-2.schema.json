{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_PROVENANCE:2",
  "title": "PK_PROVENANCE/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "links", "head"],
  "properties": {
    "schema": {"const": "PK_PROVENANCE/2"},
    "head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "links": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "index", "step", "artifact_digest", "previous", "link_digest"],
        "properties": {
          "schema": {"const": "PK_PROVENANCE_LINK/2"},
          "index": {"type": "integer", "minimum": 0},
          "step": {"type": "string", "minLength": 1, "maxLength": 256},
          "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "previous": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
          "link_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
