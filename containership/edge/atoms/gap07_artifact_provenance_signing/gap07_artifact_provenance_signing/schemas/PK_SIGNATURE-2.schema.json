{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_SIGNATURE:2",
  "title": "PK_SIGNATURE/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "algorithm", "environment", "kind", "signer", "key_id", "digest", "issued_at", "mac"],
  "properties": {
    "schema": {"const": "PK_SIGNATURE/2"},
    "algorithm": {"const": "HMAC-SHA256-REF-v2"},
    "environment": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"enum": ["code", "policy", "grant", "label", "attestation", "bundle"]},
    "signer": {"type": "string", "minLength": 1, "maxLength": 128},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"type": "integer", "minimum": 0},
    "mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
