{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_AUDIT_EVENT:1",
  "title": "PK_AUDIT_EVENT/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "event", "time", "details", "previous", "hash"],
  "properties": {
    "schema": {"const": "PK_AUDIT_EVENT/1"},
    "sequence": {"type": "integer", "minimum": 0},
    "event": {"type": "string", "minLength": 1, "maxLength": 128},
    "time": {"type": "integer", "minimum": 0},
    "details": {"type": "object"},
    "previous": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
