{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_CERT:1",
  "title": "PK_CERT/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "issuer",
    "kid",
    "name_constraints",
    "namespace",
    "not_after",
    "not_before",
    "path_len",
    "schema",
    "serial",
    "sig",
    "sig_alg",
    "spki",
    "subject",
    "usages"
  ],
  "properties": {
    "schema": {
      "const": "PK_CERT/1"
    },
    "serial": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "site",
        "environment"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "alg": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "spki": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "usages": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "path_len": {
      "type": "integer",
      "minimum": 0
    },
    "name_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_before": {
      "type": "integer",
      "minimum": 0
    },
    "not_after": {
      "type": "integer",
      "minimum": 0
    },
    "sig_alg": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
