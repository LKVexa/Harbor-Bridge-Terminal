{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_VERIFICATION:2",
  "title": "PK_VERIFICATION/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "signature_schema", "algorithm", "environment", "kind", "signer", "role", "key_id", "digest", "issued_at", "verified"],
  "properties": {
    "schema": {"const": "PK_VERIFICATION/2"},
    "signature_schema": {"const": "PK_SIGNATURE/2"},
    "algorithm": {"const": "HMAC-SHA256-REF-v2"},
    "environment": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "signer": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"type": "integer", "minimum": 0},
    "verified": {"const": true}
  }
}
