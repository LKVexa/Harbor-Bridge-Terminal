{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_TRUST_STORE:2",
  "title": "PK_TRUST_STORE/2 snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "environment", "updated_at", "signers", "revoked"],
  "properties": {
    "schema": {"const": "PK_TRUST_STORE/2"},
    "environment": {"type": "string", "minLength": 1, "maxLength": 128},
    "updated_at": {"type": "integer", "minimum": 0},
    "signers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "active_key_id", "verify_key_ids"],
        "properties": {
          "role": {"enum": ["release", "policy", "authority", "data"]},
          "active_key_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "verify_key_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
        }
      }
    },
    "revoked": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
