{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_TIME_ATTESTATION:1",
  "title": "PK_TIME_ATTESTATION/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "authority",
    "device",
    "expires",
    "schema",
    "sequence",
    "sig",
    "site",
    "time",
    "uncertainty_ms"
  ],
  "properties": {
    "schema": {
      "const": "PK_TIME_ATTESTATION/1"
    },
    "authority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "alg": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "device": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "uncertainty_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires": {
      "type": "integer",
      "minimum": 0
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
