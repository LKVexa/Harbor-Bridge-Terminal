{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_CHECKPOINT:1",
  "title": "PK_CHECKPOINT/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "log_key_id",
    "origin",
    "root",
    "schema",
    "sig",
    "size",
    "timestamp"
  ],
  "properties": {
    "schema": {
      "const": "PK_CHECKPOINT/1"
    },
    "origin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "log_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "alg": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "root": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
