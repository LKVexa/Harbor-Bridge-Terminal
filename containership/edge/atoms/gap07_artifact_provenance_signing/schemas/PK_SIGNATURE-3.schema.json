{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_SIGNATURE:3",
  "title": "PK_SIGNATURE/3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "digest",
    "digest_alg",
    "env",
    "issued_at",
    "kid",
    "kind",
    "nonce",
    "policy_domain",
    "purpose",
    "refs",
    "sig",
    "signer",
    "site",
    "tenant",
    "v"
  ],
  "properties": {
    "v": {
      "const": 3
    },
    "alg": {
      "enum": [
        "ecdsa-p256-sha256",
        "ecdsa-p384-sha384",
        "ed25519",
        "rsa-pss-sha256-3072",
        "rsa-pss-sha384-4096"
      ]
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "signer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "env": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "enum": [
        "attestation",
        "bundle",
        "code",
        "grant",
        "label",
        "microvm-image",
        "oci-image",
        "oci-index",
        "policy",
        "provider-bundle",
        "sbom",
        "trust-config",
        "wasm-component",
        "wasm-module"
      ]
    },
    "purpose": {
      "type": "string",
      "pattern": "^sign:[a-z-]+$"
    },
    "policy_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "digest_alg": {
      "enum": [
        "sha256",
        "sha512"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|[0-9a-f]{128})$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "nonce": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 16,
      "maxLength": 128
    },
    "refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
