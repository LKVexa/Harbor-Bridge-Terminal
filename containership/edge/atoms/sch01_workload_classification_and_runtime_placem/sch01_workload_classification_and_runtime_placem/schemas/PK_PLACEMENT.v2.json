{
  "$id": "urn:pk:sch01:PK_PLACEMENT/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates_considered": {
      "minimum": 0,
      "type": "integer"
    },
    "candidates_total": {
      "minimum": 0,
      "type": "integer"
    },
    "decision": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "array"
        },
        "strategy": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "score",
        "strategy"
      ],
      "type": "object"
    },
    "degraded": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "devices": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "explain": {
      "type": "object"
    },
    "jurisdiction": {
      "minLength": 1,
      "type": "string"
    },
    "latency_class": {
      "enum": [
        "interactive",
        "batch"
      ]
    },
    "lease_expires": {
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "pattern": "^[0-9a-f]{24}$",
      "type": "string"
    },
    "lease_issued_at": {
      "minimum": 0,
      "type": "integer"
    },
    "node": {
      "minLength": 1,
      "type": "string"
    },
    "result_class": {
      "enum": [
        "SUCCESS",
        "DEGRADED_SUCCESS"
      ]
    },
    "runtime": {
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "PK_PLACEMENT/2"
    },
    "site": {
      "minLength": 1,
      "type": "string"
    },
    "tenant": {
      "minLength": 1,
      "type": "string"
    },
    "tier": {
      "enum": [
        "process",
        "wasm",
        "unikernel",
        "microvm",
        "vm"
      ]
    },
    "trust_class": {
      "enum": [
        "trusted",
        "first-party",
        "third-party",
        "untrusted",
        "hostile"
      ]
    },
    "workload": {
      "minLength": 1,
      "type": "string"
    },
    "zone": {
      "minLength": 1,
      "type": "string"
    }
