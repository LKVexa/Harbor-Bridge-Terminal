{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_CPU_EXPANSION_REQUEST/1",
  "title": "INV-34 CPU expansion request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "vm_id", "target_vcpus"],
  "properties": {
    "schema": {"const": "PK_CPU_EXPANSION_REQUEST/1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"},
    "vm_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s\\x00-\\x1F\\x7F]+$"},
    "target_vcpus": {"type": "integer", "minimum": 1, "maximum": 65536},
    "expected_generation": {"type": "integer", "minimum": 0}
  }
}
