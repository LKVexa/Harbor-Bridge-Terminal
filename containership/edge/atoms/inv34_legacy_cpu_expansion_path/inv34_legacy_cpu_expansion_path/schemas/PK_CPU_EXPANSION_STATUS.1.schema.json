{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_CPU_EXPANSION_STATUS/1",
  "title": "INV-34 CPU expansion status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "vm_id", "observed_vcpus", "desired_vcpus", "pending_vcpus", "max_vcpus", "host_capacity_vcpus", "acpi_hotplug_supported", "guest_hotplug_supported", "expansion_enabled", "generation", "converged"],
  "properties": {
    "schema": {"const": "PK_CPU_EXPANSION_STATUS/1"},
    "vm_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "observed_vcpus": {"type": "integer", "minimum": 1, "maximum": 65536},
    "desired_vcpus": {"type": "integer", "minimum": 1, "maximum": 65536},
    "pending_vcpus": {"type": "integer", "minimum": 0, "maximum": 65536},
    "max_vcpus": {"type": "integer", "minimum": 1, "maximum": 65536},
    "host_capacity_vcpus": {"type": "integer", "minimum": 1, "maximum": 65536},
    "acpi_hotplug_supported": {"type": "boolean"},
    "guest_hotplug_supported": {"type": "boolean"},
    "expansion_enabled": {"type": "boolean"},
    "generation": {"type": "integer", "minimum": 0},
    "converged": {"type": "boolean"}
  }
}
