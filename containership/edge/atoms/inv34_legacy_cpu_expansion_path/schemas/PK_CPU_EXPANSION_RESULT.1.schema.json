{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_CPU_EXPANSION_RESULT/1",
  "title": "INV-34 CPU expansion result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "vm_id", "previous_desired_vcpus", "target_vcpus", "added_vcpus", "generation", "status"],
  "properties": {
    "schema": {"const": "PK_CPU_EXPANSION_RESULT/1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "vm_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "previous_desired_vcpus": {"type": "integer", "minimum": 1, "maximum": 65536},
    "target_vcpus": {"type": "integer", "minimum": 1, "maximum": 65536},
    "added_vcpus": {"type": "integer", "minimum": 0, "maximum": 65536},
    "generation": {"type": "integer", "minimum": 0},
    "status": {"enum": ["accepted", "noop"]}
  }
}
