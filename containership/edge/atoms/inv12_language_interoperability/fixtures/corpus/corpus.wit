package inv12:corpus@1.0.0;

// Golden-corpus interface.  Every canonical type kind appears at least once.
interface corpus {
  resource file;
  record point { x: s32, y: s32 }
  variant shape { circle(f32), rect(tuple<point, point>), empty }
  enum color { red, green, blue }
  flags perms { read, write, exec }
  flags empty-flags { }
  flags wide { w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29, w30, w31, w32, w33, w34, w35, w36, w37, w38, w39 }
  record doc {
    id: u64,
    title: string,
    tags: list<string>,
    shapes: list<shape>,
    owner: option<string>,
    mode: perms,
    tint: color,
    score: result<f64, string>,
    glyph: char,
  }
}
