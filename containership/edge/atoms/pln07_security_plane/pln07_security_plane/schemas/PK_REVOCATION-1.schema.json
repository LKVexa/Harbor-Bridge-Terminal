{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_REVOCATION/1",
  "title": "PK_REVOCATION/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "grant_id", "effective_at", "horizon"],
  "properties": {
    "type": {"const": "PK_REVOCATION/1"},
    "grant_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "effective_at": {"type": "integer", "minimum": 0},
    "horizon": {"type": "integer", "minimum": 0},
    "reason": {"type": "string", "maxLength": 1024}
  }
}
