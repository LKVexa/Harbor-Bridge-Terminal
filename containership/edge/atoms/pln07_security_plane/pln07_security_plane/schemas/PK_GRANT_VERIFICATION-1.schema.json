{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_GRANT_VERIFICATION/1",
  "title": "PK_GRANT_VERIFICATION/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "verified", "code", "reason", "grant_id", "capability", "tenant"],
  "properties": {
    "type": {"const": "PK_GRANT_VERIFICATION/1"},
    "verified": {"type": "boolean"},
    "code": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "grant_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "capability": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
