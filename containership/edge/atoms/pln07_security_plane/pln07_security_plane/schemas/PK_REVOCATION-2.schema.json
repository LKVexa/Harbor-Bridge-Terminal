{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_REVOCATION/2",
  "title": "PK_REVOCATION/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op",
    "type",
    "fingerprint",
    "grant_id",
    "tenant",
    "effective_at",
    "horizon",
    "not_after",
    "epoch",
    "seq",
    "prev",
    "hash"
  ],
  "properties": {
    "op": {
      "const": "revoke"
    },
    "type": {
      "const": "PK_REVOCATION/2"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "effective_at": {
      "type": "integer",
      "minimum": 0
    },
    "horizon": {
      "type": "integer",
      "minimum": 0
    },
    "not_after": {
      "type": "integer",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "maxLength": 1024
    },
    "actor": {
      "type": "string"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}