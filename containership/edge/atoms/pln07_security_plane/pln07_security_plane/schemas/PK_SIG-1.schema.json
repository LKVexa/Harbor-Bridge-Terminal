{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_SIG/1",
  "title": "PK_SIG/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "alg",
    "kid",
    "domain",
    "sig"
  ],
  "properties": {
    "type": {
      "const": "PK_SIG/1"
    },
    "alg": {
      "enum": [
        "Ed25519",
        "HMAC-SHA256"
      ]
    },
    "kid": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "sig": {
      "type": "string",
      "contentEncoding": "base64"
    }
  }
}