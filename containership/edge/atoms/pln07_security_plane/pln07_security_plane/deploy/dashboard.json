{"title": "PLN-07 Security Plane", "panels": [
 {"title": "Requests by op/outcome", "expr": "sum by (op,outcome)(rate(pln07_requests_total[5m]))"},
 {"title": "Deny ratio", "expr": "sum(rate(pln07_requests_total{outcome!=\"ok\"}[5m])) / sum(rate(pln07_requests_total[5m]))"},
 {"title": "Verify p99 (ns)", "expr": "pln07_verify_latency_ns{quantile=\"0.99\"}"},
 {"title": "Issue p99 (ns)", "expr": "pln07_issue_latency_ns{quantile=\"0.99\"}"},
 {"title": "Shed rate", "expr": "sum(rate(pln07_requests_total{outcome=\"admission.overloaded\"}[5m]))"}
]}
