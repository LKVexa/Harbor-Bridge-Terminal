{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_GRANT/2",
  "title": "PK_GRANT/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "subject",
    "tenant",
    "scope",
    "not_after",
    "depth",
    "parent_id",
    "parent_fingerprint",
    "environment",
    "site",
    "workload",
    "audience",
    "issued_at",
    "not_before",
    "nonce"
  ],
  "properties": {
    "type": {
      "const": "PK_GRANT/2"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "not_after": {
      "type": "integer",
      "minimum": 0
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{16}$"
    },
    "issuer": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "parent_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "site": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "workload": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "audience": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "nonce": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "not_before": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}