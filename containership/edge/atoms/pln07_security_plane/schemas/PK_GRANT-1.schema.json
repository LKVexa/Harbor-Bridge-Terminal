{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_GRANT/1",
  "title": "PK_GRANT/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "subject", "tenant", "scope", "not_after", "depth", "parent_id"],
  "properties": {
    "type": {"const": "PK_GRANT/1"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant": {"type": "string", "minLength": 1, "maxLength": 256},
    "scope": {"type": "array", "uniqueItems": true, "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "not_after": {"type": "integer", "minimum": 0},
    "depth": {"type": "integer", "minimum": 0, "maximum": 5},
    "parent_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"},
    "issuer": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
  }
}
