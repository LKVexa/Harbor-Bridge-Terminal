{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_AUDIT/1",
  "title": "PK_AUDIT/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "seq",
    "ts",
    "action",
    "outcome",
    "code",
    "trace_id",
    "span_id",
    "fields",
    "prev",
    "hash"
  ],
  "properties": {
    "type": {
      "const": "PK_AUDIT/1"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "integer"
    },
    "action": {
      "enum": [
        "issue",
        "attenuate",
        "verify",
        "revoke",
        "health",
        "explain"
      ]
    },
    "outcome": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "code": {
      "type": "string"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "fields": {
      "type": "object"
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}