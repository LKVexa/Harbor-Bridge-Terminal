{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ios735-lctl.invalid/schemas/translation-map-v1.schema.json",
 "title": "IOS735_LCTL/MAP/1 translation map",
 "description": "Wire-format contract only. Cross-record semantics (735/43 cardinality, phase membership, boot order, control reconciliation, hashes vs files) are enforced by tools/check_translation.py.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "phases",
  "components",
  "lifecycle",
  "transitions",
  "error_map",
  "family_op"
 ],
 "properties": {
  "schema": {
   "const": "IOS735_LCTL/MAP/1"
  },
  "phases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/phase"
   }
  },
  "components": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/component"
   }
  },
  "lifecycle": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[a-z][A-Za-z]*$"
   }
  },
  "transitions": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "uniqueItems": true,
    "items": {
     "type": "string",
     "pattern": "^[a-z][A-Za-z]*$"
    }
   }
  },
  "error_map": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "array",
    "minItems": 3,
    "maxItems": 3,
    "prefixItems": [
     {
      "type": "string",
      "pattern": "^[a-z][A-Za-z]*$"
     },
     {
      "enum": [
       "runtime",
       "data",
       "dependency",
       "permission",
       "configuration"
      ]
     },
     {
      "enum": [
       "terminal",
       "userAction",
       "retry",
       "escalate",
       "fallback"
      ]
     }
    ]
   }
  },
  "family_op": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[A-Z][A-Z_]*$"
   }
  }
 },
 "$defs": {
  "phase": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "phase",
    "module",
    "file",
    "count",
    "first",
    "last",
    "end",
    "sha"
   ],
   "properties": {
    "phase": {
     "type": "integer",
     "minimum": 1,
     "maximum": 99
    },
    "module": {
     "type": "string",
     "pattern": "^ios735\\.p[0-9]{2}\\.[a-z0-9_]+$"
    },
    "file": {
     "type": "string",
     "pattern": "^P[0-9]{2}_[a-z0-9_]+\\.lctlc$"
    },
    "count": {
     "type": "integer",
     "minimum": 1
    },
    "first": {
     "type": "string",
     "pattern": "^C[0-9]{4}$"
    },
    "last": {
     "type": "string",
     "pattern": "^C[0-9]{4}$"
    },
    "end": {
     "type": "string",
     "pattern": "^C[0-9]{4}\\.[a-z][A-Za-z]*$"
    },
    "sha": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "component": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "component",
    "type",
    "name",
    "phase",
    "unit",
    "frame_rows_prefix",
    "contract_sha256",
    "family",
    "clause_op",
    "budgets",
    "capabilities",
    "hardware",
    "controls"
   ],
   "properties": {
    "component": {
     "type": "integer",
     "minimum": 1
    },
    "type": {
     "type": "string",
     "pattern": "^C[0-9]{4}[A-Za-z0-9]+$"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "phase": {
     "type": "integer",
     "minimum": 1,
     "maximum": 99
    },
    "unit": {
     "type": "string",
     "pattern": "^P[0-9]{2}_[a-z0-9_]+\\.lctlc$"
    },
    "frame_rows_prefix": {
     "type": "string",
     "pattern": "^K[0-9]{4}$"
    },
    "contract_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "family": {
     "type": "string",
     "pattern": "^[a-z][A-Za-z]*$"
    },
    "clause_op": {
     "type": "string",
     "pattern": "^[A-Z][A-Z_]*$"
    },
    "budgets": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "metric",
       "unit",
       "limit"
      ],
      "properties": {
       "metric": {
        "type": "string",
        "minLength": 1
       },
       "unit": {
        "type": "string",
        "minLength": 1
       },
       "limit": {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]+)?$"
       }
      }
     }
    },
    "capabilities": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z]*$"
     }
    },
    "hardware": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z]*$"
     }
    },
    "controls": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/control"
     }
    }
   }
  },
  "control": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "control",
    "status",
    "complete",
    "text_sha256"
   ],
   "properties": {
    "control": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]{2}$"
    },
    "status": {
     "enum": [
      "SKELETON_DECLARED",
      "WRITTEN_NOT_RUN",
      "NEEDS_PRODUCT_DECISION",
      "NEEDS_HUMAN_REVIEW",
      "NEEDS_DEVICE_RUN",
      "DECLARED_NOT_USER_VISIBLE",
      "NEEDS_CI_RUN",
      "COMPLETE"
     ]
    },
    "complete": {
     "type": "boolean"
    },
    "text_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  }
 }
}
