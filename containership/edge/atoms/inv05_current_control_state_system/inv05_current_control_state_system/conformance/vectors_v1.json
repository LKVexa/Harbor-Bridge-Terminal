{
  "schema": "cstate.conformance/1",
  "protocol": "PK_CSTATE/1.1",
  "frozen": true,
  "note": "Historical vector files are never rewritten; new behaviour gets a new file (vectors_v1_2.json ...).",
  "principal": {"namespace": ["acme", "prod", "site-a", "ctrl"], "roles": ["writer"]},
  "steps": [
    {"id": "V001", "op": "txn", "body": {"schema": "cstate.txn/1.1", "compare": [{"key": "a", "target": "EXISTS", "op": "==", "operand": false}], "success": [{"put": {"key": "a", "value": "one"}}]},
     "expect": {"succeeded": true, "revision": 1, "compare_results": [true]}},
    {"id": "V002", "op": "txn", "body": {"schema": "cstate.txn/1.1", "compare": [{"key": "a", "target": "MOD", "op": "==", "operand": 0}], "success": [{"put": {"key": "a", "value": "lost"}}], "failure": [{"range": {"key": "a"}}]},
     "expect": {"succeeded": false, "revision": 1}},
    {"id": "V003", "op": "range", "body": {"schema": "cstate.range/1.1", "key": "a"},
     "expect": {"revision": 1, "count": 1, "kvs": [{"key": "a", "value": "one", "create_revision": 1, "mod_revision": 1, "version": 1, "lease": 0}]}},
    {"id": "V004", "op": "txn", "body": {"schema": "cstate.txn/1.1", "success": [{"put": {"key": "b/1", "value": 1}}, {"put": {"key": "b/2", "value": 2}}]},
     "expect": {"succeeded": true, "revision": 2}},
    {"id": "V005", "op": "range", "body": {"schema": "cstate.range/1.1", "key": "b/", "prefix": true, "limit": 1},
     "expect": {"revision": 2, "count": 1, "more": true}},
    {"id": "V006", "op": "txn", "body": {"schema": "cstate.txn/1.1", "success": [{"delete": {"key": "b/", "prefix": true}}]},
     "expect": {"succeeded": true, "revision": 3, "responses": [{"delete": {"deleted": 2}}]}},
    {"id": "V007", "op": "range", "body": {"schema": "cstate.range/1.1", "key": "b/1", "revision": 2},
     "expect": {"revision": 2, "count": 1}},
    {"id": "V008", "op": "compact_admin", "body": {"schema": "cstate.compact/1.1", "revision": 2}, "expect": {"compact_revision": 2}},
    {"id": "V009", "op": "range", "body": {"schema": "cstate.range/1.1", "key": "a", "revision": 1},
     "expect_error": "CSTATE_COMPACTED"},
    {"id": "V010", "op": "range", "body": {"schema": "cstate.range/1.1", "key": "a", "revision": 99},
     "expect_error": "CSTATE_FUTURE_REVISION"},
    {"id": "V011", "op": "txn", "body": {"schema": "cstate.txn/1.1", "compare": [{"key": "a", "target": "VALUE", "op": "<", "operand": 1}]},
     "expect_error": "CSTATE_UNSUPPORTED_PREDICATE"},
    {"id": "V012", "op": "txn", "body": {"schema": "cstate.txn/1.1", "success": [{"put": {"key": "a", "value": 1}}, {"put": {"key": "a", "value": 2}}]},
     "expect_error": "CSTATE_INVALID_ARGUMENT"},
    {"id": "V013", "op": "range", "body": {"schema": "cstate.range/2.0", "key": "a"}, "expect_error": "CSTATE_INCOMPATIBLE_VERSION"},
    {"id": "V014", "op": "range", "body": {"schema": "cstate.range/1.0", "key": "a", "unknown": 1}, "expect_error": "CSTATE_INVALID_ARGUMENT"},
    {"id": "V015", "op": "range", "body": {"schema": "cstate.range/1.9", "key": "a", "unknown": 1}, "expect": {"count": 1}},
    {"id": "V016", "op": "txn", "body": {"schema": "cstate.txn/1.1", "success": [{"put": {"key": "big", "value": "XXXXXXXXXXXXXXXXXXXX"}}]}, "limits": {"max_value_bytes": 8},
     "expect_error": "CSTATE_LIMIT"},
    {"id": "V017", "op": "txn", "body": {"schema": "cstate.txn/1.1", "success": [{"put": {"key": "r", "value": 1}}], "request_id": "idem-1"},
     "expect": {"succeeded": true, "revision": 4, "replayed": false}},
    {"id": "V018", "op": "txn", "body": {"schema": "cstate.txn/1.1", "success": [{"put": {"key": "r", "value": 1}}], "request_id": "idem-1"},
     "expect": {"succeeded": true, "revision": 4, "replayed": true}},
    {"id": "V019", "op": "txn", "body": {"schema": "cstate.txn/1.1", "success": [{"put": {"key": "r", "value": 2}}], "request_id": "idem-1"},
     "expect_error": "CSTATE_CONFLICT"},
    {"id": "V020", "op": "watch_collect", "body": {"schema": "cstate.watch/1.1", "start_revision": 3},
     "expect": {"events": [{"revision": 3, "kind": "DELETE", "key": "b/1"}, {"revision": 3, "kind": "DELETE", "key": "b/2"}, {"revision": 4, "kind": "CREATE", "key": "r"}]}},
    {"id": "V021", "op": "watch_open", "body": {"schema": "cstate.watch/1.1", "start_revision": 2}, "expect_error": "CSTATE_COMPACTED"},
    {"id": "V022", "op": "range", "body": {"schema": "cstate.range/1.1", "key": 5}, "expect_error": "CSTATE_INVALID_ARGUMENT"},
    {"id": "V023", "op": "range", "body": ["not", "an", "object"], "expect_error": "CSTATE_INVALID_ARGUMENT"},
    {"id": "V024", "op": "lease_grant", "body": {"schema": "cstate.lease_grant/1.1", "ttl": 1}, "expect_error": "CSTATE_INVALID_ARGUMENT"},
    {"id": "V025", "op": "lease_keepalive", "body": {"schema": "cstate.lease_keepalive/1.1", "id": 424242}, "expect_error": "CSTATE_LEASE_NOT_FOUND"}
  ]
}
