{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_LOG/1",
  "title": "Structured log record",
  "type": "object",
  "required": [
    "schema",
    "node",
    "component",
    "release",
    "ts",
    "level",
    "event",
    "operation",
    "tenant",
    "workload",
    "trace_id",
    "span_id",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "PK_LOG/1"
    },
    "node": {
      "type": "string",
      "minLength": 1
    },
    "component": {
      "type": "string"
    },
    "release": {
      "type": "string"
    },
    "ts": {
      "type": "number"
    },
    "level": {
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "SECURITY"
      ]
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": [
        "string",
        "null"
      ]
    },
    "workload": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fields": {
      "type": "object"
    }
  }
}
