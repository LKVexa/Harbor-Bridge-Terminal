{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_DATA_PLANE_HEALTH/1",
  "title": "PLN-06 health/readiness snapshot",
  "type": "object",
  "required": ["schema", "element", "version", "healthy", "ready", "inflight", "inflight_limit", "config_revision", "capabilities"],
  "properties": {
    "schema": {"const": "PK_DATA_PLANE_HEALTH/1"},
    "element": {"const": "PLN-06"},
    "version": {"type": "string", "minLength": 1},
    "healthy": {"type": "boolean"},
    "ready": {"type": "boolean"},
    "inflight": {"type": "integer", "minimum": 0},
    "inflight_limit": {"type": "integer", "minimum": 1},
    "config_revision": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
