{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_TRANSFER/1",
  "title": "PLN-06 transfer decision",
  "type": "object",
  "required": [
    "schema",
    "tenant",
    "workload",
    "tier",
    "size",
    "classification",
    "destination",
    "locality",
    "digest_required",
    "digest_algorithm",
    "transfer_id",
    "config_revision",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "PK_TRANSFER/1"
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "workload": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "inline",
        "local",
        "bulk"
      ]
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "locality": {
      "enum": [
        "auto",
        "in_process",
        "same_node",
        "same_host_vm",
        "remote",
        "vm_control"
      ]
    },
    "digest_required": {
      "const": true
    },
    "digest_algorithm": {
      "const": "sha256"
    },
    "digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "transfer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_revision": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}