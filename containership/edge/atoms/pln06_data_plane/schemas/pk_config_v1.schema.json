{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_DATA_PLANE_CONFIG/1",
  "title": "Declarative data-plane configuration",
  "type": "object",
  "required": [
    "schema",
    "context",
    "inflight_limit",
    "per_tenant_inflight_limit",
    "require_authentication",
    "require_signed_labels",
    "require_digest",
    "tls_required_for_remote",
    "audit_required",
    "retry",
    "stall_timeout_s",
    "telemetry",
    "residency"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "PK_DATA_PLANE_CONFIG/1"
    },
    "context": {
      "enum": [
        "cloud",
        "datacenter",
        "near_edge",
        "far_edge"
      ]
    },
    "inflight_limit": {
      "type": "integer",
      "minimum": 1
    },
    "per_tenant_inflight_limit": {
      "type": "integer",
      "minimum": 1
    },
    "require_authentication": {
      "type": "boolean"
    },
    "require_signed_labels": {
      "type": "boolean"
    },
    "require_digest": {
      "type": "boolean"
    },
    "tls_required_for_remote": {
      "type": "boolean"
    },
    "audit_required": {
      "type": "boolean"
    },
    "retry": {
      "type": "object"
    },
    "stall_timeout_s": {
      "type": "number",
      "minimum": 0
    },
    "telemetry": {
      "type": "object"
    },
    "residency": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
