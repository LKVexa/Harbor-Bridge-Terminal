{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_DATA_PLANE_EXPLAIN/1",
  "title": "Redacted operator explain view",
  "type": "object",
  "required": [
    "schema",
    "transfer",
    "tenant_hash",
    "workload_hash",
    "tier",
    "locality",
    "destination",
    "classification",
    "size",
    "policy_revision",
    "constraints",
    "adapter",
    "lineage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "PK_DATA_PLANE_EXPLAIN/1"
    },
    "transfer": {
      "type": [
        "string",
        "null"
      ]
    },
    "tenant_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "workload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "tier": {
      "enum": [
        "inline",
        "local",
        "bulk"
      ]
    },
    "locality": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "policy_revision": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adapter": {
      "type": "object"
    },
    "lineage": {
      "type": "object"
    }
  }
}
