{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_AUDIT_RECORD/1",
  "title": "Hash-chained audit record",
  "type": "object",
  "required": [
    "seq",
    "ts",
    "event",
    "fields",
    "prev",
    "kid",
    "mac"
  ],
  "additionalProperties": false,
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "number"
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "object"
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kid": {
      "type": "string",
      "minLength": 1
    },
    "mac": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
