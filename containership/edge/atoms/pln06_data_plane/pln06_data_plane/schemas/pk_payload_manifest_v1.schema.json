{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_PAYLOAD_MANIFEST/1",
  "title": "Chunked payload manifest",
  "type": "object",
  "required": [
    "schema",
    "transfer_id",
    "size",
    "chunk_size",
    "chunks",
    "root"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "PK_PAYLOAD_MANIFEST/1"
    },
    "transfer_id": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "chunk_size": {
      "type": "integer",
      "minimum": 1
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
