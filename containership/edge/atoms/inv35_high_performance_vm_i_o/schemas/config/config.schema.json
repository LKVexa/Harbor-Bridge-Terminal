{
  "$id": "INV35_CONFIG/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "breaker_cooldown_s": {
      "default": 1.0,
      "maximum": 600.0,
      "minimum": 0.01,
      "type": "number"
    },
    "breaker_threshold": {
      "default": 8,
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "host_descriptor_capacity": {
      "default": 4096,
      "maximum": 16777216,
      "minimum": 1,
      "type": "integer"
    },
    "max_chain": {
      "default": 16,
      "maximum": 16,
      "minimum": 1,
      "type": "integer"
    },
    "max_chain_bytes": {
      "default": 1048576,
      "maximum": 1073741824,
      "minimum": 1,
      "type": "integer"
    },
    "max_queues_per_tenant": {
      "default": 16,
      "maximum": 1024,
      "minimum": 1,
      "type": "integer"
    },
    "notification_suppression": {
      "default": true,
      "type": "boolean"
    },
    "offline_grace_s": {
      "default": 300.0,
      "maximum": 86400.0,
      "minimum": 0.0,
      "type": "number"
    },
    "offline_policy": {
      "default": "serve_last_good",
      "enum": [
        "freeze",
        "quarantine",
        "serve_last_good"
      ],
      "type": "string"
    },
    "profile": {
      "default": "datacenter",
      "enum": [
        "cloud",
        "datacenter",
        "far_edge",
        "near_edge"
      ],
      "type": "string"
    },
    "queue_depth": {
      "default": 64,
      "maximum": 64,
      "minimum": 1,
      "type": "integer"
    },
    "require_capability": {
      "default": true,
      "type": "boolean"
    },
    "single_use_capabilities": {
      "default": false,
      "type": "boolean"
    },
    "stall_threshold_s": {
      "default": 0.5,
      "maximum": 600.0,
      "minimum": 0.001,
      "type": "number"
    },
    "submit_burst": {
      "default": 4096.0,
      "maximum": 1000000000.0,
      "minimum": 1.0,
      "type": "number"
    },
    "submit_rate_per_s": {
      "default": 200000.0,
      "maximum": 1000000000.0,
      "minimum": 1.0,
      "type": "number"
    },
    "telemetry_sample_rate": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "tenant_share": {
      "default": 0.25,
      "maximum": 1.0,
      "minimum": 0.001,
      "type": "number"
    },
    "vhost_offload": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "breaker_cooldown_s",
    "breaker_threshold",
    "host_descriptor_capacity",
    "max_chain",
    "max_chain_bytes",
    "max_queues_per_tenant",
    "notification_suppression",
    "offline_grace_s",
    "offline_policy",
    "profile",
    "queue_depth",
    "require_capability",
    "single_use_capabilities",
    "stall_threshold_s",
    "submit_burst",
    "submit_rate_per_s",
    "telemetry_sample_rate",
    "tenant_share",
    "vhost_offload"
  ],
  "type": "object"
}
