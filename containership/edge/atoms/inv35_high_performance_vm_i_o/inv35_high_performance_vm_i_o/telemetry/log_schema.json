{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "INV35_LOG/1",
  "type": "object",
  "required": [
    "schema",
    "ts",
    "level",
    "event",
    "trace_id",
    "span_id"
  ],
  "properties": {
    "schema": {
      "const": "INV35_LOG/1"
    },
    "ts": {
      "type": "number"
    },
    "level": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "event": {
      "type": "string"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "code": {
      "type": "string"
    },
    "tenant": {
      "type": "string"
    },
    "queue": {
      "type": "string"
    }
  }
}
