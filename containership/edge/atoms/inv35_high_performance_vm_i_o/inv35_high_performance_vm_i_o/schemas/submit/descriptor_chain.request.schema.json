{
  "$id": "PK_VIRTQUEUE_SUBMIT/1#request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Wire form of a guest-posted chain as the VMM hands it to the datapath. Values are untrusted.",
  "properties": {
    "descriptors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "minimum": 0,
            "type": "integer"
          },
          "index": {
            "minimum": 0,
            "type": "integer"
          },
          "length": {
            "minimum": 0,
            "type": "integer"
          },
          "next_index": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "index",
          "address",
          "length"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "head": {
      "minimum": 0,
      "type": "integer"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "queue": {
      "minLength": 1,
      "type": "string"
    },
    "tenant": {
      "minLength": 1,
      "type": "string"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "queue",
    "tenant",
    "head",
    "descriptors"
  ],
  "type": "object"
}
