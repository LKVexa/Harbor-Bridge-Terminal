{
 "schema": "INV18_FIXTURE/1",
 "contract_major": 1,
 "id": "FX-04-duplicate_resolution",
 "description": "second resolution refused, first kept",
 "steps": [
  {
   "op": "create",
   "caps": [
    "create",
    "resolve",
    "abandon",
    "receive",
    "inspect"
   ],
   "doc": {
    "schema": "PK_FUTURE/1",
    "future_id": "new",
    "value_type": "int",
    "epoch": 1
   },
   "expect": {
    "ok": true
   },
   "save": "fid"
  },
  {
   "op": "resolve",
   "caps": [
    "create",
    "resolve",
    "abandon",
    "receive",
    "inspect"
   ],
   "doc": {
    "schema": "PK_FUTURE_RESOLVE/1",
    "future_id": "$fid",
    "outcome": "ok",
    "value": 1,
    "epoch": 1,
    "idempotency_key": "k1"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "op": "resolve",
   "caps": [
    "create",
    "resolve",
    "abandon",
    "receive",
    "inspect"
   ],
   "doc": {
    "schema": "PK_FUTURE_RESOLVE/1",
    "future_id": "$fid",
    "outcome": "ok",
    "value": 2,
    "epoch": 1,
    "idempotency_key": "k2"
   },
   "expect": {
    "ok": false,
    "code": "FUTURE_ALREADY_RESOLVED"
   }
  },
  {
   "op": "take",
   "caps": [
    "create",
    "resolve",
    "abandon",
    "receive",
    "inspect"
   ],
   "doc": {
    "schema": "PK_FUTURE/1",
    "future_id": "$fid",
    "value_type": "int",
    "epoch": 0
   },
   "expect": {
    "ok": true,
    "result": {
     "outcome": "ok",
     "value": 1
    }
   }
  }
 ]
}