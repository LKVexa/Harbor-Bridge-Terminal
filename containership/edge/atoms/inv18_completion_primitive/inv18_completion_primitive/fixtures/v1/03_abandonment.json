{
 "schema": "INV18_FIXTURE/1",
 "contract_major": 1,
 "id": "FX-03-abandonment",
 "description": "writer dropped: receiver gets FUTURE_ABANDONED",
 "steps": [
  {
   "op": "create",
   "caps": [
    "create",
    "resolve",
    "abandon",
    "receive",
    "inspect"
   ],
   "doc": {
    "schema": "PK_FUTURE/1",
    "future_id": "new",
    "value_type": "int",
    "epoch": 1
   },
   "expect": {
    "ok": true
   },
   "save": "fid"
  },
  {
   "op": "abandon",
   "caps": [
    "create",
    "resolve",
    "abandon",
    "receive",
    "inspect"
   ],
   "doc": {
    "schema": "PK_FUTURE_ABANDON/1",
    "future_id": "$fid",
    "epoch": 1,
    "idempotency_key": "a1",
    "reason": "writer_dropped"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "op": "take",
   "caps": [
    "create",
    "resolve",
    "abandon",
    "receive",
    "inspect"
   ],
   "doc": {
    "schema": "PK_FUTURE/1",
    "future_id": "$fid",
    "value_type": "int",
    "epoch": 0
   },
   "expect": {
    "ok": false,
    "code": "FUTURE_ABANDONED"
   }
  }
 ]
}