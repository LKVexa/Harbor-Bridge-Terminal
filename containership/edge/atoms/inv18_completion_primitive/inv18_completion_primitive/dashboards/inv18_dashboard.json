{"schema": "INV18_DASHBOARD/1", "title": "INV-18 Completion primitive",
 "panels": [
  {"title": "Rate / throughput", "metrics": ["inv18_futures_created_total", "inv18_takes_total"], "kind": "rate"},
  {"title": "Errors by code", "metrics": ["inv18_rejections_total"], "group_by": "code", "kind": "rate"},
  {"title": "Latency percentiles", "metrics": ["inv18_resolution_latency_seconds", "inv18_receive_latency_seconds"], "kind": "percentiles", "percentiles": [50, 95, 99]},
  {"title": "Outstanding futures", "metrics": ["inv18_futures_open"], "kind": "gauge", "thresholds": {"warning": "soft_outstanding", "critical": "max_outstanding"}},
  {"title": "Saturation", "metrics": ["inv18_limit_hits_total"], "group_by": "limit", "kind": "rate"},
  {"title": "Dependency state", "source": "status.dependencies", "kind": "table"},
  {"title": "Abandonment / duplicates", "metrics": ["inv18_abandonments_total", "inv18_double_resolutions_total", "inv18_double_takes_total"], "kind": "rate"},
  {"title": "Invariant violations", "metrics": ["inv18_invariant_violations_total"], "kind": "stat"}
 ]}
