{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_INTENT_GRAPH/1",
  "title": "PK_INTENT_GRAPH/1",
  "type": "object",
  "required": ["version", "nodes"],
  "properties": {
    "version": {"type": "integer", "minimum": 0},
    "nodes": {"type": "array", "items": {
      "type": "object", "required": ["node", "spec", "after"],
      "properties": {
        "node": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
        "spec": {"type": "object"},
        "after": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}}
      }}}
  }
}
