{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_ACTUAL_STATE/1",
  "title": "PK_ACTUAL_STATE/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reporter", "site", "observed_at", "nodes"],
  "properties": {
    "schema": {"const": "PK_ACTUAL_STATE/1"},
    "reporter": {"type": "string", "minLength": 1, "maxLength": 256},
    "site": {"type": "string", "minLength": 1, "maxLength": 128},
    "observed_at": {"type": "number", "minimum": 0},
    "sequence": {"type": "integer", "minimum": 0},
    "nodes": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["node", "spec"],
        "properties": {
          "node": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "spec": {"type": "object"}
        }
      }
    }
  }
}
