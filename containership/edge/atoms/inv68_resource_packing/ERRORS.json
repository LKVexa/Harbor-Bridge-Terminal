{
  "schema": "PK_PACK_ERROR_REGISTRY/1",
  "outcomes": [
    "success",
    "partial",
    "degraded",
    "retryable",
    "terminal",
    "refused"
  ],
  "codes": [
    {
      "code": "INVALID_REQUEST",
      "outcome": "terminal",
      "retryable": false,
      "status": 400,
      "summary": "request failed schema or semantic validation"
    },
    {
      "code": "PAYLOAD_TOO_LARGE",
      "outcome": "terminal",
      "retryable": false,
      "status": 413,
      "summary": "request exceeds a declared payload limit"
    },
    {
      "code": "UNSUPPORTED_PROTOCOL",
      "outcome": "terminal",
      "retryable": false,
      "status": 426,
      "summary": "no mutually supported PK_PACK protocol version"
    },
    {
      "code": "UNAUTHENTICATED",
      "outcome": "refused",
      "retryable": false,
      "status": 401,
      "summary": "no valid principal credential"
    },
    {
      "code": "FORBIDDEN",
      "outcome": "refused",
      "retryable": false,
      "status": 403,
      "summary": "principal lacks the required capability or tenant scope"
    },
    {
      "code": "REPLAY_DETECTED",
      "outcome": "refused",
      "retryable": false,
      "status": 409,
      "summary": "credential nonce was already used"
    },
    {
      "code": "IDEMPOTENCY_CONFLICT",
      "outcome": "terminal",
      "retryable": false,
      "status": 409,
      "summary": "idempotency key reused with a different request"
    },
    {
      "code": "QUOTA_EXCEEDED",
      "outcome": "refused",
      "retryable": true,
      "status": 429,
      "summary": "tenant quota or fairness budget exhausted"
    },
    {
      "code": "OVERLOADED",
      "outcome": "retryable",
      "retryable": true,
      "status": 503,
      "summary": "admission control shed the request"
    },
    {
      "code": "CIRCUIT_OPEN",
      "outcome": "retryable",
      "retryable": true,
      "status": 503,
      "summary": "a required dependency circuit is open"
    },
    {
      "code": "DEADLINE_EXCEEDED",
      "outcome": "retryable",
      "retryable": true,
      "status": 504,
      "summary": "the request deadline expired before completion"
    },
    {
      "code": "CANCELLED",
      "outcome": "terminal",
      "retryable": false,
      "status": 499,
      "summary": "the caller cancelled the request"
    },
    {
      "code": "DEPENDENCY_UNAVAILABLE",
      "outcome": "retryable",
      "retryable": true,
      "status": 503,
      "summary": "a required dependency call failed"
    },
    {
      "code": "STALE_CAPACITY",
      "outcome": "retryable",
      "retryable": true,
      "status": 503,
      "summary": "capacity data is older than the staleness bound"
    },
    {
      "code": "FROZEN",
      "outcome": "refused",
      "retryable": true,
      "status": 503,
      "summary": "packing is frozen/disabled by an operator control"
    },
    {
      "code": "NOT_READY",
      "outcome": "retryable",
      "retryable": true,
      "status": 503,
      "summary": "component is not ready (no active configuration)"
    },
    {
      "code": "CONFIG_INVALID",
      "outcome": "terminal",
      "retryable": false,
      "status": 422,
      "summary": "configuration failed validation; nothing activated"
    },
    {
      "code": "CONFIG_CONFLICT",
      "outcome": "terminal",
      "retryable": false,
      "status": 409,
      "summary": "configuration activation raced another activation"
    },
    {
      "code": "AUDIT_UNAVAILABLE",
      "outcome": "retryable",
      "retryable": true,
      "status": 503,
      "summary": "security audit sink unavailable; fail-closed op refused"
    },
    {
      "code": "SECRET_IN_CONFIG",
      "outcome": "terminal",
      "retryable": false,
      "status": 422,
      "summary": "inline secret material rejected; use a secret reference"
    },
    {
      "code": "STALE_EPOCH",
      "outcome": "refused",
      "retryable": false,
      "status": 409,
      "summary": "a newer controller epoch owns packing (split-brain fence)"
    },
    {
      "code": "INTERNAL",
      "outcome": "terminal",
      "retryable": false,
      "status": 500,
      "summary": "unexpected internal defect (see correlation id)"
    }
  ]
}
