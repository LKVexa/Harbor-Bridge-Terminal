{
  "schema": "PK_PACK_METRICS_CATALOG/1",
  "max_series_per_metric": 200,
  "tenant_label_allowed_on": [
    "inv68_requests_total",
    "inv68_request_latency_ms",
    "inv68_unplaced_total"
  ],
  "metrics": [
    {
      "name": "inv68_requests_total",
      "type": "counter",
      "unit": "requests",
      "labels": [
        "tenant",
        "code"
      ],
      "description": "every pack call, by outcome code"
    },
    {
      "name": "inv68_request_latency_ms",
      "type": "histogram",
      "unit": "ms",
      "labels": [
        "tenant"
      ],
      "description": "end-to-end service latency; buckets 1..2500 ms"
    },
    {
      "name": "inv68_in_flight",
      "type": "gauge",
      "unit": "requests",
      "labels": [],
      "description": "admitted and running"
    },
    {
      "name": "inv68_queue_depth",
      "type": "gauge",
      "unit": "requests",
      "labels": [],
      "description": "waiting in admission queue"
    },
    {
      "name": "inv68_hosts_used",
      "type": "gauge",
      "unit": "hosts",
      "labels": [],
      "description": "hosts opened by the last pack (contract signal hosts_used)"
    },
    {
      "name": "inv68_unplaced_total",
      "type": "counter",
      "unit": "workloads",
      "labels": [
        "tenant"
      ],
      "description": "unplaced workloads (contract signal unplaced)"
    },
    {
      "name": "inv68_stranded_cpu",
      "type": "gauge",
      "unit": "cores",
      "labels": [],
      "description": "effective CPU left stranded (contract signal)"
    },
    {
      "name": "inv68_stranded_mem",
      "type": "gauge",
      "unit": "GiB",
      "labels": [],
      "description": "effective memory left stranded (contract signal)"
    },
    {
      "name": "inv68_efficiency_ratio",
      "type": "gauge",
      "unit": "ratio",
      "labels": [],
      "description": "hosts / placeable lower bound, last pack"
    },
    {
      "name": "inv68_mem_overcommit_hosts",
      "type": "gauge",
      "unit": "hosts",
      "labels": [],
      "description": "hosts above effective memory; MUST stay 0"
    },
    {
      "name": "inv68_idempotent_replays_total",
      "type": "counter",
      "unit": "requests",
      "labels": [],
      "description": "responses served from the idempotency cache"
    },
    {
      "name": "inv68_audit_dropped_total",
      "type": "counter",
      "unit": "records",
      "labels": [],
      "description": "audit records lost while the sink was down"
    },
    {
      "name": "inv68_audit_buffered",
      "type": "gauge",
      "unit": "records",
      "labels": [],
      "description": "audit records waiting for the sink"
    },
    {
      "name": "inv68_frozen",
      "type": "gauge",
      "unit": "bool",
      "labels": [],
      "description": "1 while frozen"
    },
    {
      "name": "inv68_config_info",
      "type": "gauge",
      "unit": "info",
      "labels": [
        "config_version"
      ],
      "description": "active configuration version"
    }
  ]
}