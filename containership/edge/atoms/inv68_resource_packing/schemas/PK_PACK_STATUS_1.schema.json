    "frozen": {
      "type": [
        "object",
        "null"
      ]
    },
    "stalled": {
      "type": "boolean"
    },
    "config": {
      "type": [
        "object",
        "null"
      ]
    },
    "epoch": {
      "type": "integer"
    },
    "dependencies": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "admission": {
      "type": "object"
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
