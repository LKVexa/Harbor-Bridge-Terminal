{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv68:PK_PACK_ERROR:1",
  "title": "PK_PACK_ERROR/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "code",
    "outcome",
    "retryable",
    "status",
    "message",
    "details",
    "correlation_id"
  ],
  "properties": {
    "schema": {
      "const": "PK_PACK_ERROR/1"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z_]+$"
    },
    "outcome": {
      "enum": [
        "success",
        "partial",
        "degraded",
        "retryable",
        "terminal",
        "refused"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "status": {
      "type": "integer"
    },
    "message": {
      "type": "string",
      "maxLength": 512
    },
    "details": {
      "type": "object"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
