{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:post-kubernetes:PK_INV31_CONFIG:1",
  "title": "PK_INV31_CONFIG/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "config_version",
    "author",
    "environment",
    "pool"
  ],
  "properties": {
    "schema": {
      "const": "PK_INV31_CONFIG/1"
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "environment": {
      "enum": [
        "cloud",
        "datacenter",
        "near-edge",
        "far-edge",
        "test"
      ]
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency_limit",
        "max_age",
        "max_instances"
      ],
      "properties": {
        "concurrency_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_age": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "tenant_quotas": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "max_tenant_share": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    }
  }
}