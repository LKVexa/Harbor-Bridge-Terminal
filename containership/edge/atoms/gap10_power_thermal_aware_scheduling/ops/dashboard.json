{
  "schema": "PK_GAP10_DASHBOARD/1",
  "title": "GAP-10 Power/Thermal",
  "panels": [
    {
      "title": "Ceiling fraction by node",
      "expr": "gap10_ceiling_fraction"
    },
    {
      "title": "Exclusions by reason",
      "expr": "sum by (reason) (increase(gap10_thermal_exclusions_total[1h]))"
    },
    {
      "title": "Node temperature",
      "expr": "gap10_node_temperature_celsius"
    },
    {
      "title": "Power ratio",
      "expr": "gap10_power_ratio"
    },
    {
      "title": "Telemetry age",
      "expr": "gap10_telemetry_age_seconds"
    },
    {
      "title": "Telemetry outcomes",
      "expr": "sum by (outcome) (rate(gap10_telemetry_samples_total[5m]))"
    },
    {
      "title": "Hysteresis holds",
      "expr": "rate(gap10_hysteresis_holds_total[5m])"
    },
    {
      "title": "Decision latency p50/p95/p99",
      "expr": "histogram_quantile(0.99, rate(gap10_decision_latency_seconds_bucket[5m]))"
    },
    {
      "title": "Dependency failures",
      "expr": "sum by (dependency, code) (rate(gap10_dependency_failures_total[5m]))"
    },
    {
      "title": "Enforcement divergence",
      "expr": "gap10_enforcement_divergence"
    },
    {
      "title": "Safe to enforce",
      "expr": "gap10_safe_to_enforce"
    },
    {
      "title": "Battery runtime",
      "expr": "gap10_battery_runtime_seconds"
    }
  ]
}