{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schemas:PK_THERMAL_STATE:1",
  "title": "PK_THERMAL_STATE/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node", "temperature_c"],
  "properties": {
    "schema": {"const": "PK_THERMAL_STATE/1"},
    "node": {"type": "string", "minLength": 1, "maxLength": 256},
    "temperature_c": {"type": ["number", "null"]},
    "power_draw_watts": {"type": ["number", "null"], "minimum": 0},
    "power_budget_watts": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "battery_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "observed_at": {"type": ["number", "null"]}
  }
}
