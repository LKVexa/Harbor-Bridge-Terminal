{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schemas:PK_POWER_CEILING:1",
  "title": "PK_POWER_CEILING/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "node",
    "band",
    "ceiling",
    "ceiling_fraction",
    "excluded",
    "reason",
    "reasons",
    "telemetry_status"
  ],
  "properties": {
    "schema": {
      "const": "PK_POWER_CEILING/1"
    },
    "node": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "band": {
      "enum": [
        "nominal",
        "elevated",
        "critical",
        "emergency"
      ]
    },
    "ceiling": {
      "type": "integer",
      "minimum": 0
    },
    "ceiling_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "excluded": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "telemetry_status": {
      "enum": [
        "unobserved",
        "fresh",
        "freshness-unchecked",
        "stale",
        "future",
        "replayed"
      ]
    },
    "decision_id": {
      "type": "string",
      "pattern": "^dec-[0-9a-f]{16}$"
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "controller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "number"
    },
    "automation_disabled": {
      "type": "boolean"
    },
    "precedence_trail": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object"
      }
    }
  },
  "description": "v1.1 (GAP-10 4.3.0): optional provenance fields added; required set unchanged, so v1.0 consumers remain compatible."
}