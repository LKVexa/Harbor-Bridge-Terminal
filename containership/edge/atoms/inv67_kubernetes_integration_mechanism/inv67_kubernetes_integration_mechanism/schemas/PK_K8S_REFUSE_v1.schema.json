{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv67:PK_K8S_REFUSE:1",
  "title": "INV-67 Kubernetes translation refusal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code", "message", "details"],
  "properties": {
    "schema": {"const": "PK_K8S_REFUSE/1"},
    "code": {"enum": ["PK_K8S_UNSUPPORTED_FIELD", "PK_K8S_INVALID_POD"]},
    "message": {"type": "string", "minLength": 1},
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
