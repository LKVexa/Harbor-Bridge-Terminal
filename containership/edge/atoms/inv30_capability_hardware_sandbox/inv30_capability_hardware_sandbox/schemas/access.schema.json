{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linearfinance.org/schemas/inv30/access/1",
  "title": "PK_CAPABILITY_ACCESS/1 check request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handle",
    "address",
    "size",
    "operation"
  ],
  "properties": {
    "schema": {
      "const": "PK_CAPABILITY_ACCESS/1"
    },
    "handle": {
      "type": "string",
      "pattern": "^cap_[0-9a-f]{32}$"
    },
    "address": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "operation": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "execute"
      ]
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "traceparent": {
      "type": "string",
      "maxLength": 55
    }
  }
}