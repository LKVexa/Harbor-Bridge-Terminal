{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linearfinance.org/schemas/inv30/failure/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "element",
    "component_version",
    "code",
    "category",
    "status",
    "retryable",
    "terminal",
    "message",
    "correlation_id"
  ],
  "properties": {
    "schema": {
      "const": "PK_FAILURE/1"
    },
    "element": {
      "const": "INV-30"
    },
    "component_version": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z_]+$"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "integer"
    },
    "retryable": {
      "type": "boolean"
    },
    "terminal": {
      "type": "boolean"
    },
    "message": {
      "type": "string",
      "maxLength": 512
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}