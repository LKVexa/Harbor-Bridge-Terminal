{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linearfinance.org/schemas/inv30/access-result/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "address",
    "size",
    "operation",
    "permitted",
    "enforcement"
  ],
  "properties": {
    "schema": {
      "const": "PK_CAPABILITY_ACCESS/1"
    },
    "address": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "size": {
      "type": "integer",
      "minimum": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "execute"
      ]
    },
    "permitted": {
      "const": true
    },
    "enforcement": {
      "enum": [
        "semantic-model",
        "cheri-hardware"
      ]
    }
  }
}