{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linearfinance.org/schemas/inv30/config/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "require_hardware",
    "deployment_context",
    "limits",
    "telemetry",
    "rollout"
  ],
  "properties": {
    "schema": {
      "const": "INV30_CONFIG/1"
    },
    "mode": {
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "require_hardware": {
      "type": "boolean"
    },
    "deployment_context": {
      "enum": [
        "cloud",
        "datacenter",
        "near-edge",
        "far-edge"
      ]
    },
    "limits": {
      "type": "object"
    },
    "telemetry": {
      "type": "object"
    },
    "rollout": {
      "type": "object"
    },
    "auth": {
      "type": "object"
    },
    "secret_refs": {
      "type": "object"
    }
  }
}