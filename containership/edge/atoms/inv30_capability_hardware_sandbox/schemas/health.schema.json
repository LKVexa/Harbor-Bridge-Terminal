{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linearfinance.org/schemas/inv30/health/1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "ready",
    "version",
    "enforcement",
    "config_digest",
    "dependencies",
    "active_capabilities",
    "mode"
  ],
  "properties": {
    "schema": {
      "const": "INV30_HEALTH/1"
    },
    "status": {
      "enum": [
        "healthy",
        "degraded",
        "stalled",
        "quarantined",
        "disabled"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    },
    "enforcement": {
      "enum": [
        "semantic-model",
        "cheri-hardware"
      ]
    },
    "config_digest": {
      "type": "string"
    },
    "dependencies": {
      "type": "object"
    },
    "active_capabilities": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "enum": [
        "development",
        "staging",
        "production"
      ]
    }
  }
}