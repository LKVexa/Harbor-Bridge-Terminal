{
 "schema": "PK_OWNERS/1",
 "roles": [
  {
   "alias": "inv27-service-owner",
   "duty": "accountable for INV-27 behaviour and this repository",
   "required": true,
   "holder": "UNASSIGNED"
  },
  {
   "alias": "inv27-security-owner",
   "duty": "owns seal/trust/isolation decisions and vulnerability response",
   "required": true,
   "holder": "UNASSIGNED"
  },
  {
   "alias": "inv27-release-approver",
   "duty": "signs the release gate; must differ from the security owner",
   "required": true,
   "holder": "UNASSIGNED"
  },
  {
   "alias": "inv27-oncall",
   "duty": "first responder; pages via the escalation chain",
   "required": true,
   "holder": "UNASSIGNED"
  },
  {
   "alias": "inv27-architecture-reviewer",
   "duty": "reviews ADRs and interface changes",
   "required": true,
   "holder": "UNASSIGNED"
  }
 ],
 "escalation": [
  {
   "level": 1,
   "role": "inv27-oncall",
   "within_minutes": 15
  },
  {
   "level": 2,
   "role": "inv27-service-owner",
   "within_minutes": 60
  },
  {
   "level": 3,
   "role": "inv27-security-owner",
   "within_minutes": 60,
   "when": "any seal/trust/isolation bypass"
  }
 ]
}