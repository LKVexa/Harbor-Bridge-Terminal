{
  "environment": "prod",
  "partitions": ["acme/prod/edge-1"],
  "data_dir": "/var/lib/gap15",
  "store.synchronous": "FULL",
  "signing.key_provider": "kms",
  "signing.key_ref": "kms://REPLACE/keys/gap15-service",
  "authz.policy_ref": "file:///etc/gap15/authz-policy.signed.json",
  "policy.ref": "file:///etc/gap15/precedence-policy.signed.json",
  "api.listen": "0.0.0.0:8443",
  "api.tls_cert_ref": "file:///etc/gap15/tls/server.pem",
  "metrics.token_ref": "file:///run/credentials/gap15/metrics-token",
  "certification.ttl_s": 500,
  "time.required_confidence": "medium",
  "attestation.allow_reduced_trust": false
}
