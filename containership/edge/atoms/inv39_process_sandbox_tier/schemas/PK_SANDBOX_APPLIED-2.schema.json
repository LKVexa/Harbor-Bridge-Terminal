{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_SANDBOX_APPLIED/2",
  "title": "Kernel-verified, signed process sandbox state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","sandbox_id","tenant","workload","process","profile","profile_digest","config_digest",
    "release_digest","nonce","verified","verification_scope","evidence_source","os_enforcement_proven",
    "launcher_attested","default_deny","residual_syscalls","within_budget","capabilities_retained","namespaces",
    "kernel","shares_kernel","isolation_note","trace_id","node_id","key_id","issued_at","signature"],
  "properties": {
    "schema": {"const": "PK_SANDBOX_APPLIED/2"},
    "sandbox_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "tenant": {"type": "string", "minLength": 1, "maxLength": 128},
    "workload": {"type": "string", "minLength": 1, "maxLength": 128},
    "process": {"type": "string", "pattern": "^[0-9]+$"},
    "profile": {"type": "string", "minLength": 1, "maxLength": 128},
    "profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "release_digest": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "verified": {"const": true},
    "verification_scope": {"const": "kernel_read_back_before_exec"},
    "evidence_source": {"const": "kernel_read_back"},
    "os_enforcement_proven": {"const": true},
    "launcher_attested": {"type": "object"},
    "default_deny": {"const": true},
    "residual_syscalls": {"type": "integer", "minimum": 1},
    "within_budget": {"type": "boolean"},
    "capabilities_retained": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "namespaces": {"type": "array", "uniqueItems": true, "items": {"enum": ["ipc","mount","net","pid","user","uts"]}},
    "kernel": {"type": "object", "required": ["no_new_privs","seccomp_mode","seccomp_filters","cap_eff","cap_prm","cap_inh","cap_bnd","cap_amb"]},
    "shares_kernel": {"const": true},
    "isolation_note": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "node_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "issued_at": {"type": "integer", "minimum": 0},
    "signature": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
  }
}
