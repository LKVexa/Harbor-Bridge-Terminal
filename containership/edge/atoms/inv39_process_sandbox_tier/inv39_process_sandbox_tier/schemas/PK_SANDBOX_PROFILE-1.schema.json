{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_SANDBOX_PROFILE/1",
  "title": "Process sandbox profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "syscalls", "capabilities", "namespaces", "digest"],
  "properties": {
    "schema": {"const": "PK_SANDBOX_PROFILE/1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "syscalls": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "namespaces": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
