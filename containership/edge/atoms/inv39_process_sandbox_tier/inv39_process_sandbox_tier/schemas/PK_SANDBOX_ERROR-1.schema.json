{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_SANDBOX_ERROR/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","code","outcome","retryable","message","details","trace_id"],
  "properties": {
    "schema": {"const": "PK_SANDBOX_ERROR/1"},
    "code": {"type": "string", "pattern": "^E_[A-Z_]+$"},
    "outcome": {"enum": ["success","partial","degraded","retryable","terminal"]},
    "retryable": {"type": "boolean"},
    "message": {"type": "string", "maxLength": 1024},
    "details": {"type": "object"},
    "trace_id": {"type": ["string","null"]}
  }
}
