{
  "schema": "INV37_CONFIG/1",
  "profile": "prod",
  "limits": {"max_object_bytes": "1GiB", "max_chunk_bytes": "16MiB", "max_concurrent_transfers": 8,
             "max_pending_transfers": 32, "max_mapped_bytes": "4GiB", "host_memory_budget": "8GiB"},
  "tenancy": {"default_max_active_transfers": 2, "default_max_bytes_in_flight": "2GiB"},
  "transport": {"mode": "auto", "require_zero_copy": false},
  "checkpoint": {"enabled": true, "retention": "7d", "max_bytes": "64GiB", "fsync": true},
  "security": {"require_authentication": true, "token_ttl": "15m", "clock_skew": "30s"},
  "telemetry": {"log_level": "info", "trace_sample_ratio": 0.05, "export": "stdout", "retention": "30d"}
}
