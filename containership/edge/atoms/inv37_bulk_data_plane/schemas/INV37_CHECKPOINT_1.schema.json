{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "INV37_CHECKPOINT/1",
  "type": "object",
  "required": [
    "schema",
    "transfer_id",
    "epoch",
    "manifest",
    "tenant",
    "verified",
    "lifecycle",
    "updated_at",
    "seal"
  ],
  "properties": {
    "schema": {
      "const": "INV37_CHECKPOINT/1"
    },
    "transfer_id": {
      "type": "string"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "manifest": {
      "$ref": "PK_BULK_MANIFEST/1"
    },
    "tenant": {
      "type": "string"
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "lifecycle": {
      "type": "string"
    },
    "updated_at": {
      "type": "number"
    },
    "seal": {
      "type": "string",
      "pattern": "^(hmac-sha256|sha256):[0-9a-f]{64}$"
    }
  }
}