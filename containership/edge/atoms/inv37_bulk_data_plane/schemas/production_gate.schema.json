{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "INV37_PRODUCTION_GATE/1",
  "type": "object",
  "required": ["schema", "generated_at", "artifact", "config_digest", "criteria", "missing_approvals", "blockers", "signature", "decision"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "INV37_PRODUCTION_GATE/1"},
    "generated_at": {"type": "string"},
    "artifact": {"type": "object", "required": ["version", "source_digest"]},
    "config_digest": {"type": ["string", "null"]},
    "criteria": {"type": "array", "items": {"type": "object", "required": ["criterion", "domain", "requirements", "status", "reason"],
      "properties": {"status": {"enum": ["PASS", "BLOCKED", "WAIVED", "NOT_APPLICABLE"]}}}},
    "missing_approvals": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "signature": {"type": ["string", "null"]},
    "decision": {"enum": ["PASS", "NO_GO"]}
  }
}
