{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "INV37_SHM_DESCRIPTOR/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abi",
    "name",
    "size",
    "transfer_id",
    "tenant",
    "generation",
    "binding"
  ],
  "properties": {
    "abi": {
      "const": "INV37_SHM_DESCRIPTOR/1"
    },
    "name": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "transfer_id": {
      "type": "string"
    },
    "tenant": {
      "type": "string"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "binding": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}