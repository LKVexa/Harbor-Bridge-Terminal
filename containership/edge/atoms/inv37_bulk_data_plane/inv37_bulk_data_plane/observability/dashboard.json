{
  "schema": "INV37_DASHBOARD/1",
  "title": "INV-37 Bulk data plane",
  "rows": [
    {"title": "Traffic", "panels": ["rate(inv37_transfers_created_total)", "rate(inv37_transfers_verified_total)", "rate(inv37_bytes_verified_total)", "inv37_transfers_active"]},
    {"title": "Errors by class", "panels": ["sum by (outcome) (rate(inv37_errors_total))", "rate(inv37_digest_failures_total) by level", "rate(inv37_security_rejections_total)"]},
    {"title": "Latency", "panels": ["inv37_chunk_accept_seconds_p50/p95/p99", "inv37_finalize_seconds_p99", "inv37_manifest_validate_seconds_p99"]},
    {"title": "Saturation", "panels": ["admission saturation", "pending", "throttle_reasons", "inv37_transfers_stalled"]},
    {"title": "Efficiency", "panels": ["copies per transfer (diagnostics.copies)", "rate(inv37_bytes_resent_total)", "duplicate_chunks_total"]},
    {"title": "Release lineage", "panels": ["version", "artifact_digest", "config_digest", "policy_digest"]}
  ]
}
