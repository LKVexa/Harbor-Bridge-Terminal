{
  "schema": "INV37_CONFIG/1",
  "profile": "edge",
  "limits": {"max_object_bytes": "256MiB", "max_chunk_bytes": "4MiB", "max_concurrent_transfers": 2,
             "max_pending_transfers": 8, "max_mapped_bytes": "512MiB", "host_memory_budget": "1GiB"},
  "tenancy": {"default_max_active_transfers": 1, "default_max_bytes_in_flight": "256MiB"},
  "timeouts": {"idle_chunk": "5m", "total_transfer": "24h"},
  "transport": {"mode": "auto"},
  "checkpoint": {"enabled": true, "retention": "3d", "max_bytes": "8GiB", "fsync": true},
  "security": {"require_authentication": true, "token_ttl": "1h", "clock_skew": "5m"},
  "telemetry": {"log_level": "warning", "trace_sample_ratio": 0.01, "export": "stdout", "retention": "7d"}
}
