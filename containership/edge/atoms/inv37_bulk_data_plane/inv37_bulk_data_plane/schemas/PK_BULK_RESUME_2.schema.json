{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_BULK_RESUME/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transfer_id",
    "manifest_object",
    "verified",
    "epoch",
    "issued_at",
    "mac"
  ],
  "properties": {
    "schema": {
      "const": "PK_BULK_RESUME/2"
    },
    "transfer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,96}$"
    },
    "manifest_object": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "issued_at": {
      "type": "number"
    },
    "mac": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}