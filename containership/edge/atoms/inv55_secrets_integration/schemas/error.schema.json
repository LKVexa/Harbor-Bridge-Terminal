{
  "$id": "PK_SECRET/error",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^INV55-E-[A-Z-]+$",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "DEGRADED",
            "RETRYABLE",
            "TERMINAL",
            "DENIED"
          ]
        },
        "reason": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "retry_after_ms": {
          "type": "integer"
        }
      },
      "required": [
        "code",
        "outcome",
        "message",
        "reason"
      ],
      "type": "object"
    }
  },
  "required": [
    "error"
  ],
  "type": "object"
}
