{
  "$id": "PK_SECRET_ROTATE/1.request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expected_version": {
      "minimum": 0,
      "type": "integer"
    },
    "ext": {
      "type": "object"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9-]{8,64}$",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z0-9-]{1,63}/[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9-]{8,64}$",
      "type": "string"
    },
    "versions": {
      "items": {
        "maxLength": 32,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "versions",
    "request_id",
    "name",
    "idempotency_key"
  ],
  "type": "object"
}
