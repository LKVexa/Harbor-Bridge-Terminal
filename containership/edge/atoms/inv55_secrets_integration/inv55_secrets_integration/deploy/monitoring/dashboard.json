{"title": "INV-55 Secrets integration (DRAFT, not deployed)",
 "panels": [
  {"title": "Requests by outcome", "expr": "sum by (outcome) (rate(inv55_requests_total[5m]))"},
  {"title": "Denials by reason", "expr": "sum by (reason) (rate(inv55_denials_total[5m]))"},
  {"title": "Resolve latency p50/p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(inv55_request_latency_ms_bucket{op=\"RESOLVE\"}[5m])))"},
  {"title": "Provider retries", "expr": "sum by (reason) (rate(inv55_provider_retries_total[5m]))"},
  {"title": "Degraded served", "expr": "sum(rate(inv55_degraded_served_total[5m]))"},
  {"title": "Rotations", "expr": "sum(rate(inv55_rotations_total[1h]))"}]}
