{
 "schema": "PK_ACCEL_CONFIG/1",
 "profile": "far_edge",
 "limits": {
  "max_inventory": 16,
  "max_count": 4
 },
 "quotas": {
  "default_devices_per_tenant": 4,
  "per_tenant": {}
 },
 "inventory_max_age_s": 3600,
