{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:pk:inv72:PK_ACCEL_MATCH-1",
 "title": "PK_ACCEL_MATCH/1 decision",
 "x-version": "1.0.0",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "decision_id",
  "outcome",
  "selected",
  "code",
  "reasons",
  "rationale"
 ],
 "properties": {
  "schema": {
   "const": "PK_ACCEL_MATCH/1"
  },
  "decision_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 128,
   "pattern": "[A-Za-z0-9._:/@-]+"
  },
  "outcome": {
   "enum": [
    "success",
    "refused",
    "retryable",
    "degraded",
    "terminal"
   ]
  },
  "selected": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 128,
    "pattern": "[A-Za-z0-9._:/@-]+"
   }
  },
  "code": {
   "type": [
    "string",
    "null"
   ]
  },
  "reasons": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "code",
     "device",
     "text"
    ],
    "properties": {
     "code": {
      "type": "string",
      "pattern": "ACCEL_[A-Z_]+"
     },
     "device": {
      "type": [
       "string",
       "null"
      ]
     },
     "text": {
      "type": "string"
     }
    }
   }
  },
  "rationale": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "reservation_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "inventory_generation": {
   "type": [
    "integer",
    "null"
   ]
  },
  "config_generation": {
   "type": [
    "integer",
    "null"
   ]
  },
  "trace_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "degraded": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "component_version": {
   "type": "string"
  }
 }
}
