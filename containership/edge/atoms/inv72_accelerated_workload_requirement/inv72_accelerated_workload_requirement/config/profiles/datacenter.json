{
 "schema": "PK_ACCEL_CONFIG/1",
 "profile": "datacenter",
 "limits": {
  "max_inventory": 4096,
  "max_count": 64
 },
 "quotas": {
  "default_devices_per_tenant": 16,
  "per_tenant": {}
 },
 "inventory_max_age_s": 600,
 "offline_grace_s": 0,
 "admission": {
  "rate_per_s": 2000,
  "burst": 200,
  "max_inflight": 256
 },
 "require_authentication": true,
 "require_inventory_mac": true,
 "allow_shared_partitions": true,
 "telemetry": {
  "sample_rate": 1.0,
  "retention_days": 30
 },
 "description": "Private datacenter: same guarantees, 10 min freshness."
}
