{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:pk:inv72:PK_ACCEL_INVENTORY-1",
 "title": "PK_ACCEL_INVENTORY/1 discovered inventory snapshot",
 "x-version": "1.0.0",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "source",
  "generation",
  "observed_at",
  "devices"
 ],
 "properties": {
  "schema": {
   "const": "PK_ACCEL_INVENTORY/1"
  },
  "source": {
   "type": "string",
   "minLength": 1,
   "maxLength": 128,
   "pattern": "[A-Za-z0-9._:/@-]+"
  },
  "generation": {
   "type": "integer",
   "minimum": 0
  },
  "observed_at": {
   "type": "number",
   "minimum": 0
  },
  "digest": {
   "type": "string",
   "pattern": "[0-9a-f]{64}"
  },
  "mac": {
   "type": "string",
   "pattern": "[0-9a-f]{64}"
  },
  "devices": {
   "type": "array",
   "maxItems": 4096,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "dev_id",
     "cls",
     "mem_gb",
     "node",
     "link_group"
    ],
    "properties": {
     "dev_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9._:/@-]+"
     },
     "cls": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9._:/@-]+"
     },
     "mem_gb": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
     },
     "node": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9._:/@-]+"
     },
     "link_group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[A-Za-z0-9._:/@-]+"
     },
     "partition_of": {
      "type": "string",
      "maxLength": 128
     },
     "tenants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 128,
       "pattern": "[A-Za-z0-9._:/@-]+"
      }
     }
    }
   }
  }
 }
}
