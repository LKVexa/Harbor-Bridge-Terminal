{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_SFI_QUARANTINE_REQUEST:1",
  "title": "Quarantine / freeze / disable request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "target",
    "action",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "PK_SFI_QUARANTINE_REQUEST/1"
    },
    "scope": {
      "enum": [
        "global",
        "tenant",
        "artifact"
      ]
    },
    "target": {
      "type": "string",
      "maxLength": 128
    },
    "action": {
      "enum": [
        "freeze",
        "disable"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "second_approver_token": {
      "type": "string"
    }
  }
}
