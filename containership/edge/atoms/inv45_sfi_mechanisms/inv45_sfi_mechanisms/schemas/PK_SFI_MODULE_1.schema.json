{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_SFI_MODULE:1",
  "title": "PK_SFI_MODULE/1 verification report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "accesses", "all_masked", "region", "permitted_targets", "overhead_percent"],
  "properties": {
    "schema": {"const": "PK_SFI_MODULE/1"},
    "module": {"type": "string", "minLength": 1},
    "accesses": {"type": "integer", "minimum": 0},
    "all_masked": {"const": true},
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "size"],
      "properties": {
        "base": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "permitted_targets": {"type": "integer", "minimum": 0},
    "overhead_percent": {"type": "number", "minimum": 0}
  }
}
