{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_SFI_SEALED_DESCRIPTOR:1",
  "title": "Sealed descriptor handed from verifier to trusted loader",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_sha256",
    "profile_id",
    "profile_sha256",
    "proof_sha256",
    "config_sha256",
    "tenant",
    "workload",
    "artifact_version",
    "verifier_version",
    "issued_at",
    "expires_at",
    "nonce",
    "key_id",
    "mac"
  ],
  "properties": {
    "schema": {
      "const": "PK_SFI_SEALED_DESCRIPTOR/1"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_id": {
      "type": "string"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proof_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "artifact_version": {
      "type": "integer",
      "minimum": 0
    },
    "verifier_version": {
      "type": "string"
    },
    "issued_at": {
      "type": "number"
    },
    "expires_at": {
      "type": "number"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "key_id": {
      "type": "string",
      "maxLength": 128
    },
    "mac": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
