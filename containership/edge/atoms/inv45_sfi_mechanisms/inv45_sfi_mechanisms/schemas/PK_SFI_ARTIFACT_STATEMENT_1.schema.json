{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_SFI_ARTIFACT_STATEMENT:1",
  "title": "Signed artifact statement (Ed25519 over canonical JSON)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_sha256",
    "workload",
    "version",
    "issuer"
  ],
  "properties": {
    "schema": {
      "const": "PK_SFI_ARTIFACT_STATEMENT/1"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workload": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "issuer": {
      "type": "string"
    }
  }
}
