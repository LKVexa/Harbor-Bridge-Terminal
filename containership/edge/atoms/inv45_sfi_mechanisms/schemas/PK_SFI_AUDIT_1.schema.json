{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_SFI_AUDIT:1",
  "title": "Tamper-evident audit event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "event",
    "ts",
    "seq",
    "prev",
    "hash"
  ],
  "properties": {
    "schema": {
      "const": "PK_SFI_AUDIT/1"
    },
    "event": {
      "type": "string"
    },
    "ts": {
      "type": "number"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
