{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_SFI_HEALTH:1",
  "title": "Health / readiness / status surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "alive",
    "ready",
    "version",
    "profile_id",
    "profile_sha256",
    "config_generation",
    "config_sha256",
    "dependencies",
    "capabilities",
    "quarantine_entries",
    "instances",
    "admission"
  ],
  "properties": {
    "schema": {
      "const": "PK_SFI_HEALTH/1"
    },
    "status": {
      "enum": [
        "ready",
        "degraded",
        "quarantined",
        "dependency_stale"
      ]
    },
    "alive": {
      "type": "boolean"
    },
    "ready": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_generation": {
      "type": "integer",
      "minimum": 0
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quarantine_entries": {
      "type": "integer",
      "minimum": 0
    },
    "instances": {
      "type": "integer",
      "minimum": 0
    },
    "admission": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    }
  }
}
