{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:msg:subscribe:1",
  "title": "PK_MSG_SUBSCRIBE/1 (declarative form for adapters)",
  "type": "object",
  "required": [
    "contract",
    "topic",
    "route"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "string",
      "enum": [
        "PK_MSG_SUBSCRIBE/1"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "match": {
      "type": "string",
      "maxLength": 4096
    },
    "deadLetterTopic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    }
  }
}
