{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:msg:health:1",
  "title": "PK_MSG_HEALTH/1",
  "type": "object",
  "required": [
    "status",
    "ready",
    "problems",
    "checks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "unhealthy"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "object"
    },
    "lifecycle": {
      "type": "string"
    },
    "dependencies": {
      "type": "object"
    }
  }
}
