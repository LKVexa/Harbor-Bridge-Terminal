{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:msg:envelope:1",
  "title": "PK_MSG_ENVELOPE/1",
  "type": "object",
  "required": [
    "id",
    "source",
    "type",
    "time",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "time": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "data": {
      "not": {
        "type": "null"
      }
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "description": "optional W3C trace-context extension (4.3.0)"
    }
  },
  "additionalProperties": true
}
