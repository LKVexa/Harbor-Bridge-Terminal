{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:post-kubernetes:PLN-02:PK_ERROR:1",
  "title": "PK_ERROR/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "code",
    "category",
    "retryable",
    "http_status",
    "grpc_status",
    "message",
    "details"
  ],
  "properties": {
    "schema": {
      "const": "PK_ERROR/1"
    },
    "code": {
      "enum": [
        "ARTIFACT_UNTRUSTED",
        "AUDIT_CHAIN_BROKEN",
        "CANCELLED",
        "CATALOGUE_STALE",
        "CATALOGUE_UNAVAILABLE",
        "CATALOGUE_UNTRUSTED",
        "CIRCUIT_OPEN",
        "CONFIG_INVALID",
        "DEADLINE_EXCEEDED",
        "FENCED",
        "IDEMPOTENCY_CONFLICT",
        "INCOMPATIBLE_INTERFACE",
        "INTERNAL",
        "INVALID_APPLICATION",
        "NO_ELIGIBLE_PROVIDER",
        "OAM_INVALID",
        "OVERLOADED",
        "PAYLOAD_TOO_LARGE",
        "PERMISSION_DENIED",
        "PLANE_DISABLED",
        "PLANE_FROZEN",
        "POLICY_CONFLICT",
        "QUOTA_EXCEEDED",
        "RESOLUTION_ERROR",
        "REVISION_INTEGRITY_ERROR",
        "REVISION_NOT_FOUND",
        "REVISION_QUARANTINED",
        "SECRET_INLINE",
        "SECRET_UNAVAILABLE",
        "UNAUTHENTICATED",
        "UNSATISFIED_CAPABILITY",
        "UNSUPPORTED_VERSION",
        "WIT_INVALID"
      ]
    },
    "category": {
      "enum": [
        "validation",
        "policy",
        "auth",
        "dependency",
        "integrity",
        "capacity",
        "internal",
        "lifecycle"
      ]
    },
    "retryable": {
      "enum": [
        "never",
        "safe",
        "after_backoff"
      ]
    },
    "http_status": {
      "type": "integer"
    },
    "grpc_status": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "maxLength": 512
    },
    "details": {
      "type": "object"
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 128
    }
  }
}