{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:post-kubernetes:PLN-02:PK_APPLICATION:1",
  "title": "PK_APPLICATION/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "components",
    "edges"
  ],
  "properties": {
    "schema": {
      "const": "PK_APPLICATION/1"
    },
    "components": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "#/$defs/component_name"
          },
          {
            "$ref": "#/$defs/component_name"
          },
          {
            "$ref": "#/$defs/identifier"
          }
        ],
        "minItems": 3,
        "maxItems": 3
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F]+$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/component_name"
        },
        "requires": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "exports": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          }
        },
        "imports": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "component_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@+\\-]*$"
    }
  }
}
