{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:post-kubernetes:PLN-02:PK_APPLICATION_REVISION:1",
  "title": "PK_APPLICATION_REVISION/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "components",
    "component_specs",
    "edges",
    "bindings",
    "dropped_optional",
    "provider_binding_digest",
    "revision"
  ],
  "properties": {
    "schema": {
      "const": "PK_APPLICATION_REVISION/1"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component_name"
      },
      "uniqueItems": true
    },
    "component_specs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "prefixItems": [
          {
            "$ref": "#/$defs/component_name"
          },
          {
            "$ref": "#/$defs/component_name"
          },
          {
            "$ref": "#/$defs/identifier"
          }
        ]
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dropped_optional": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provider_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$"
    },
    "component_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@+\\-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F]+$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "requires",
        "exports",
        "imports"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/component_name"
        },
        "requires": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "exports": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          }
        },
        "imports": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          }
        }
      }
    }
  }
}
