{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:post-kubernetes:PLN-02:PK_SIGNED_CATALOGUE:1",
  "title": "PK_SIGNED_CATALOGUE/1",
  "type": "object",
  "additionalProperties": false,
