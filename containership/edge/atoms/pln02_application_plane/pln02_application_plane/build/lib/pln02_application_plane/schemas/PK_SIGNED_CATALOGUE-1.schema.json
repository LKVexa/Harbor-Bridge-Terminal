          "required": [
            "id",
            "region",
            "residency",
            "tier",
            "consistency",
            "slo_ms",
            "latency_ms",
            "cost",
            "healthy"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 256
            },
            "region": {
              "type": "string"
            },
            "residency": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tier": {
              "enum": [
                "standard",
                "hardened",
                "confidential"
              ]
            },
            "consistency": {
              "enum": [
                "eventual",
                "bounded",
                "strong"
              ]
            },
            "slo_ms": {
              "type": "number"
            },
            "latency_ms": {
              "type": "number"
            },
            "cost": {
              "type": "number"
            },
            "healthy": {
              "type": "boolean"
