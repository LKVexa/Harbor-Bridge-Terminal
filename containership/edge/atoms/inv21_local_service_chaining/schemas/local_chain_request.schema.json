          "type": "string"
        },
        "trace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "trace_id",
        "operation",
        "tenant",
        "subject",
        "path"
      ],
      "type": "object"
    }
