          "enum": [
            "validation",
            "authentication",
            "authorization",
            "isolation",
            "residency",
            "bounds",
            "overload",
            "deadline",
            "cancelled",
            "handler",
            "provider",
            "transport",
            "protocol",
            "lifecycle",
            "internal"
          ]
        },
        "code": {
          "maxLength": 64,
          "pattern": "^PK_CHAIN_[A-Z_]+$",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object"
        },
        "message": {
          "maxLength": 256,
          "type": "string"
        },
        "origin": {
          "enum": [
            "chain",
            "handler",
            "policy",
            "transport"
          ]
        },
        "retriable": {
          "type": "boolean"
        },
        "schema": {
          "const": "PK_CHAIN_ERROR/1"
        }
      },
      "required": [
        "schema",
        "code",
        "category",
        "retriable",
        "origin",
        "message"
      ],
      "type": "object"
    }
  },
  "$id": "urn:pk:inv21:local_chain_response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
