    },
    "ok": {
      "type": "boolean"
    },
    "result": {},
    "route": {
      "enum": [
        "local",
        "remote",
        "refused"
      ]
    },
    "schema": {
      "const": "PK_LOCAL_CHAIN/1"
    },
    "trace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "ok",
    "route"
  ],
  "title": "PK_LOCAL_CHAIN/1#response",
  "type": "object",
  "x-version": "PK_LOCAL_CHAIN/1#response"
