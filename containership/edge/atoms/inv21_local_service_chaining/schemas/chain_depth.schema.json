{
  "$id": "urn:pk:inv21:chain_depth",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "depth": {
      "maximum": 64,
      "minimum": 0,
      "type": "integer"
    },
    "max_depth": {
      "maximum": 64,
      "minimum": 1,
      "type": "integer"
    },
    "path": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$",
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "schema": {
      "const": "PK_CHAIN_DEPTH/1"
    }
  },
  "required": [
    "schema",
    "depth",
    "max_depth",
    "path"
  ],
  "title": "PK_CHAIN_DEPTH/1",
  "type": "object",
  "x-version": "PK_CHAIN_DEPTH/1"
}