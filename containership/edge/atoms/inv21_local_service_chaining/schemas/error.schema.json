        },
        {
          "type": "null"
        }
      ]
    },
    "details": {
      "type": "object"
    },
    "message": {
      "maxLength": 256,
      "type": "string"
    },
    "origin": {
      "enum": [
        "chain",
        "handler",
        "policy",
        "transport"
      ]
    },
    "retriable": {
      "type": "boolean"
    },
    "schema": {
      "const": "PK_CHAIN_ERROR/1"
    }
