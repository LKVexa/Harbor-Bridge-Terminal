  "properties": {
    "category": {
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "isolation",
        "residency",
        "bounds",
        "overload",
        "deadline",
        "cancelled",
        "handler",
        "provider",
        "transport",
        "protocol",
        "lifecycle",
        "internal"
      ]
    },
    "code": {
      "maxLength": 64,
      "pattern": "^PK_CHAIN_[A-Z_]+$",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 128,
