{
  "$id": "urn:pk:inv21:chain_config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "breaker_failure_threshold": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "breaker_reset_s": {
      "maximum": 600,
      "minimum": 0.01,
      "type": "number"
    },
    "handler_stall_s": {
      "maximum": 600,
      "minimum": 0.001,
      "type": "number"
    },
    "max_depth": {
      "maximum": 64,
      "minimum": 1,
      "type": "integer"
    },
    "max_in_flight": {
      "maximum": 1000000,
      "minimum": 1,
      "type": "integer"
    },
    "max_in_flight_per_tenant": {
      "maximum": 1000000,
      "minimum": 1,
      "type": "integer"
    },
    "max_telemetry_events": {
      "maximum": 1000000,
      "minimum": 1,
      "type": "integer"
    },
    "mode": {
      "enum": [
        "development",
        "production"
      ]
    },
    "overrides": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "object"
        },
        "site": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "policy_cache_ttl_s": {
      "maximum": 300,
      "minimum": 0,
      "type": "number"
    },
    "policy_timeout_s": {
      "maximum": 30,
      "minimum": 0.001,
      "type": "number"
    },
    "remote_timeout_s": {
      "maximum": 600,
      "minimum": 0.001,
      "type": "number"
    },
    "require_remote_transport": {
      "type": "boolean"
    },
    "residency_lease_s": {
      "anyOf": [
        {
          "maximum": 3600,
          "minimum": 0.001,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_max_attempts": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "schema": {
      "const": "PK_CHAIN_CONFIG/1"
    },
    "telemetry_sample_rate": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "tenant_rate": {
      "anyOf": [
        {
          "maximum": 1000000.0,
          "minimum": 0.001,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema"
  ],
  "title": "PK_CHAIN_CONFIG/1",
  "type": "object",
  "x-version": "PK_CHAIN_CONFIG/1"
}