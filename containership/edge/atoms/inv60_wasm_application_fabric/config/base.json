{
 "auth.allow_anonymous": false,
 "auth.max_clock_skew_s": 30.0,
 "auth.token_ttl_s": 300.0,
 "features.batching": false,
 "limits.burst_per_tenant": 100,
 "limits.max_artifact_bytes": 33554432,
 "limits.max_components_per_tenant": 256,
 "limits.max_decisions_retained": 10000,
 "limits.max_hosts": 512,
 "limits.max_inflight_global": 1024,
 "limits.max_inflight_per_tenant": 64,
 "limits.max_links_per_component": 16,
 "limits.max_payload_bytes": 1048576,
 "limits.max_registry_entries": 4096,
 "limits.rate_per_tenant": 500.0,
 "membership.isolated_serving_s": 300.0,
 "membership.lost_after_s": 8.0,
 "membership.suspect_after_s": 3.0,
 "placement.allowed_regions": [
  "eu-west",
  "eu-central",
  "us-east"
 ],
 "resilience.breaker_threshold": 5,
 "resilience.default_deadline_s": 5.0,
 "resilience.max_attempts": 4,
 "secrets.nats_credentials": {
  "ref": "secret://vault/inv60/nats-creds#v1"
 },
 "signing.min_slsa_level": 2,
 "signing.require_signature": true,
 "storage.state_dir": "./state",
 "telemetry.export_endpoint": "",
 "telemetry.retention_days": 30,
 "telemetry.trace_sample_ratio": 0.1,
 "transport.nats_url": "tls://127.0.0.1:4222",
 "transport.require_tls": true
}