{
  "$id": "inv60/result/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "category": {
      "type": "string"
    },
    "code": {
      "pattern": "^[A-Z_]{2,32}$",
      "type": "string"
    },
    "detail": {
      "type": "object"
    },
    "message": {
      "maxLength": 512,
      "type": "string"
    },
    "number": {
      "maximum": 999,
      "minimum": 0,
      "type": "integer"
    },
    "operation_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "ok",
        "accepted",
        "partial",
        "degraded",
        "retryable",
        "permanent",
        "conflict",
        "unauthorized",
        "unavailable",
        "limit",
        "integrity",
        "invalid"
      ],
      "type": "string"
    },
    "per_target": {
      "maxItems": 1024,
      "type": "array"
    },
    "retry": {
      "enum": [
        "never",
        "safe",
        "after",
        "unknown"
      ],
      "type": "string"
    },
    "retry_after_s": {
      "minimum": 0,
      "type": "number"
    },
    "schema": {
      "enum": [
        "inv60.result/1"
      ],
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    }
  },
  "required": [
    "schema",
    "code",
    "number",
    "category",
    "outcome",
    "retry",
    "operation_id",
    "timestamp"
  ],
  "type": "object"
}