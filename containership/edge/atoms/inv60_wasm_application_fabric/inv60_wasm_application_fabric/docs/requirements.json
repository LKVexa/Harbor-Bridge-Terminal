{
 "schema": "inv60.requirements/1",
 "version": "1.0.0",
 "terminology": "RFC 2119 / RFC 8174",
 "deployment_classes": [
  "central",
  "edge",
  "partially-connected",
  "disconnected"
 ],
 "planes": {
  "control": "membership, placement, lifecycle, links, config \u2014 may depend on identity/policy/quorum",
  "data": "call routing \u2014 may continue in isolated_serving without the control plane"
 },
 "requirements": [
  {
   "id": "REQ-MEM-01",
   "level": "SHALL",
   "kind": "functional",
   "text": "Membership SHALL admit only authenticated, attested hosts that enrol themselves.",
   "verification": [
    "test_security.Adversarial.test_T10_host_cannot_enrol_other_host"
   ],
   "method": "automated test",
   "owner": "UNASSIGNED",
   "criticality": "release-blocking",
   "applies_to": [
    "central",
    "edge"
   ]
  },
  {
   "id": "REQ-MEM-02",
   "level": "SHALL",
   "kind": "functional",
   "text": "A host silent for lost_after_s SHALL be declared lost and its components rescheduled only by the quorum lease holder.",
   "verification": [
    "test_resilience.Membership.test_failover_without_quorum_refused"
   ],
   "method": "automated test",
   "owner": "UNASSIGNED",
   "criticality": "release-blocking",
   "applies_to": [
    "central",
    "edge"
   ]
  },
  {
   "id": "REQ-ART-01",
   "level": "SHALL",
   "kind": "functional",
   "text": "The fabric SHALL instantiate only bytes whose sha256 equals the reference.",
   "verification": [
    "test_security.ArtifactSigning.test_registry_swap_after_verification_detected"
   ],
   "method": "automated test",
   "owner": "UNASSIGNED",
   "criticality": "release-blocking",
   "applies_to": [
    "central",
    "edge"
   ]
  },
  {
   "id": "REQ-ART-02",
   "level": "SHALL",
   "kind": "security",
   "text": "Artifacts SHALL carry a valid signature from a trusted, unrevoked signer with provenance level >= policy minimum.",
   "verification": [
    "test_security.ArtifactSigning.test_low_provenance_level"
   ],
   "method": "automated test",
   "owner": "UNASSIGNED",
   "criticality": "release-blocking",
   "applies_to": [
    "central",
    "edge"
   ]
  },
  {
   "id": "REQ-LIFE-01",
   "level": "SHALL",
   "kind": "functional",
