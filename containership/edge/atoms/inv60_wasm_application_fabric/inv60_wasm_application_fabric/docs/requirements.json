   "method": "automated test",
   "owner": "UNASSIGNED",
   "criticality": "release-blocking",
   "applies_to": [
    "central",
    "edge"
   ]
  },
  {
   "id": "REQ-LINK-01",
   "level": "SHALL",
   "kind": "security",
