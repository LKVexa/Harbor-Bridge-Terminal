{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_DATA_MOVE_HANDOFF:1",
  "title": "PK_DATA_MOVE_HANDOFF/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "decision_id",
    "tenant_id",
    "dataset",
    "kind",
    "shards",
    "from",
    "to",
    "size_gb",
    "obligations",
    "provenance_digest",
    "not_after"
  ],
  "properties": {
    "schema": {
      "const": "PK_DATA_MOVE_HANDOFF/1"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^ho-[0-9a-f]{32}$"
    },
    "decision_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "kind": {
      "enum": [
        "move-data",
        "move-data-partial",
        "replicate"
      ]
    },
    "shards": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
      }
    },
    "from": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "size_gb": {
      "type": "number",
      "minimum": 0
    },
    "obligations": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance_digest": {
      "type": "string"
    },
    "not_after": {
      "type": "number",
      "minimum": 0
    }
  }
}
