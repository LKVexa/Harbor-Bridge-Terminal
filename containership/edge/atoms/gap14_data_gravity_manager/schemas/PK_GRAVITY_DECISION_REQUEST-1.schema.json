{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_GRAVITY_DECISION_REQUEST:1",
  "title": "PK_GRAVITY_DECISION_REQUEST/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "workload",
    "dataset",
    "compute_site"
  ],
  "properties": {
    "schema": {
      "const": "PK_GRAVITY_DECISION_REQUEST/1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "workload_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "environment": {
          "enum": [
            "production",
            "staging",
            "development",
            "test"
          ]
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tenant_id",
        "site",
        "size_gb",
        "classification"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "size_gb": {
          "type": "number",
          "minimum": 0
        },
        "classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        }
      }
    },
    "compute_site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "cpu": {
          "type": "number",
          "minimum": 0
        },
        "gpu": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "runs": {
          "type": "number",
          "minimum": 0
        },
        "compute_warmup_cost": {
          "type": "number",
          "minimum": 0
        },
        "cache_reuse_fraction": {
          "type": "number",
          "minimum": 0
        },
        "read_gb_per_run": {
          "type": "number",
          "minimum": 0
        },
        "write_gb_per_run": {
          "type": "number",
          "minimum": 0
        },
        "iops_per_run": {
          "type": "number",
          "minimum": 0
        },
        "compute_kwh_per_run": {
          "type": "number",
          "minimum": 0
        },
        "compute_kw": {
          "type": "number",
          "minimum": 0
        },
        "replica_months": {
          "type": "number",
          "minimum": 0
        },
        "replica_sync_gb_per_run": {
          "type": "number",
          "minimum": 0
        },
        "time_value_per_hour": {
          "type": "number",
          "minimum": 0
        },
        "carbon_price_per_kg": {
          "type": "number",
          "minimum": 0
        },
        "shards": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "size_gb",
              "needed"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
              },
              "size_gb": {
                "type": "number",
                "minimum": 0
              },
              "needed": {
                "type": "boolean"
              },
              "converged": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
