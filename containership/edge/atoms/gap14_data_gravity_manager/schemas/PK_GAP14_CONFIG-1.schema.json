{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_GAP14_CONFIG:1",
  "title": "PK_GAP14_CONFIG/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "mode"
  ],
  "properties": {
    "schema": {
      "const": "PK_GAP14_CONFIG/1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "production",
        "staging",
        "development",
        "test"
      ]
    },
    "knobs": {
      "type": "object"
    },
    "ttls": {
      "type": "object"
    },
    "site_jurisdictions": {
      "type": "object"
    },
    "dev_flags": {
      "type": "object"
    },
    "site_economics": {
      "type": "object"
    },
    "shadow_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "compute_relocation_cost"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "compute_relocation_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "canary_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}
