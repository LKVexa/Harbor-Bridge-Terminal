{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_POLICY_VERDICT:1",
  "title": "PK_POLICY_VERDICT/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "request_hash",
    "allow",
    "policy_version",
    "rule_ids",
    "obligations",
    "issued_at",
    "ttl_s"
  ],
  "properties": {
    "schema": {
      "const": "PK_POLICY_VERDICT/1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "allow": {
      "type": "boolean"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 0
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
      }
    },
    "obligations": {
      "type": "object",
      "additionalProperties": true
    },
    "issued_at": {
      "type": "number",
      "minimum": 0
    },
    "ttl_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    }
  }
}
