{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_CONVERGENCE_PROOF:1",
  "title": "PK_CONVERGENCE_PROOF/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenant_id",
    "dataset",
    "dataset_version",
    "converged",
    "open_conflicts",
    "watermark",
    "issued_at"
  ],
  "properties": {
    "schema": {
      "const": "PK_CONVERGENCE_PROOF/1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "dataset_version": {
      "type": "integer",
      "minimum": 0
    },
    "converged": {
      "type": "boolean"
    },
    "open_conflicts": {
      "type": "integer",
      "minimum": 0
    },
    "watermark": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "issued_at": {
      "type": "number",
      "minimum": 0
    }
  }
}
