{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_PLACEMENT_SNAPSHOT:1",
  "title": "PK_PLACEMENT_SNAPSHOT/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "version",
    "tenant_id",
    "issued_at",
    "sites"
  ],
  "properties": {
    "schema": {
      "const": "PK_PLACEMENT_SNAPSHOT/1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "issued_at": {
      "type": "number",
      "minimum": 0
    },
    "sites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "available",
          "architectures",
          "runtimes",
          "free_cpu",
          "free_gpu",
          "quota_remaining_gb",
          "storage_free_gb"
        ],
        "properties": {
          "available": {
            "type": "boolean"
          },
          "architectures": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            }
          },
          "runtimes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
            }
          },
          "free_cpu": {
            "type": "number",
            "minimum": 0
          },
          "free_gpu": {
            "type": "number",
            "minimum": 0
          },
          "quota_remaining_gb": {
            "type": "number",
            "minimum": 0
          },
          "storage_free_gb": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
