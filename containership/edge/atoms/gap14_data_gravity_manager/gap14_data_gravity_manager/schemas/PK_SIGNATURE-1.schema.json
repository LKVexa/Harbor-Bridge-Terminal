{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_SIGNATURE:1",
  "title": "PK_SIGNATURE/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "kid",
    "iss",
    "mac"
  ],
  "properties": {
    "alg": {
      "const": "HS256"
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "mac": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
