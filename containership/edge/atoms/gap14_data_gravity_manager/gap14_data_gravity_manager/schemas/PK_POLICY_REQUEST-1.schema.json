{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_POLICY_REQUEST:1",
  "title": "PK_POLICY_REQUEST/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenant_id",
    "workload_id",
    "dataset",
    "classification",
    "source_site",
    "destination_site",
    "operation",
    "jurisdiction_tags",
    "evaluated_at"
  ],
  "properties": {
    "schema": {
      "const": "PK_POLICY_REQUEST/1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "workload_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "classification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "source_site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "destination_site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "operation": {
      "enum": [
        "hold",
        "process"
      ]
    },
    "jurisdiction_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
      }
    },
    "evaluated_at": {
      "type": "number",
      "minimum": 0
    }
  }
}
