{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:schema:PK_GRAVITY_SIMULATION:1",
  "title": "PK_GRAVITY_SIMULATION/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executable",
    "simulation_id",
    "notice",
    "result",
    "scenario_digest",
    "actor"
  ],
  "properties": {
    "schema": {
      "const": "PK_GRAVITY_SIMULATION/1"
    },
    "executable": {
      "const": false
    },
    "simulation_id": {
      "type": "string",
      "pattern": "^sim-[0-9a-f]{32}$"
    },
    "notice": {
      "type": "string"
    },
    "result": {
      "type": "object"
    },
    "scenario_digest": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    }
  }
}
