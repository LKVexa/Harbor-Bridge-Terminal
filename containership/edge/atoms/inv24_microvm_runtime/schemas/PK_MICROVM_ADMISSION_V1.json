{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PK_MICROVM_ADMISSION/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_key",
    "tenant",
    "workload",
    "environment",
    "site",
    "vcpus",
    "memory_mib",
    "devices",
    "capability_token",
    "deadline_ms"
  ],
  "properties": {
    "schema": {
      "const": "PK_MICROVM_ADMISSION/1"
    },
    "operation_key": {
      "type": "string",
      "pattern": "[A-Za-z0-9._:-]{8,128}"
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[^\\x00-\\x1f]+"
    },
    "workload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[^\\x00-\\x1f]+"
    },
    "environment": {
      "enum": [
        "cloud",
        "datacenter",
        "near-edge",
        "far-edge"
      ]
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[^\\x00-\\x1f]+"
    },
    "vcpus": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "memory_mib": {
      "type": "integer",
      "minimum": 32,
      "maximum": 131072
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "virtio-net",
          "virtio-block",
          "virtio-vsock",
          "serial",
          "rtc"
        ]
      },
      "uniqueItems": true,
      "maxItems": 5
    },
    "capability_token": {
      "type": "string",
      "maxLength": 4096
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "policy_context": {
      "type": "object"
    }
  }
}
