{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:post-kubernetes:PK_DESCRIPTOR_DELEGATION:1",
  "title": "PK_DESCRIPTOR_DELEGATION/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "txn_id", "mode", "type", "src_fp", "src_number", "dst_fp", "dst_number", "ts"],
  "properties": {
    "schema": {"const": "PK_DESCRIPTOR_DELEGATION/1"},
    "txn_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$"},
    "mode": {"enum": ["move", "share"]},
    "type": {"type": "string", "maxLength": 128},
    "src_fp": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "src_number": {"type": "integer", "minimum": 3},
    "dst_fp": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "dst_number": {"type": "integer", "minimum": 3},
    "ts": {"type": "number"}
  }
}
