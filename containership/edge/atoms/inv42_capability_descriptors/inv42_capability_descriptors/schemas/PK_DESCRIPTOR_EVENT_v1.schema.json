{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:post-kubernetes:PK_DESCRIPTOR_EVENT:1",
  "title": "PK_DESCRIPTOR_EVENT/1 (redacted observer event)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "op", "table_fp", "outcome", "number", "type", "duration_ns", "ts"],
  "properties": {
    "schema": {"const": "PK_DESCRIPTOR_EVENT/1"},
    "op": {"enum": ["open", "import", "resolve", "close", "destroy", "delegate_move", "delegate_share"]},
    "table_fp": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "outcome": {"type": "string", "maxLength": 64},
    "number": {"type": ["integer", "null"], "minimum": 3},
    "type": {"type": ["string", "null"], "maxLength": 128},
    "duration_ns": {"type": "integer", "minimum": 0},
    "ts": {"type": "number"},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "detail": {"type": "string", "maxLength": 256}
  }
}
