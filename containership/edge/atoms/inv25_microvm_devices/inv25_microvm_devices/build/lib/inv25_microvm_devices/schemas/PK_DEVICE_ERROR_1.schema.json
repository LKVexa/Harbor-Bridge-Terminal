{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_DEVICE_ERROR/1",
  "title": "PK Device Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code", "category", "message", "retryable", "operation"],
  "properties": {
    "schema": {"const": "PK_DEVICE_ERROR/1"},
    "code": {"type": "string", "pattern": "^INV25_[A-Z_]+$"},
    "category": {"enum": ["validation", "policy", "conflict", "security", "compatibility", "capacity", "dependency", "internal"]},
    "message": {"type": "string", "maxLength": 256},
    "retryable": {"type": "boolean"},
    "operation": {"type": "string", "maxLength": 128},
    "device": {"type": "string", "maxLength": 64},
    "environment": {"type": "string", "maxLength": 128},
    "correlation_id": {"type": "string", "maxLength": 128},
    "details": {"type": "object"}
  }
}
