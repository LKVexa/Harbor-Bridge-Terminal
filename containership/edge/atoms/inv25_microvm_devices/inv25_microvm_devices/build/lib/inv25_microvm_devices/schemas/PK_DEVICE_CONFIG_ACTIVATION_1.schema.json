{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_DEVICE_CONFIG_ACTIVATION/1",
  "title": "PK Device Configuration Activation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "activation_id", "kind", "candidate", "digest", "catalogue_schema", "environment", "proposer", "approvers", "activated_by", "timestamp", "previous_digest", "rollback_target", "source_revision", "build_id", "policy_decision", "surface_diff", "correlation_id", "reason"],
  "properties": {
    "schema": {"const": "PK_DEVICE_CONFIG_ACTIVATION/1"},
    "activation_id": {"type": "string"},
    "kind": {"enum": ["activate", "rollback"]},
    "candidate": {"type": ["string", "null"]},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "catalogue_schema": {"const": "PK_DEVICE_CATALOGUE/1"},
    "environment": {"type": "string"},
    "proposer": {"type": "string"},
    "approvers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "activated_by": {"type": "string"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
    "previous_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rollback_target": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_revision": {"type": "string"},
    "build_id": {"type": "string"},
    "policy_decision": {"type": "object", "required": ["capability", "reason", "policy_revision"]},
    "surface_diff": {"type": ["object", "null"]},
    "correlation_id": {"type": "string"},
    "reason": {"type": "string"}
  }
}
