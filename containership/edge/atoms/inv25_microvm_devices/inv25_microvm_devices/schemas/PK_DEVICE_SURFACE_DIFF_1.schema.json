{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_DEVICE_SURFACE_DIFF/1",
  "title": "PK Device Surface Diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "device", "from", "to", "added", "removed", "widened", "surface"],
  "properties": {
    "schema": {"const": "PK_DEVICE_SURFACE_DIFF/1"},
    "device": {"type": "string"},
    "from": {"type": "string"},
    "to": {"type": "string"},
    "added": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "removed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "widened": {"type": "boolean"},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"type": "integer", "minimum": 0},
        "after": {"type": "integer", "minimum": 0}
      }
    }
  }
}
