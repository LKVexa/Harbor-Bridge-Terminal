{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "INV25_EVIDENCE_RECORD/1",
  "title": "INV-25 standalone evidence record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "element", "check_id", "status", "reason", "evidence", "evaluator", "tool_version", "timestamp", "source_tree", "build_id", "clean_environment", "prev", "digest"],
  "properties": {
    "schema": {"const": "INV25_EVIDENCE_RECORD/1"},
    "element": {"const": "INV-25"},
    "check_id": {"type": "string", "pattern": "^INV-25-C[0-9]{3}$"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE", "EXTERNAL"]},
    "reason": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"]}},
    "evaluator": {"type": "string"},
    "tool_version": {"type": "string"},
    "timestamp": {"type": "string"},
    "source_tree": {"type": "string"},
    "build_id": {"type": "string"},
    "clean_environment": {"type": "boolean"},
    "prev": {"type": "string"},
    "digest": {"type": "string"}
  }
}
