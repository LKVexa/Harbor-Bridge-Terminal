{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "PK_VALIDATION_ATTESTATION/1 (signed payload)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "module_digest",
  "profile",
  "bundle_revision",
  "epoch",
  "host_contract_revision",
  "engine",
  "validator",
  "limits_revision",
  "verdict",
  "features",
  "deterministic",
  "issued_at",
  "expires_at",
  "nonce",
  "key_id"
 ],
 "properties": {
  "schema": {
   "const": "PK_VALIDATION_ATTESTATION/1"
  },
  "module_digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "verdict": {
   "const": "accept"
  },
  "features": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "issued_at": {
   "type": "integer"
  },
  "expires_at": {
   "type": "integer"
  },
  "nonce": {
   "type": "string",
   "pattern": "^[0-9a-f]{24}$"
  },
  "profile": {
   "type": "string",
   "maxLength": 256
  },
  "bundle_revision": {
   "type": "string",
   "maxLength": 256
  },
  "host_contract_revision": {
   "type": "string",
   "maxLength": 256
  },
  "engine": {
   "type": "string",
   "maxLength": 256
  },
  "validator": {
   "type": "string",
   "maxLength": 256
  },
  "limits_revision": {
   "type": "string",
   "maxLength": 256
  },
  "key_id": {
   "type": "string",
   "maxLength": 256
  },
  "epoch": {
   "type": "integer",
   "minimum": 0
  },
  "deterministic": {
   "type": "boolean"
  }
 }
}