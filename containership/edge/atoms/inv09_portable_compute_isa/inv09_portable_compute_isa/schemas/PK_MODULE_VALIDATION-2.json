{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "PK_MODULE_VALIDATION/2",
 "type": "object",
 "required": [
  "schema",
  "module_digest",
  "profile",
  "engine",
  "bundle_revision",
  "epoch",
  "validator",
  "outcome",
  "valid",
  "trace_id",
  "span_id"
 ],
 "properties": {
  "schema": {
   "const": "PK_MODULE_VALIDATION/2"
  },
  "module_digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "profile": {
   "type": "string"
  },
  "engine": {
   "type": "string"
  },
  "bundle_revision": {
   "type": "string"
  },
  "epoch": {
   "type": "integer"
  },
  "validator": {
   "type": "string"
  },
  "outcome": {
   "enum": [
    "accept",
    "reject",
    "refuse",
    "error"
   ]
  },
  "valid": {
   "type": "boolean"
  },
  "used": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "declared_unused": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "deterministic": {
   "type": "boolean"
  },
  "uses_float": {
   "type": "boolean"
  },
  "import_classes": {
   "type": "array"
  },
  "feature_evidence": {
   "type": "array"
  },
  "attestation": {
   "type": "string"
  },
  "failure": {
   "$ref": "PK_VALIDATION_FAILURE-1.json"
  },
  "trace_id": {
   "type": "string",
   "pattern": "^[0-9a-f]{32}$"
  },
  "span_id": {
   "type": "string",
   "pattern": "^[0-9a-f]{16}$"
  }
 }
}