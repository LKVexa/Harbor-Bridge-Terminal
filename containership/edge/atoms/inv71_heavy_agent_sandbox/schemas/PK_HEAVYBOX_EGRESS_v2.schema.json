{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:heavybox:egress:2",
  "title": "PK_HEAVYBOX_EGRESS/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sid",
    "requested",
    "canonical",
    "resolved",
    "selected",
    "policy_version",
    "decision",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "PK_HEAVYBOX_EGRESS/2"
    },
    "sid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "requested": {
      "type": "string",
      "maxLength": 253
    },
    "canonical": {
      "type": "string",
      "maxLength": 253
    },
    "resolved": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 45
      }
    },
    "selected": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 45
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "decision": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
