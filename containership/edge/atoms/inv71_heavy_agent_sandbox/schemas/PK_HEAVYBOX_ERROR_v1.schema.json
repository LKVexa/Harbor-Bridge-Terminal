{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:heavybox:error:1",
  "title": "PK_HEAVYBOX_ERROR/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "code",
    "namespace",
    "outcome",
    "retryable",
    "retry_class",
    "http_status",
    "grpc_status",
    "message",
    "correlation_id",
    "operation_id",
    "session_id",
    "config_digest"
  ],
  "properties": {
    "schema": {
      "const": "PK_HEAVYBOX_ERROR/1"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z]+\\.[A-Z_]+$"
    },
    "namespace": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "DEGRADED",
        "RETRYABLE_FAILURE",
        "TERMINAL_FAILURE",
        "SECURITY_REJECTED"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_class": {
      "enum": [
        "never",
        "idempotent",
        "with_compensation"
      ]
    },
    "http_status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "grpc_status": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "maxLength": 256
    },
    "correlation_id": {
      "type": "string",
      "maxLength": 128
    },
    "operation_id": {
      "type": "string",
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "maxLength": 128
    },
    "config_digest": {
      "type": "string",
      "maxLength": 64
    }
  }
}
