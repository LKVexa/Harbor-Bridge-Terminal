{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:heavybox:teardown:1",
  "title": "PK_HEAVYBOX_TEARDOWN/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sid", "verified", "state", "base_digest", "audit_head", "audit_chain_valid"],
  "properties": {
    "sid": {"type": "string", "minLength": 1, "maxLength": 128},
    "verified": {"type": "boolean"},
    "state": {"const": "closed"},
    "base_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "audit_head": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "audit_chain_valid": {"type": "boolean"}
  }
}
