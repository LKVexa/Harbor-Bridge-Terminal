{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:heavybox:session:1",
  "title": "PK_HEAVYBOX_SESSION/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sid", "state", "base_digest", "disk_quota_bytes", "file_quota"],
  "properties": {
    "sid": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "state": {"type": "string", "enum": ["active", "closed"]},
    "base_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "disk_quota_bytes": {"type": "integer", "minimum": 1},
    "file_quota": {"type": "integer", "minimum": 1}
  }
}
