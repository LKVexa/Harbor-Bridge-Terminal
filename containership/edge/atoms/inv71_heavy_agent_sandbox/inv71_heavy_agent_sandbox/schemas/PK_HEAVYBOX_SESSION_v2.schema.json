{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:heavybox:session:2",
  "title": "PK_HEAVYBOX_SESSION/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sid",
    "state",
    "epoch",
    "base_digest",
    "config_digest",
    "release"
  ],
  "properties": {
    "schema": {
      "const": "PK_HEAVYBOX_SESSION/2"
    },
    "sid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "state": {
      "enum": [
        "REQUESTED",
        "VALIDATING",
        "ALLOCATING",
        "STARTING",
        "READY",
        "RUNNING",
        "DRAINING",
        "STOPPING",
        "VERIFYING_TEARDOWN",
        "CLOSED",
        "FAILED",
        "FROZEN",
        "QUARANTINED",
        "REAPING"
      ]
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "base_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release": {
      "type": "string",
      "maxLength": 256
    }
  }
}
