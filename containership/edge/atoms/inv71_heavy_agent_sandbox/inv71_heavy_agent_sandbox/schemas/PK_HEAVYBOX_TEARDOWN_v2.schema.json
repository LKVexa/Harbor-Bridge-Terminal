{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:heavybox:teardown:2",
  "title": "PK_HEAVYBOX_TEARDOWN/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sid",
    "verified",
    "state",
    "base_digest",
    "audit_head",
    "leaked",
    "config_digest"
  ],
  "properties": {
    "schema": {
      "const": "PK_HEAVYBOX_TEARDOWN/2"
    },
    "sid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "verified": {
      "const": true
    },
    "state": {
      "const": "CLOSED"
    },
    "base_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audit_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "leaked": {
      "type": "array",
      "maxItems": 0
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
