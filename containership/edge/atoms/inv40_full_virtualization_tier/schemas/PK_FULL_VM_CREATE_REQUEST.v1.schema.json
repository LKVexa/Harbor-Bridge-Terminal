{
 "$id": "PK_FULL_VM/1#create-request",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "deadline_ms": {
   "maximum": 600000,
   "minimum": 1,
   "type": "integer"
  },
  "extra_devices": {
   "items": {
    "maxLength": 255,
    "minLength": 1,
    "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*",
    "type": "string"
   },
   "maxItems": 16,
   "type": "array",
   "uniqueItems": true
  },
  "idempotency_key": {
   "maxLength": 255,
   "minLength": 1,
   "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*",
   "type": "string"
  },
  "image_digest": {
   "pattern": "sha256:[0-9a-f]{64}",
   "type": "string"
  },
  "memory_mib": {
   "maximum": 1048576,
   "minimum": 64,
   "type": "integer"
  },
  "name": {
   "maxLength": 255,
   "minLength": 1,
   "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*",
   "type": "string"
  },
  "schema": {
   "const": "PK_FULL_VM/1"
  },
  "tenant": {
   "maxLength": 255,
   "minLength": 1,
   "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*",
   "type": "string"
  },
  "trace_parent": {
   "pattern": "00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}",
   "type": "string"
  },
  "vcpus": {
   "maximum": 256,
   "minimum": 1,
   "type": "integer"
  }
 },
 "required": [
  "schema",
  "name",
  "tenant",
  "memory_mib",
  "image_digest",
  "idempotency_key"
 ],
 "type": "object"
}
