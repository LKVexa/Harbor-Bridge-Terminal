{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "properties": {
  "destroyed": {
   "type": "boolean"
  },
  "guest": {
   "maxLength": 255,
   "minLength": 1,
   "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*",
   "type": "string"
  },
  "idempotent": {
   "type": "boolean"
  },
  "schema": {
   "const": "PK_FULL_VM_STATE/1"
  },
  "state": {
   "enum": [
    "created",
    "running",
    "stopped",
    "destroyed"
   ]
  }
 },
 "required": [
  "schema",
  "guest",
  "state",
  "destroyed"
 ],
 "type": "object"
}
