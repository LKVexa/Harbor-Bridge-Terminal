{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "properties": {
  "boot_ms": {
   "minimum": 0,
   "type": "integer"
  },
  "budget_ms": {
   "minimum": 1,
   "type": "integer"
  },
  "cost_note": {
   "type": "string"
  },
  "device_instances": {
   "type": "integer"
  },
  "devices": {
   "minimum": 1,
   "type": "integer"
  },
  "guest": {
   "maxLength": 255,
   "minLength": 1,
   "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*",
   "type": "string"
  },
  "guest_os_opaque": {
   "const": true
  },
  "resident_mib": {
   "minimum": 0,
   "type": "integer"
  },
  "schema": {
   "const": "PK_FULL_VM_BOOT/1"
  },
  "state": {
   "enum": [
    "running"
   ]
  },
  "status": {
   "enum": [
    "ok",
    "degraded"
   ]
  },
  "tenant": {
   "maxLength": 255,
   "minLength": 1,
   "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*",
   "type": "string"
  },
  "within_budget": {
   "type": "boolean"
  }
 },
 "required": [
  "schema",
  "guest",
  "tenant",
  "state",
  "boot_ms",
  "budget_ms",
  "within_budget",
  "status",
  "resident_mib",
  "devices",
  "guest_os_opaque"
 ],
 "type": "object"
}
