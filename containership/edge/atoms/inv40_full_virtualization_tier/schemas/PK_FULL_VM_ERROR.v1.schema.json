{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "properties": {
  "class": {
   "enum": [
    "retryable",
    "terminal",
    "rejected"
   ]
  },
  "code": {
   "pattern": "PK_FULL_VM_[A-Z_]+",
   "type": "string"
  },
  "details": {
   "type": "object"
  },
  "message": {
   "maxLength": 4096,
   "type": "string"
  },
  "retryable": {
   "type": "boolean"
  },
  "schema": {
   "const": "PK_FULL_VM_ERROR/1"
  },
  "status": {
   "type": "integer"
  }
 },
 "required": [
  "schema",
  "code",
  "message"
 ],
 "type": "object"
}
