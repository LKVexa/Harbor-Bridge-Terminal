{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "allow_gpu_passthrough": {
   "type": "boolean"
  },
  "allow_live_migration": {
   "type": "boolean"
  },
  "allow_nested_virtualization": {
   "type": "boolean"
  },
  "allow_software_emulation": {
   "const": false
  },
  "approved_image_digests": {
   "items": {
    "pattern": "sha256:[0-9a-f]{64}",
    "type": "string"
   },
   "maxItems": 4096,
   "type": "array"
  },
  "boot_budget_ms": {
   "maximum": 120000,
   "minimum": 1000,
   "type": "integer"
  },
  "breaker_failure_threshold": {
   "maximum": 1000,
   "minimum": 1,
   "type": "integer"
  },
  "breaker_reset_ms": {
   "minimum": 100,
   "type": "integer"
  },
  "config_version": {
   "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+",
   "type": "string"
  },
  "environment": {
   "enum": [
    "dev",
    "test",
    "staging",
    "prod"
   ]
  },
  "footprint_ceiling_mib": {
   "maximum": 1048576,
   "minimum": 128,
   "type": "integer"
  },
  "log_retention_days": {
   "maximum": 3650,
   "minimum": 1,
   "type": "integer"
  },
  "max_concurrent_ops": {
   "maximum": 4096,
   "minimum": 1,
   "type": "integer"
  },
  "max_queue": {
   "maximum": 65536,
   "minimum": 0,
   "type": "integer"
  },
  "offline_mode": {
   "enum": [
    "fail_closed",
    "serve_cached_readonly"
   ]
  },
  "op_timeout_ms": {
   "maximum": 600000,
   "minimum": 100,
   "type": "integer"
  },
  "qemu_binary": {
   "maxLength": 4096,
   "type": "string"
  },
  "require_hardware_primitive": {
   "const": true
  },
  "retry_max_attempts": {
   "maximum": 10,
   "minimum": 1,
   "type": "integer"
  },
  "schema": {
   "const": "PK_FULL_VM_CONFIG/1"
  },
  "site": {
   "maxLength": 255,
   "minLength": 1,
   "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]*",
   "type": "string"
  },
  "telemetry_export": {
   "enum": [
    "none",
    "stdout",
    "otlp"
   ]
  },
  "tenant_guest_quota": {
   "maximum": 100000,
   "minimum": 1,
   "type": "integer"
  },
  "tenant_memory_quota_mib": {
   "maximum": 1099511627776,
   "minimum": 64,
   "type": "integer"
  },
  "trace_sample_ratio": {
   "maximum": 1,
   "minimum": 0,
   "type": "number"
  }
 },
 "required": [
  "schema",
  "config_version"
 ],
 "type": "object"
}
