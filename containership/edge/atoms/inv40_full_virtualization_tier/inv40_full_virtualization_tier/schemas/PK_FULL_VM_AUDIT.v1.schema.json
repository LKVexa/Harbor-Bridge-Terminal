{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "properties": {
  "action": {
   "type": "string"
  },
  "actor": {
   "type": "string"
  },
  "hash": {
   "pattern": "[0-9a-f]{64}",
   "type": "string"
  },
  "outcome": {
   "enum": [
    "allow",
    "deny",
    "ok",
    "error"
   ]
  },
  "prev": {
   "pattern": "[0-9a-f]{64}",
   "type": "string"
  },
  "schema": {
   "const": "PK_FULL_VM_AUDIT/1"
  },
  "seq": {
   "minimum": 0,
   "type": "integer"
  },
  "ts": {
   "type": "string"
  }
 },
 "required": [
  "schema",
  "seq",
  "ts",
  "actor",
  "action",
  "outcome",
  "prev",
  "hash"
 ],
 "type": "object"
}
