// INV-70 guest ABI v2 (draft; ABI v1 = core-module i64 exports, see docs/WASM_RUNTIME.md)
package inv70:fastbox@2.0.0;

interface host {
  // Only capabilities granted by the caller token AND registered by the embedder are linked.
  call: func(capability: string, argument: list<u8>) -> result<list<u8>, string>;
}

world guest {
  import host;
  export run: func(input: list<u8>) -> result<list<u8>, string>;
}
