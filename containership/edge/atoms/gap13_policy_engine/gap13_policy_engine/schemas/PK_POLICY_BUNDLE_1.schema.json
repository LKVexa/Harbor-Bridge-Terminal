{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:gap13:PK_POLICY_BUNDLE/1",
  "title": "PK_POLICY_BUNDLE/1",
  "description": "Signed policy bundle payload. Canonical form: UTF-8, NFC, sorted keys, no whitespace, integers only. Parser also enforces size/count/depth limits from EngineConfig.limits and duplicate-key rejection, which JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "policy_id", "issuer", "generation", "issued_at", "environment", "version", "rules"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"},
    "attr": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}(\\.[a-z][a-z0-9_]{0,62}){0,3}$"},
    "scalar": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1024}, {"type": "integer"}, {"type": "boolean"}, {"type": "null"}]},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "effect", "scope", "match"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "effect": {"enum": ["allow", "deny"]},
        "scope": {"enum": ["estate", "tenant"]},
        "match": {
          "type": "object", "maxProperties": 32,
          "propertyNames": {"$ref": "#/$defs/attr"},
          "additionalProperties": {"oneOf": [{"$ref": "#/$defs/scalar"}, {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/scalar"}}]}
        }
      }
    }
  },
  "properties": {
    "schema": {"const": "PK_POLICY_BUNDLE/1"},
    "bundle_id": {"$ref": "#/$defs/id"},
    "policy_id": {"$ref": "#/$defs/id"},
    "issuer": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "issued_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at": {"type": "integer", "minimum": 0},
    "environment": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/id"},
    "rules": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/rule"}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^x-"}}
  }
}
