{
  "codes": {
    "TOPO.CANCELLED": {
      "description": "Caller cancelled the request",
      "http_status": 499,
      "outcome": "retryable_failure"
    },
    "TOPO.CONFLICT": {
      "description": "Expected revision does not match (compare-and-set failed)",
      "http_status": 409,
      "outcome": "terminal_failure"
    },
    "TOPO.DEADLINE_EXCEEDED": {
      "description": "Deadline elapsed before completion",
      "http_status": 504,
      "outcome": "retryable_failure"
    },
    "TOPO.DEPENDENCY_UNAVAILABLE": {
      "description": "Identity/policy/key/time dependency unavailable; failing closed",
      "http_status": 503,
      "outcome": "retryable_failure"
    },
    "TOPO.FORBIDDEN": {
      "description": "Principal lacks the capability for this operation/tenant",
      "http_status": 403,
      "outcome": "terminal_failure"
    },
    "TOPO.FROZEN": {
      "description": "Automated decisions are frozen by an operator",
      "http_status": 423,
      "outcome": "retryable_failure"
    },
    "TOPO.IDEMPOTENCY_MISMATCH": {
      "description": "Idempotency key reused with a different payload",
      "http_status": 422,
      "outcome": "terminal_failure"
    },
    "TOPO.INTERNAL": {
      "description": "Unexpected defect; details withheld from caller",
      "http_status": 500,
      "outcome": "retryable_failure"
    },
    "TOPO.INVALID_REQUEST": {
      "description": "Payload failed schema or semantic validation",
      "http_status": 400,
      "outcome": "terminal_failure"
    },
    "TOPO.INVALID_TOPOLOGY": {
      "description": "Mutation would violate a topology invariant",
      "http_status": 422,
      "outcome": "terminal_failure"
    },
    "TOPO.NOT_READY": {
      "description": "Service has no active validated configuration",
      "http_status": 503,
      "outcome": "retryable_failure"
    },
    "TOPO.NO_CAPABLE_NODE": {
      "description": "No reachable node satisfies capability and policy",
      "http_status": 404,
      "outcome": "terminal_failure"
    },
    "TOPO.NO_COORDINATOR": {
      "description": "Site has no coordinator-eligible node",
      "http_status": 404,
      "outcome": "terminal_failure"
    },
    "TOPO.OVERLOADED": {
      "description": "Bounded queue full or circuit open",
      "http_status": 503,
      "outcome": "retryable_failure"
    },
    "TOPO.PAYLOAD_TOO_LARGE": {
      "description": "Payload exceeds the interface byte/item limit",
      "http_status": 413,
      "outcome": "terminal_failure"
    },
    "TOPO.QUARANTINED": {
      "description": "Target is quarantined",
      "http_status": 423,
      "outcome": "terminal_failure"
    },
    "TOPO.QUOTA_EXCEEDED": {
      "description": "Tenant graph quota exhausted",
      "http_status": 429,
      "outcome": "terminal_failure"
    },
    "TOPO.RATE_LIMITED": {
      "description": "Admission control shed this request",
      "http_status": 429,
      "outcome": "retryable_failure"
    },
    "TOPO.REPLAYED": {
      "description": "Credential nonce was already used",
      "http_status": 401,
      "outcome": "terminal_failure"
    },
    "TOPO.STALE_LEADER": {
      "description": "Fencing token is older than the current term",
      "http_status": 409,
      "outcome": "terminal_failure"
    },
    "TOPO.UNAUTHENTICATED": {
      "description": "Credential missing, malformed, expired or not trusted",
      "http_status": 401,
      "outcome": "terminal_failure"
    },
    "TOPO.UNKNOWN_NODE": {
      "description": "Referenced node does not exist in the tenant graph",
      "http_status": 404,
      "outcome": "terminal_failure"
    },
    "TOPO.UNKNOWN_SITE": {
      "description": "Referenced site has no members",
      "http_status": 404,
      "outcome": "terminal_failure"
    },
    "TOPO.UNSUPPORTED_VERSION": {
      "description": "No mutually supported protocol version",
      "http_status": 426,
      "outcome": "terminal_failure"
    }
  },
  "features": {
    "PK_TOPO_GRAPH": [
      "atomic-apply",
      "cas-revision"
    ],
    "PK_TOPO_NEAREST": [
      "explain",
      "residency",
      "staleness"
    ],
    "PK_TOPO_PARTITION": [
      "fencing",
      "lease"
    ]
  },
  "limits": {
    "default_deadline_ms": 2000,
    "max_candidates": 16,
    "max_deadline_ms": 60000,
    "max_json_depth": 16,
    "max_mutations_per_apply": 1000,
    "max_payload_bytes": 262144
  },
  "outcomes": [
    "success",
    "partial",
    "degraded",
    "retryable_failure",
    "terminal_failure"
  ],
  "title": "INV-62 stable error code registry",
  "versions": {
    "PK_TOPO_GRAPH": [
      1
    ],
    "PK_TOPO_NEAREST": [
      1
    ],
    "PK_TOPO_PARTITION": [
      1
    ]
  }
}
