{
  "$defs": {
    "ident": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "[A-Za-z0-9\\-_.:]+",
      "type": "string"
    }
  },
  "$id": "urn:inv62:pk_topo_nearest:request:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "accept_versions": {
          "items": {
            "maximum": 999,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "body": {
          "additionalProperties": false,
          "properties": {
            "capability": {
              "$ref": "#/$defs/ident"
            },
            "constraints": {
              "additionalProperties": false,
              "properties": {
                "exclude": {
                  "items": {
                    "$ref": "#/$defs/ident"
                  },
                  "maxItems": 64,
                  "type": "array",
                  "uniqueItems": true
                },
                "max_latency_ms": {
                  "minimum": 0,
                  "type": "number"
                },
                "prefer": {
                  "enum": [
                    "latency",
                    "cost"
                  ]
                },
                "residency": {
                  "items": {
                    "$ref": "#/$defs/ident"
                  },
                  "maxItems": 16,
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "same_site_only": {
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "explain": {
              "type": "boolean"
            },
            "origin": {
              "$ref": "#/$defs/ident"
            }
          },
          "required": [
            "origin",
            "capability"
          ],
          "type": "object"
        },
        "credential": {
          "maxLength": 4096,
          "minLength": 16,
          "type": "string"
        },
        "deadline_ms": {
          "maximum": 60000,
          "minimum": 1,
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 64,
          "minLength": 8,
          "pattern": "[A-Za-z0-9\\-_]+",
          "type": "string"
        },
        "op": {
          "const": "resolve"
        },
        "protocol": {
          "pattern": "PK_TOPO_(GRAPH|NEAREST|PARTITION)/[0-9]{1,3}",
          "type": "string"
        },
        "request_id": {
          "maxLength": 64,
          "minLength": 8,
          "pattern": "[A-Za-z0-9\\-_]+",
          "type": "string"
        },
        "required_features": {
          "items": {
            "$ref": "#/$defs/ident"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "tenant": {
          "$ref": "#/$defs/ident"
        },
        "traceparent": {
          "pattern": "00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "op",
        "tenant",
        "request_id",
        "credential",
        "body"
      ],
      "type": "object"
    }
  ],
  "title": "PK_TOPO_NEAREST/1 request"
}
