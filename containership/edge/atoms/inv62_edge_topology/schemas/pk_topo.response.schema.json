{
  "$defs": {
    "ident": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "[A-Za-z0-9\\-_.:]+",
      "type": "string"
    }
  },
  "$id": "urn:inv62:pk_topo:response:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "degraded_mode": {
      "type": "string"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "TOPO.CANCELLED",
            "TOPO.CONFLICT",
            "TOPO.DEADLINE_EXCEEDED",
            "TOPO.DEPENDENCY_UNAVAILABLE",
            "TOPO.FORBIDDEN",
            "TOPO.FROZEN",
            "TOPO.IDEMPOTENCY_MISMATCH",
            "TOPO.INTERNAL",
            "TOPO.INVALID_REQUEST",
            "TOPO.INVALID_TOPOLOGY",
            "TOPO.NOT_READY",
            "TOPO.NO_CAPABLE_NODE",
            "TOPO.NO_COORDINATOR",
            "TOPO.OVERLOADED",
            "TOPO.PAYLOAD_TOO_LARGE",
            "TOPO.QUARANTINED",
            "TOPO.QUOTA_EXCEEDED",
            "TOPO.RATE_LIMITED",
            "TOPO.REPLAYED",
            "TOPO.STALE_LEADER",
            "TOPO.UNAUTHENTICATED",
            "TOPO.UNKNOWN_NODE",
            "TOPO.UNKNOWN_SITE",
            "TOPO.UNSUPPORTED_VERSION"
          ]
        },
        "correlation_id": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "message": {
          "maxLength": 512,
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "retry_after_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "outcome",
        "message",
        "retryable",
        "details"
      ],
      "type": "object"
    },
    "outcome": {
      "enum": [
        "success",
        "partial",
        "degraded",
        "retryable_failure",
        "terminal_failure"
      ]
    },
    "protocol": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "result": {
      "type": "object"
    },
    "revision": {
      "minimum": 0,
      "type": "integer"
    },
    "traceparent": {
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "request_id",
    "outcome"
  ],
  "title": "PK_TOPO_*/1 response envelope",
  "type": "object"
}
