        "tests/test_resilience.py::test_same_key_same_payload_returns_cached"
      ],
      "checklist": [
        "C025"
      ]
    },
    {
      "id": "REQ-021",
      "contexts": [
        "all"
      ],
      "statement": "Admission SHALL enforce per-tenant token buckets after authorisation and a global in-flight bound, shedding with retryable codes.",
      "implementation": [
        "production/resilience.py::Admission"
      ],
      "verification": [
        "tests/test_security.py::test_T09_rate_limit_sheds_per_tenant",
