{
  "schema": "INV62_REQUIREMENTS/1",
  "version": "4.3.0",
  "requirements": [
    {
      "id": "REQ-001",
      "contexts": [
        "all"
      ],
      "statement": "The service SHALL store every non-cloud node with a validated parent of the immediately higher tier; device and parent site SHALL agree.",
      "implementation": [
        "topology.py::Topology.add"
      ],
      "verification": [
        "tests/test_topology.py::test_invalid_hierarchy_is_rejected",
        "tests/test_topology.py::test_hierarchy_is_retained"
      ],
      "checklist": [
        "C011",
        "C012"
      ]
    },
    {
      "id": "REQ-002",
      "contexts": [
        "all"
      ],
      "statement": "The service SHALL reject duplicate node registration, dangling links, self-links, non-finite/negative latency and non-Boolean link state.",
      "implementation": [
        "topology.py::Topology.connect"
      ],
      "verification": [
        "tests/test_topology.py::test_link_validation_rejects_unsafe_values",
        "tests/test_topology.py::test_duplicate_nodes_do_not_silently_mutate_state"
      ],
      "checklist": [
        "C011"
      ]
    },
    {
      "id": "REQ-003",
      "contexts": [
        "all"
      ],
      "statement": "Identifiers SHALL match [A-Za-z0-9-_.:]{1,128} with no surrounding whitespace.",
      "implementation": [
        "topology.py::validate_identifier"
      ],
      "verification": [
        "tests/test_topology.py::test_identifier_grammar_rejects_injection"
      ],
      "checklist": [
        "C011",
        "C028"
      ]
    },
    {
      "id": "REQ-004",
      "contexts": [
        "all"
      ],
      "statement": "Resolution SHALL never traverse a link that is down.",
      "implementation": [
        "topology.py::Topology._neighbours"
      ],
      "verification": [
        "tests/test_fuzz.py::test_routing_matches_reference_and_never_uses_down_links"
      ],
      "checklist": [
        "C011"
      ]
    },
    {
      "id": "REQ-005",
      "contexts": [
        "all"
      ],
      "statement": "Resolution SHALL return the lowest-latency reachable node that satisfies capability and policy, ties broken by lowest node name.",
      "implementation": [
        "production/policy.py::resolve"
      ],
      "verification": [
        "tests/test_fuzz.py::test_routing_matches_reference_and_never_uses_down_links",
        "tests/test_service.py::test_failover_when_preferred_node_lost"
      ],
      "checklist": [
        "C011",
        "C012"
      ]
    },
    {
      "id": "REQ-006",
      "contexts": [
        "far-edge",
        "near-edge"
      ],
      "statement": "A site SHALL be reported partitioned iff no member can reach the designated cloud-tier node over live links.",
      "implementation": [
        "production/service.py::_partitioned_sites"
      ],
      "verification": [
        "tests/test_election.py::test_partition_status_lifecycle_and_reconciliation",
        "tests/test_faults.py::test_multi_site_isolation"
      ],
      "checklist": [
        "C011",
        "C018"
      ]
    },
    {
      "id": "REQ-007",
      "contexts": [
        "far-edge",
        "near-edge"
      ],
      "statement": "While partitioned, on-site resolution SHALL continue and SHALL be marked outcome=degraded with degraded_mode=partitioned_local.",
      "implementation": [
        "production/service.py::_resolve"
      ],
      "verification": [
        "tests/test_service.py::test_partitioned_origin_answers_locally_degraded"
      ],
      "checklist": [
        "C014",
        "C018"
      ]
    },
    {
      "id": "REQ-008",
      "contexts": [
        "far-edge",
        "near-edge"
      ],
      "statement": "At most one node SHALL hold a site lease at a time; terms SHALL be strictly increasing and persisted before a grant is returned.",
      "implementation": [
        "production/election.py::LeaseAuthority.acquire"
      ],
      "verification": [
        "tests/test_election.py::test_single_holder_and_monotonic_terms",
        "tests/test_concurrency.py::test_contended_lease_has_single_winner",
        "tests/test_election.py::test_terms_survive_restart"
      ],
      "checklist": [
        "C015",
        "C058"
      ]
    },
    {
      "id": "REQ-009",
      "contexts": [
        "far-edge",
        "near-edge"
      ],
      "statement": "A fencing token lower than the current term SHALL be rejected with TOPO.STALE_LEADER.",
      "implementation": [
        "production/election.py::LeaseAuthority.validate_token"
      ],
      "verification": [
        "tests/test_election.py::test_fencing_rejects_stale_leader"
      ],
      "checklist": [
        "C058"
      ]
    },
    {
      "id": "REQ-010",
      "contexts": [
        "far-edge",
        "near-edge"
      ],
      "statement": "A lease candidate SHALL be coordinator-capable, unquarantined, a member of the site and able to reach a strict majority of eligible voters.",
      "implementation": [
        "production/election.py::LeaseAuthority.quorum"
      ],
      "verification": [
        "tests/test_election.py::test_minority_side_cannot_acquire",
        "tests/test_election.py::test_ineligible_and_foreign_candidates_refused"
      ],
      "checklist": [
        "C058"
      ]
    },
    {
      "id": "REQ-011",
      "contexts": [
        "all"
      ],
      "statement": "When a partition heals the site-local lease SHALL be revoked so the term fences the former local leader.",
      "implementation": [
        "production/service.py::_partition"
      ],
      "verification": [
        "tests/test_election.py::test_partition_status_lifecycle_and_reconciliation"
      ],
      "checklist": [
        "C018",
        "C058"
      ]
    },
    {
      "id": "REQ-012",
      "contexts": [
        "all"
      ],
      "statement": "Every externally visible request/response SHALL conform to the versioned JSON Schemas in schemas/.",
      "implementation": [
        "production/wire.py::validate_request"
      ],
      "verification": [
        "tests/test_contract.py::test_every_fixture_behaves_as_documented",
        "tests/test_service.py::test_every_response_matches_response_schema"
      ],
      "checklist": [
        "C021",
        "C022"
      ]
    },
    {
      "id": "REQ-013",
      "contexts": [
        "all"
      ],
      "statement": "Every request SHALL carry a PKT1 credential that is MAC-valid, audience-bound, unexpired within 30 s skew and at most 900 s long-lived.",
      "implementation": [
        "production/auth.py::Authenticator.authenticate"
      ],
      "verification": [
        "tests/test_security.py::test_T01_forged_signature_rejected",
        "tests/test_security.py::test_T02_expired_and_future_credentials_rejected"
      ],
      "checklist": [
        "C023",
        "C044"
      ]
    },
    {
      "id": "REQ-014",
      "contexts": [
        "all"
      ],
      "statement": "Mutating requests SHALL consume a single-use nonce; replays SHALL be rejected and a full replay cache SHALL fail closed.",
      "implementation": [
        "production/auth.py::ReplayCache.spend"
      ],
      "verification": [
        "tests/test_security.py::test_T03_replay_of_mutating_credential_rejected",
        "tests/test_security.py::test_T03_replay_cache_fails_closed_when_full"
      ],
      "checklist": [
        "C023",
        "C050"
      ]
    },
    {
      "id": "REQ-015",
      "contexts": [
        "all"
      ],
      "statement": "Authorisation SHALL be default-deny by (family, op) permission, explicit tenant grant, and node binding for lease operations.",
      "implementation": [
        "production/auth.py::Authorizer.authorize"
      ],
      "verification": [
        "tests/test_security.py::test_T04_role_cannot_exceed_matrix",
        "tests/test_security.py::test_T05_node_agent_bound_to_own_node",
        "tests/test_security.py::test_T06_cross_tenant_access_denied_and_isolated"
      ],
      "checklist": [
        "C024",
        "C042",
        "C043",
        "C046"
      ]
    },
    {
      "id": "REQ-016",
      "contexts": [
        "all"
      ],
      "statement": "Identity, policy, key or time dependency outage SHALL fail closed with TOPO.DEPENDENCY_UNAVAILABLE and mark the service not ready.",
      "implementation": [
        "production/service.py::health"
      ],
      "verification": [
        "tests/test_security.py::test_policy_outage",
        "tests/test_security.py::test_key_outage",
        "tests/test_security.py::test_time_outage"
      ],
      "checklist": [
        "C048"
      ]
    },
    {
      "id": "REQ-017",
      "contexts": [
        "all"
      ],
      "statement": "Every failure SHALL be reported as a stable TOPO.* code with outcome, retryable flag and secret-free details.",
      "implementation": [
        "production/errors.py::TopoError.to_wire"
      ],
      "verification": [
        "tests/test_service.py::test_error_codes_are_stable_and_unique",
        "tests/test_security.py::test_errors_do_not_leak_internals"
      ],
      "checklist": [
        "C014",
        "C026"
      ]
    },
    {
      "id": "REQ-018",
      "contexts": [
        "all"
      ],
      "statement": "Payloads SHALL be bounded (256 KiB, depth 16, 1000 mutations, 16 candidates) and graphs bounded by configured node/link/degree/capability limits.",
      "implementation": [
        "production/wire.py::decode"
      ],
      "verification": [
        "tests/test_security.py::test_T07_hostile_payloads_rejected_without_internal_error",
        "tests/test_security.py::test_T08_graph_quota_and_batch_limits",
        "tests/test_topology.py::test_resource_bounds_are_enforced"
      ],
      "checklist": [
        "C017",
        "C028",
        "C067"
      ]
    },
    {
      "id": "REQ-019",
      "contexts": [
        "all"
