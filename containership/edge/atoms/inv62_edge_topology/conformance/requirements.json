      "statement": "Requests SHALL carry or default a deadline; an apply whose deadline expires before commit SHALL leave no persisted or visible change.",
      "implementation": [
        "production/service.py::_apply"
      ],
      "verification": [
        "tests/test_resilience.py::test_apply_aborts_before_commit_when_deadline_passes"
      ],
      "checklist": [
        "C025"
      ]
    },
    {
      "id": "REQ-020",
      "contexts": [
        "all"
      ],
      "statement": "A mutation retried with the same idempotency key and payload SHALL return the original response without re-applying; a different payload SHALL be refused.",
      "implementation": [
        "production/resilience.py::IdempotencyStore"
      ],
      "verification": [
