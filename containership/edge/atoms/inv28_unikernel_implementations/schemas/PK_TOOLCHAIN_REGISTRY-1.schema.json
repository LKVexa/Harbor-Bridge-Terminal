    "key_id",
    "mac",
    "purpose"
   ],
   "type": "object"
  },
  "state_digest": {
   "pattern": "^[0-9a-f]{64}$",
   "type": "string"
  }
 },
 "required": [
  "entries",
  "head_digest",
  "history",
  "prev_digest",
  "revision",
  "schema",
  "signature",
  "state_digest"
