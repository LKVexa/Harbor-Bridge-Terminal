{
 "$id": "urn:pk:inv28:PK_TOOLCHAIN-1",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "architectures": {
   "items": {
    "maxLength": 64,
    "pattern": "^[a-z0-9][a-z0-9._+\\-/]*$",
