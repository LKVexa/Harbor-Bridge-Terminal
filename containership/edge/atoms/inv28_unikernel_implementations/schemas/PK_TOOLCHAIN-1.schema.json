   },
   "maxItems": 64,
   "minItems": 1,
   "type": "array",
   "uniqueItems": true
  },
  "languages": {
   "items": {
    "maxLength": 64,
    "pattern": "^[a-z0-9][a-z0-9._+\\-/]*$",
    "type": "string"
   },
   "maxItems": 64,
   "minItems": 1,
   "type": "array",
   "uniqueItems": true
  },
  "limitations": {
   "items": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "type": "array"
  },
  "maturity": {
   "enum": [
    "experimental",
    "beta",
    "mature"
   ]
  },
  "name": {
   "maxLength": 512,
   "minLength": 1,
   "type": "string"
  },
  "reviewed_at": {
   "minimum": 0,
   "type": "integer"
  },
  "security_contact": {
   "type": "boolean"
  }
 },
 "required": [
  "architectures",
  "languages",
  "maturity",
  "name",
  "security_contact"
 ],
