{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_SIGNAL_SUBMISSION/2",
  "title": "Verified signal submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reporter",
    "submission_id",
    "issued_at",
    "samples",
    "signature",
    "attestation"
  ],
  "properties": {
    "schema": {
      "const": "PK_SIGNAL_SUBMISSION/2"
    },
    "reporter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "attestation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "maxProperties": 64
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal",
        "value",
        "tenant",
        "environment",
        "site",
        "workload",
        "at"
      ],
      "properties": {
        "signal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "value": {
          "type": "number",
          "minimum": -1.7976931348623157e+308,
          "maximum": 1.7976931348623157e+308
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workload": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
