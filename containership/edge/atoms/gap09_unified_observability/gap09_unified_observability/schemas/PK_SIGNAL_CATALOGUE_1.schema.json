{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PK_SIGNAL_CATALOGUE/1",
  "title": "Signal catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "signals"],
  "properties": {
    "schema": {"const": "PK_SIGNAL_CATALOGUE/1"},
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "unit", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {"enum": ["gauge", "counter", "histogram", "log", "trace", "profile"]},
          "unit": {"type": "string", "maxLength": 128},
          "description": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    }
  }
}
