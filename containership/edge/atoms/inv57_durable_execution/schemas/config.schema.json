{
 "$id": "INV57_CONFIG/1",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "activity_timeout_seconds": {
   "default": 60.0,
   "maximum": 86400.0,
   "minimum": 0.1,
   "type": "number"
  },
  "admission_max_inflight": {
   "default": 256,
   "maximum": 1000000,
   "minimum": 1,
   "type": "integer"
  },
  "admission_per_tenant_inflight": {
   "default": 64,
   "maximum": 1000000,
   "minimum": 1,
   "type": "integer"
  },
  "circuit_failure_threshold": {
   "default": 5,
   "maximum": 1000,
   "minimum": 1,
   "type": "integer"
  },
  "circuit_reset_seconds": {
   "default": 30.0,
   "maximum": 3600.0,
   "minimum": 0.1,
   "type": "number"
  },
  "environment": {
   "default": "dev",
   "enum": [
    "dev",
    "prod",
    "staging",
    "test"
   ],
   "type": "string"
  },
  "in_doubt_policy": {
   "default": "halt",
   "enum": [
    "halt"
   ],
   "type": "string"
  },
  "lease_ttl_seconds": {
   "default": 30.0,
   "maximum": 3600.0,
   "minimum": 1.0,
   "type": "number"
  },
  "max_history_events": {
   "default": 100000,
   "maximum": 10000000,
   "minimum": 2,
   "type": "integer"
  },
  "retry_base_delay_seconds": {
   "default": 0.2,
   "maximum": 60.0,
   "minimum": 0.001,
   "type": "number"
  },
  "retry_max_attempts": {
   "default": 3,
   "maximum": 20,
   "minimum": 1,
   "type": "integer"
  },
  "retry_max_delay_seconds": {
   "default": 10.0,
   "maximum": 600.0,
   "minimum": 0.01,
   "type": "number"
  },
  "site": {
   "default": "default",
   "type": "string"
  },
  "state_backend": {
   "default": "sqlite",
   "enum": [
    "inv50",
    "sqlite"
   ],
   "type": "string"
  },
  "state_encryption_key_secret_ref": {
   "default": "",
   "pattern": "^(secretref://.+)?$",
   "type": "string"
  },
  "state_path": {
   "default": "inv57-history.db",
   "type": "string"
  },
  "telemetry_payload_capture": {
   "default": false,
   "type": "boolean"
  }
 },
 "type": "object"
}
