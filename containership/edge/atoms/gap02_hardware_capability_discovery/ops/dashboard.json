{
  "schema": "GAP02_DASHBOARD/1",
  "title": "GAP-02 Hardware Capability Discovery",
  "panels": [
    {"title": "Capability state (1 present / 0 absent / -1 unprobed)", "metric": "gap02_capability_state", "type": "state-timeline"},
    {"title": "Report age (s)", "metric": "gap02_report_age_seconds", "type": "timeseries", "threshold": 60},
    {"title": "Probe failures by code", "metric": "gap02_probe_failures_total", "type": "bar"},
    {"title": "Probe latency (s)", "metric": "gap02_probe_latency_seconds", "type": "timeseries"},
    {"title": "Capability transitions", "metric": "gap02_capability_changes_total", "type": "timeseries"},
    {"title": "Probe runs", "metric": "gap02_probe_runs_total", "type": "stat"}
  ]
}
