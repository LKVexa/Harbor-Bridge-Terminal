{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:PK_NODE_CAPABILITIES:1",
  "title": "PK_NODE_CAPABILITIES/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node", "present", "absent", "unprobed", "published_at", "age"],
  "properties": {
    "schema": {"const": "PK_NODE_CAPABILITIES/1"},
    "node": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/+@-]{0,127}$"},
    "present": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "absent": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unprobed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "published_at": {"type": "integer", "minimum": 0},
    "age": {"type": "integer", "minimum": 0}
  }
}
