{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INV-17 governance review record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "date",
    "reviewers",
    "scope",
    "findings",
    "decision"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "REV-[0-9]{4}-[0-9]{2}"
    },
    "date": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "continue",
        "remediate",
        "escalate"
      ]
    }
  }
}
