{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INV-17 structured log record",
  "type": "object",
  "required": [
    "ts",
    "level",
    "event",
    "component",
    "version",
    "instance"
  ],
  "properties": {
    "ts": {
      "type": "number"
    },
    "level": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    },
    "event": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "instance": {
      "type": "string"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stream_id": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "tenant_hash": {
      "type": "string"
    },
    "workload_hash": {
      "type": "string"
    }
  }
}
