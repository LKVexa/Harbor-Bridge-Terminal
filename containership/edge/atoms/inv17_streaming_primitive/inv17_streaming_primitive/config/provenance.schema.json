{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INV-17 configuration provenance (configuration.Provenance)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "author",
    "source_revision",
    "sources",
    "digest",
    "activated_at",
    "reason"
  ],
  "properties": {
    "author": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "sha256:[0-9a-f]{64}"
    },
    "activated_at": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    }
  }
}
