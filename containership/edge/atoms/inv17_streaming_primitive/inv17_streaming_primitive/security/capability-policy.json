{
  "schema": "urn:pk:inv17:capability-policy:1",
  "source": "security.py::CapabilityAuthority",
  "rights": [
    "open",
    "read",
    "write",
    "grant",
    "close",
    "transfer",
    "admin"
  ],
  "end_rights": {
    "reader": [
      "read",
      "grant",
      "close"
    ],
    "writer": [
      "write",
      "close"
    ]
  },
  "max_ttl_seconds": 300,
  "single_use": [
    "transfer"
  ],
  "binding": [
    "stream_id",
    "tenant",
    "workload"
  ],
  "mac": "HMAC-SHA256",
  "min_key_bits": 256,
  "default": "deny"
}
