{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INV-17 audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "ts",
    "kind",
    "actor",
    "subject",
    "outcome",
    "detail",
    "prev",
    "mac"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "number"
    },
    "kind": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "detail": {
      "type": "object"
    },
    "prev": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "mac": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    }
  }
}
