{
  "profile": "production",
  "provider": {"kind": "durable"},
  "auth": {"mode": "hmac", "hmac_key_ref": "secret://env/INV54_HMAC_KEY", "token_ttl_s": 900},
  "storage": {"path": "/var/lib/inv54", "fsync": "always", "encrypt": true, "key_ref": "secret://env/INV54_STORE_KEY"},
  "limits": {"partitions": 2, "max_inflight": 64, "max_backlog_per_subscriber": 2000, "overflow_policy": "drop_oldest"},
  "retention": {"max_records": 500000, "max_age_s": 604800, "compact": false}
}
