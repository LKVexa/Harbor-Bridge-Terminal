{
  "$id": "urn:inv54:PK_BROKER_LOG/1.1#record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dest": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "position": {
      "description": "partition:offset (log) or provider handle",
      "type": "string"
    },
    "tenant": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "type": "string"
    },
    "traceparent": {
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "type": "string"
    },
    "value": {}
  },
  "required": [
    "tenant",
    "dest",
    "value"
  ],
  "title": "INV-54 log record / fan-out envelope",
  "type": "object"
}
