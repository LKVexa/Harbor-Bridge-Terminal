{"schema": "inv54.dashboard/1", "status": "authored, not deployed", "title": "INV-54 brokers",
 "panels": [
  {"title": "Publish / append rate", "expr": "sum by (tenant) (rate(inv54_published[1m])) + sum by (tenant) (rate(inv54_appended[1m]))"},
  {"title": "Consumer lag", "expr": "max by (tenant, consumer) (inv54_consumer_lag)"},
  {"title": "Backlog rejects", "expr": "sum by (tenant) (increase(inv54_backlog_rejects[5m]))"},
  {"title": "Authz denials by code", "expr": "sum by (code) (increase(inv54_authz_denied[5m]))"},
  {"title": "Replays", "expr": "sum by (tenant) (increase(inv54_replays[1h]))"},
  {"title": "Lifecycle transitions", "expr": "sum by (to) (inv54_lifecycle_transitions)"}]}
