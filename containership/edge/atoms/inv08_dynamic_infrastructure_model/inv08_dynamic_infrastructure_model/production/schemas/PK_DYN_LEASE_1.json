{
  "$id": "PK_DYN_LEASE/1",
  "title": "Node lease grant/renew/release",
  "type": "object",
  "required": ["schema", "schema_minor", "op", "lease_id", "node_id", "pool_id", "epoch", "issued_at", "expires_at"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "PK_DYN_LEASE/1"},
    "schema_minor": {"type": "integer", "minimum": 0, "maximum": 1000},
    "op": {"enum": ["GRANT", "RENEW", "RELEASE"]},
    "lease_id": {"type": "string", "pattern": "^lease-[a-z0-9-]{1,64}$"},
    "node_id": {"type": "string", "pattern": "^node-[0-9]{1,12}$"},
    "pool_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "tenant": {"type": "string", "minLength": 1, "maxLength": 64},
    "epoch": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "number", "minimum": 0},
    "expires_at": {"type": "number", "minimum": 0},
    "busy": {"type": "boolean"},
    "ext": {"type": "object"}
  }
}
