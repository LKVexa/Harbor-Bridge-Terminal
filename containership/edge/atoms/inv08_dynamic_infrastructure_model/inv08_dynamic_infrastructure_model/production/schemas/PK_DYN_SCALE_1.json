{
  "$id": "PK_DYN_SCALE/1",
  "title": "Scaling decision (mirrors model.Pool.tick result)",
  "type": "object",
  "required": ["schema", "schema_minor", "decision_id", "pool_id", "now", "demand", "size", "target", "added", "reclaimed", "renewed"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "PK_DYN_SCALE/1"},
    "schema_minor": {"type": "integer", "minimum": 0, "maximum": 1000},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "pool_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "now": {"type": "number"},
    "demand": {"type": "number", "minimum": 0},
    "size": {"type": "integer", "minimum": 0},
    "target": {"type": "integer", "minimum": 0},
    "added": {"type": "integer", "minimum": 0},
    "reclaimed": {"type": "array", "maxItems": 10000, "items": {"type": "string", "pattern": "^node-[0-9]{1,12}$"}},
    "renewed": {"type": "array", "maxItems": 10000, "items": {"type": "string", "pattern": "^node-[0-9]{1,12}$"}},
    "ext": {"type": "object"}
  }
}
