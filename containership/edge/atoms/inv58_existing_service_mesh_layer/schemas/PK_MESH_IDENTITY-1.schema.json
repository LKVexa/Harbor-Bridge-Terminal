{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:mesh:identity:1",
  "title": "PK_MESH_IDENTITY/1 mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["san", "trust_domain", "runtime_identity"],
  "properties": {
    "san": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^spiffe://"},
    "trust_domain": {"type": "string", "minLength": 1, "maxLength": 255},
    "runtime_identity": {"type": "string", "minLength": 9, "pattern": "^runtime:"}
  }
}
