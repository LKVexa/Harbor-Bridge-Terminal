{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:mesh:status:1",
  "title": "PK_MESH_STATUS/1",
  "type": "object",
  "required": [
    "schema",
    "component",
    "version",
    "release",
    "node",
    "site",
    "health",
    "readiness",
    "config",
    "policy_version",
    "dependencies",
    "capabilities",
    "controls",
    "tenants",
    "audit"
  ],
  "properties": {
    "schema": {
      "const": "PK_MESH_STATUS/1"
    },
    "component": {
      "const": "INV-58"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "health": {
      "type": "object",
      "required": [
        "live",
        "stalled",
        "error_ratio",
        "error_burst",
        "state"
      ]
    },
    "readiness": {
      "type": "object",
      "required": [
        "ready",
        "state",
        "critical_dependencies_down"
      ]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "available",
          "breaker"
        ]
      }
    },
    "config": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "digest",
        "version",
        "activated_at",
        "author"
      ]
    }
  }
}
