{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:mesh:artifact:1",
  "title": "PK_MESH_ARTIFACT/1 manifest",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "digest",
    "builder",
    "source_repo",
    "source_rev",
    "built_at",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "PK_MESH_ARTIFACT/1"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 10
    }
  }
}
