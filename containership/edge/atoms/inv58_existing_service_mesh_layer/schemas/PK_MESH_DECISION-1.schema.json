{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:mesh:decision:1",
  "title": "PK_MESH_DECISION/1 journal entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ts",
    "tenant",
    "operation",
    "inputs",
    "output",
    "reason",
    "correlation_id",
    "actor_type",
    "policy_version",
    "config_digest",
    "config_version",
    "constraints",
    "topology",
    "release"
  ],
  "properties": {
    "schema": {
      "const": "PK_MESH_DECISION/1"
    },
    "ts": {
      "type": "number"
    },
    "tenant": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "reconcile",
        "route.migrate"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "output": {
      "type": "object"
    },
    "reason": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "actor_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "config_version": {
      "type": "string"
    },
    "constraints": {
      "type": "object"
    },
    "topology": {
      "type": "object",
      "required": [
        "node",
        "site"
      ]
    },
    "release": {
      "type": "object",
      "required": [
        "artifact_version",
        "source_digest",
        "build_id"
      ]
    }
  }
}
