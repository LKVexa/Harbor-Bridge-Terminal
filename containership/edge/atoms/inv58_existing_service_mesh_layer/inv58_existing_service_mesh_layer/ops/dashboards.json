      {"title": "Route registry size", "metric": "inv58_route_registry_size", "by": ["tenant"]},
      {"title": "Bypass evidence backlog", "metric": "inv58_bypass_backlog"}]},
    {"id": "inv58-security", "title": "INV-58 Security", "panels": [
      {"title": "AuthZ decisions by code", "metric": "inv58_authz_decisions_total", "by": ["operation", "code"]},
      {"title": "Identity unmapped by reason", "metric": "inv58_identity_unmapped_total", "by": ["reason"]},
      {"title": "Config activations", "metric": "inv58_config_activations_total", "by": ["result"]},
      {"title": "Breaker state", "metric": "inv58_breaker_state", "by": ["dependency"]}]}
  ]
