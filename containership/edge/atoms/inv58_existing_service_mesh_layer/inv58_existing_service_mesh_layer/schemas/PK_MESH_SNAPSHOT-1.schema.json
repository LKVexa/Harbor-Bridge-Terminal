{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:mesh:snapshot:1",
  "title": "PK_MESH_SNAPSHOT/1 sealed state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "seal"
  ],
  "properties": {
    "seal": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body": {
      "type": "object",
      "required": [
        "schema",
        "taken_at",
        "version",
        "config_digest",
        "routes",
        "revisions",
        "fencing",
        "controls"
      ],
      "properties": {
        "schema": {
          "const": "PK_MESH_SNAPSHOT/1"
        }
      }
    }
  }
}
