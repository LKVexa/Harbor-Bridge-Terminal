{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:mesh:error:1",
  "title": "PK_MESH_ERROR/1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope",
    "code",
    "outcome",
    "retryable",
    "status",
    "message",
    "details",
    "correlation_id"
  ],
  "properties": {
    "envelope": {
      "const": "PK_MESH_ERROR/1"
    },
    "code": {
      "enum": [
        "E_AUDIT_INTEGRITY",
        "E_BUDGET_EXCEEDED",
        "E_CANCELLED",
        "E_CAPACITY",
        "E_CIRCUIT_OPEN",
        "E_CONFIG_INVALID",
        "E_CONFLICT",
        "E_DEADLINE_EXCEEDED",
        "E_DEPENDENCY_UNAVAILABLE",
        "E_FROZEN",
        "E_IDENTITY_UNMAPPABLE",
        "E_INTEGRITY",
        "E_INTERNAL",
        "E_INVALID_ARGUMENT",
        "E_NOT_READY",
        "E_OVERLOADED",
        "E_PAYLOAD_TOO_LARGE",
        "E_PERMISSION_DENIED",
        "E_STALE_FENCE",
        "E_TENANT_SCOPE",
        "E_UNAUTHENTICATED",
        "E_UNSUPPORTED_VERSION"
      ]
    },
    "outcome": {
      "enum": [
        "retryable",
        "terminal"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "status": {
      "type": "integer"
    },
    "message": {
      "type": "string",
      "maxLength": 256
    },
    "details": {
      "type": "object",
      "maxProperties": 32
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
