{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pk:mesh:reconcile:1",
  "title": "PK_MESH_RECONCILE/1 decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "owner", "app", "mesh", "budget", "effective_attempts", "reason"],
  "properties": {
    "route": {"type": "string", "minLength": 1, "maxLength": 512},
    "owner": {"enum": ["app", "mesh", "none"]},
    "app": {"type": "integer", "minimum": 1},
    "mesh": {"type": "integer", "minimum": 1},
    "budget": {"type": "integer", "minimum": 1},
    "effective_attempts": {"type": "integer", "minimum": 1},
    "reason": {
      "enum": [
        "budget_disables_retries",
        "app_preferred_for_idempotency",
        "app_only_retry_request",
        "mesh_only_retry_request",
        "no_retry_requested"
      ]
    }
  }
}
