        "authz.decision",
        "bypass.detected",
        "config.activated",
        "config.rejected",
        "config.rolled_back",
        "config.validated",
        "control.break_glass",
        "control.freeze",
        "control.quarantine",
        "control.unfreeze",
        "fence.rejected",
        "identity.mapped",
        "identity.rejected",
        "integrity.failure",
        "lifecycle.transition",
        "route.migrated",
        "route.rejected",
        "state.restored"
      ]
    },
    "actor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "tenant": {
      "type": [
        "string",
        "null"
      ]
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "attrs": {
      "type": "object",
      "maxProperties": 32
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mac": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
