{
 "schema": "PK_ECP_DASHBOARD/1",
 "title": "INV-66 enterprise Wasm control plane",
 "uid": "inv66-overview",
 "panels": [
  {
   "id": 1,
   "title": "Admissions by outcome",
   "expr": "sum by (outcome) (rate(ecp_admissions_total[5m]))"
  },
  {
   "id": 2,
   "title": "Admission p99 latency (ms)",
   "expr": "histogram_quantile(0.99, sum by (le) (rate(ecp_admission_latency_ms_bucket[5m])))"
  },
  {
   "id": 3,
   "title": "RBAC denials",
   "expr": "rate(ecp_rbac_denials_total[5m])"
  },
  {
   "id": 4,
   "title": "Authn failures",
   "expr": "rate(ecp_authn_failures_total[5m])"
  },
  {
   "id": 5,
   "title": "Quota / shed",
   "expr": "sum(rate(ecp_quota_exceeded_total[5m])) + sum(rate(ecp_shed_total[5m]))"
  },
  {
   "id": 6,
   "title": "In flight",
   "expr": "ecp_inflight"
  },
  {
   "id": 7,
   "title": "Delivery pending backlog",
   "expr": "ecp_delivery_pending"
  },
  {
   "id": 8,
   "title": "Delivery outcomes",
   "expr": "sum by (outcome) (rate(ecp_delivery_total[5m]))"
  },
  {
   "id": 9,
   "title": "Deployment breaker open",
   "expr": "ecp_breaker_open"
  },
  {
   "id": 10,
   "title": "Journal head seq",
   "expr": "ecp_journal_head_seq"
  },
  {
   "id": 11,
   "title": "Audit append failures",
   "expr": "increase(ecp_audit_append_failures_total[15m])"
  },
  {
   "id": 12,
   "title": "Audit verification ok",
   "expr": "ecp_audit_last_verify_ok"
  },
  {
   "id": 13,
   "title": "Frozen scopes (emergency state)",
   "expr": "ecp_frozen_scopes"
  },
  {
   "id": 14,
   "title": "Process RSS / FDs",
   "expr": "process_max_rss_kb"
  }
 ]
}
