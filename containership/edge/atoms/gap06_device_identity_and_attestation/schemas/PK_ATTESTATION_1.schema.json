{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:pk:PK_ATTESTATION/1",
 "title": "PK_ATTESTATION/1",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "schema": {
   "type": "string",
   "maxLength": 32,
   "const": "PK_ATTESTATION/1"
  },
  "node": {
   "type": "string",
   "maxLength": 255
  },
  "nonce": {
   "type": "string",
   "pattern": "^([0-9a-f]{2})*$",
   "maxLength": 128
  },
  "attest": {
   "type": "string",
   "pattern": "^([0-9a-f]{2})*$",
   "maxLength": 8192
  },
  "signature": {
   "type": "string",
   "pattern": "^([0-9a-f]{2})*$",
   "maxLength": 2048
  },
  "pcrs": {
   "type": "object"
  },
  "event_log": {
   "type": "string",
   "pattern": "^([0-9a-f]{2})*$",
   "maxLength": 8388608
  },
  "ima": {
   "type": "string",
   "maxLength": 4194304
  },
  "idempotency_key": {
   "type": "string",
   "maxLength": 64
  }
 },
 "required": [
  "schema",
  "node",
  "nonce",
  "attest",
  "signature",
  "pcrs",
  "idempotency_key"
 ]
}
