{
  "title": "INV-66 control plane",
  "uid": "inv66",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Admissions by outcome",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(inv66_admissions_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Admission p50/p99 (ms)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(inv66_admission_latency_ms_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RBAC denials",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (capability) (rate(inv66_rbac_denials_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AuthN failures",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(inv66_authn_failures_total[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox depth",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "inv66_outbox_depth"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "In-flight vs limit",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "inv66_inflight"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Audit head vs anchor",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "inv66_audit_head_sequence - inv66_audit_anchor_sequence"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Leader",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "inv66_leader"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Active freezes",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "inv66_freezes_active"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Store failures",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(inv66_store_failures_total[1h])"
        }
      ]
    }
  ]
}