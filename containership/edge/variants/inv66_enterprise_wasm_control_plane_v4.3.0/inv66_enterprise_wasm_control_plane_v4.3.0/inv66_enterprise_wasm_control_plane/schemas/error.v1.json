{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv66:schema:PK_ECP_ERROR:1",
  "type": "object",
  "required": [
    "code",
    "category",
    "message",
    "retryable",
    "remediation",
    "details"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z_]+$"
    },
    "category": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "remediation": {
      "type": "string"
    },
    "details": {
      "type": "object"
    }
  }
}
