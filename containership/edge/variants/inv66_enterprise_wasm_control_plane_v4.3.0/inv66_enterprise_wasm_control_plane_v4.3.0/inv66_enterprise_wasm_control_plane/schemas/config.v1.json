{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv66:schema:PK_ECP_CONFIG:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "author",
    "source_revision",
    "environment",
    "limits",
    "registries",
    "signers",
    "bindings",
    "quotas"
  ],
  "properties": {
    "schema": {
      "const": "PK_ECP_CONFIG/1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "site": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_components",
        "max_manifest_bytes"
      ],
      "properties": {
        "max_components": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_manifest_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 100000000
        },
        "max_inflight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "audit_retention_records": {
          "type": "integer",
          "minimum": 100
        },
        "idempotency_ttl_s": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "registries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "public_key"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "public_key": {
            "type": "string",
            "description": "ed25519 raw public key, hex"
          },
          "not_after": {
            "type": "integer"
          }
        }
      }
    },
    "require_attestations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "urn:inv66:schema:PK_ECP_RBAC:1:binding"
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "quotas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "admissions_per_minute"
        ],
        "properties": {
          "admissions_per_minute": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(env|file)://.+$"
      }
    }
  }
}
