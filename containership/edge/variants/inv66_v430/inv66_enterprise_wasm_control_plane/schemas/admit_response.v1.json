{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv66:schema:PK_ECP_ADMIT:1:response",
  "type": "object",
  "required": [
    "protocol",
    "request_id",
    "decision_id",
    "admitted",
    "state",
    "errors",
    "manifest_sha256",
    "policy_version",
    "config_digest",
    "audit_sequence"
  ],
  "properties": {
    "protocol": {
      "const": "PK_ECP_ADMIT/1"
    },
    "request_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "admitted": {
      "type": "boolean"
    },
    "state": {
      "type": "string",
      "enum": [
        "admitted",
        "rejected"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "urn:inv66:schema:PK_ECP_ERROR:1"
      }
    },
    "manifest_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string"
    },
    "config_digest": {
      "type": "string"
    },
    "audit_sequence": {
      "type": "integer"
    },
    "replayed": {
      "type": "boolean"
    },
    "trace_id": {
      "type": "string"
    }
  }
}
