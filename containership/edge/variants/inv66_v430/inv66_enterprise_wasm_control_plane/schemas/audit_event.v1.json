{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inv66:schema:PK_ECP_AUDIT:1:event",
  "type": "object",
  "required": [
    "schema",
    "sequence",
    "previous_hash",
    "hash",
    "epoch",
    "entry"
  ],
  "properties": {
    "schema": {
      "const": "PK_ECP_AUDIT/1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "entry": {
      "type": "object",
      "required": [
        "kind",
        "ts"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "admission",
            "rbac",
            "config",
            "freeze",
            "lifecycle",
            "deploy",
            "anchor"
          ]
        },
        "ts": {
          "type": "number"
        }
      }
    }
  }
}
