{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "protocol",
  "credential",
  "name",
  "value",
  "idempotency_key"
 ],
 "properties": {
  "protocol": {
   "const": "PK_SECRET_ROTATE/1"
  },
  "request_id": {
   "$ref": "common.schema.json#/$defs/request_id"
  },
  "traceparent": {
   "$ref": "common.schema.json#/$defs/traceparent"
  },
  "credential": {
   "$ref": "common.schema.json#/$defs/credential"
  },
  "timeout_ms": {
   "$ref": "common.schema.json#/$defs/timeout_ms"
  },
  "name": {
   "$ref": "common.schema.json#/$defs/identifier"
  },
  "value": {
   "type": "string",
   "minLength": 1,
   "maxLength": 65536
  },
  "idempotency_key": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_-]{8,64}$"
  },
  "expected_version": {
   "type": "integer",
   "minimum": 0
  }
 },
 "description": "Tolerant reader: unknown fields are ignored (compatibility-policy.md).",
 "$id": "urn:inv55:rotate.request"
}