{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "ok",
  "outcome",
  "protocol",
  "request_id",
  "name",
  "version",
  "lease_id",
  "expires_in_s"
 ],
 "properties": {
  "ok": {
   "const": true
  },
  "outcome": {
   "enum": [
    "success",
    "degraded"
   ]
  },
  "protocol": {
   "const": "PK_SECRET_RESOLVE/1"
  },
  "request_id": {
   "$ref": "common.schema.json#/$defs/request_id"
  },
  "name": {
   "$ref": "common.schema.json#/$defs/identifier"
  },
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "lease_id": {
   "type": "string",
   "minLength": 16,
   "maxLength": 64
  },
  "expires_in_s": {
   "type": "number"
  }
 },
 "$id": "urn:inv55:resolve.response"
}