{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "ok",
  "error"
 ],
 "properties": {
  "ok": {
   "const": false
  },
  "error": {
   "type": "object",
   "required": [
    "protocol",
    "code",
    "outcome",
    "http_status",
    "message"
   ],
   "additionalProperties": false,
   "properties": {
    "protocol": {
     "const": "PK_SECRET_ERROR/1"
    },
    "code": {
     "enum": [
      "INV55-E001-DENIED",
      "INV55-E002-UNAUTHENTICATED",
      "INV55-E003-LEASE-EXPIRED",
      "INV55-E004-LEASE-REVOKED",
      "INV55-E005-CONTEXT-MISMATCH",
      "INV55-E006-VERSION-RETIRED",
      "INV55-E007-INVALID-REFERENCE",
      "INV55-E008-CLOCK-ROLLBACK",
      "INV55-E009-PROVIDER-UNAVAILABLE",
      "INV55-E010-OVERLOADED",
      "INV55-E011-QUOTA-EXCEEDED",
      "INV55-E012-DEADLINE-EXCEEDED",
      "INV55-E013-FROZEN",
      "INV55-E014-AUDIT-UNAVAILABLE",
      "INV55-E015-UNSUPPORTED-VERSION",
      "INV55-E016-LIMIT-EXCEEDED",
      "INV55-E017-CAPACITY",
      "INV55-E019-CONFLICT",
      "INV55-E018-CANCELLED",
      "INV55-E999-INTERNAL"
     ]
    },
    "outcome": {
     "enum": [
      "success",
      "degraded",
      "retryable",
      "terminal",
      "denied"
     ]
    },
    "http_status": {
     "type": "integer"
    },
    "message": {
     "type": "string",
     "maxLength": 200
    },
    "retry_after_ms": {
     "type": "integer",
     "minimum": 0
    },
    "request_id": {
     "$ref": "common.schema.json#/$defs/request_id"
    }
   }
  }
 },
 "$id": "urn:inv55:error"
}