{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "ok",
  "outcome",
  "protocol",
  "request_id",
  "name",
  "apps"
 ],
 "properties": {
  "ok": {
   "const": true
  },
  "outcome": {
   "enum": [
    "success",
    "degraded"
   ]
  },
  "protocol": {
   "const": "PK_SECRET_SCOPE/1"
  },
  "request_id": {
   "$ref": "common.schema.json#/$defs/request_id"
  },
  "name": {
   "$ref": "common.schema.json#/$defs/identifier"
  },
  "apps": {
   "type": "array",
   "items": {
    "$ref": "common.schema.json#/$defs/identifier"
   }
  }
 },
 "$id": "urn:inv55:scope.response"
}