{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:inv55:common",
 "$defs":{
  "identifier":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","maxLength":256},
  "request_id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,64}$"},
  "traceparent":{"type":"string","pattern":"^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
  "credential":{"type":"string","minLength":1,"maxLength":8192},
  "timeout_ms":{"type":"integer","minimum":1,"maximum":60000}
 }}
