{
 "schema_version": 1,
 "environment": "dev",
 "provider": {
  "kind": "vault",
  "mount": "secret",
  "kv_version": 2,
  "auth": "kubernetes",
  "auth_ref": "/var/run/secrets/kubernetes.io/serviceaccount/token",
  "timeout_s": 2.0
 },
 "limits": {
  "lease_ttl_s": 300,
  "max_lease_ttl_s": 3600,
  "cache_ttl_s": 30,
  "stale_grace_s": 0,
  "max_in_flight": 256,
  "tenant_rate": 200,
  "workload_rate": 50,
  "max_active_leases": 100000
 },
 "telemetry": {
  "log_level": "info",
  "trace_sample_ratio": 0.1,
  "metrics_max_series": 2000
 },
 "audit": {
  "path": "/var/lib/inv55/audit.jsonl",
  "fsync": true,
  "hmac_key_ref": "file:/etc/inv55/audit-hmac.key"
 }
}