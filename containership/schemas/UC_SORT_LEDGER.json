{
  "$id": "https://uc.local/schema/UC_SORT_LEDGER.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "kind": {
      "enum": [
        "vm",
        "subsystem"
      ]
    },
    "records": {
      "items": {
        "properties": {
          "complexity_band": {
            "enum": [
              "LOW",
              "MID",
              "HIGH",
              "VERY_HIGH"
            ]
          },
          "node": {
            "enum": [
              "N_SMALL",
              "N_MEDIUM",
              "N_LARGE",
              "N_XLARGE"
            ]
          },
          "rule": {
            "pattern": "^S[0-9]$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "node",
          "rule",
          "explanation",
          "kind",
          "bytes",
          "lines",
          "sha256",
          "complexity_score",
          "complexity_band"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "UC/SORT_LEDGER/1"
    }
  },
  "required": [
    "schema",
    "uc_release",
    "berth",
    "kind",
    "policy",
    "policy_sha256",
    "source",
    "scripts",
    "per_node",
    "records"
  ],
  "title": "sort ledger",
  "type": "object"
}
