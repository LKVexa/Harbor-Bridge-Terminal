{
  "$id": "https://uc.local/schema/UC_NODE_SLOT.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cargo": {
      "required": [
        "count",
        "bytes",
        "tree_sha256"
      ],
      "type": "object"
    },
    "engine": {
      "required": [
        "hold_container",
        "zip_sha256"
      ],
      "type": "object"
    },
    "holds_vm": {
      "const": false
    },
    "node_id": {
      "enum": [
        "N_SMALL",
        "N_MEDIUM",
        "N_LARGE",
        "N_XLARGE"
      ]
    },
    "qubits": {
      "const": 0
    },
    "schema": {
      "const": "UC/NODE_SLOT/1"
    },
    "trust_domain": {
      "const": "LOCAL_TRUSTED"
    }
  },
  "required": [
    "schema",
    "uc_release",
    "berth",
    "slot",
    "node_id",
    "engine",
    "cargo",
    "holds_vm",
    "trust_domain",
    "qubits"
  ],
  "title": "node slot",
  "type": "object"
}
