{
  "$id": "https://uc.local/schema/UC_HULL_DIGEST.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "files": {
      "items": {
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "UC/HULL_DIGEST/1"
    },
    "tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "uc_release",
    "studio_version",
    "tree_sha256",
    "file_count",
    "files"
  ],
  "title": "hull digest",
  "type": "object"
}
