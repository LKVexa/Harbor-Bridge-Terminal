{
  "$id": "https://uc.local/schema/UC_SHIP_MANIFEST.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "file_count": {
      "minimum": 1,
      "type": "integer"
    },
    "files": {
      "items": {
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "physical_execution": {
      "required": [
        "NETWORK",
        "BACKEND"
      ],
      "type": "object"
    },
    "schema": {
      "const": "UC/SHIP_MANIFEST/1"
    }
  },
  "required": [
    "schema",
    "uc_release",
    "package_name",
    "assembled_at_utc",
    "hull",
    "hold",
    "berths",
    "file_count",
    "total_bytes",
    "files",
    "inventory_exclusions",
    "inventory_exclusion_reason",
    "physical_execution",
    "gates_measured_here"
  ],
  "title": "Unikernel Containership manifest",
  "type": "object"
}
