{
  "$id": "https://uc.local/schema/UC_FABRIC.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "container": {
      "enum": [
        "DF_Small",
        "DF_Medium",
        "DF_Large",
        "DF_Xtra_Large",
        "DF_Fabric"
      ]
    },
    "declaration_words": {
      "maximum": 116,
      "minimum": 1,
      "type": "integer"
    },
    "genesis": {
      "properties": {
        "blob_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "reversible": {
          "const": true
        },
        "tick": {
          "const": 0
        }
      },
      "required": [
        "file",
        "tick",
        "blob_sha256",
        "grid",
        "bytes",
        "reversible"
      ],
      "type": "object"
    },
    "schema": {
      "const": "UC/FABRIC/1"
    },
    "state0": {
      "required": [
        "tick",
        "acc",
        "ref",
        "rows",
        "index",
        "flags"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "uc_release",
    "berth",
    "container",
    "genesis",
    "state0",
    "declaration_words",
    "reference_witness",
    "live",
    "executes"
  ],
  "title": "a container's own .tif fabric (sealed genesis record)",
  "type": "object"
}
