{
  "$id": "https://uc.local/schema/UC_GATE_RESULTS.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "gates": {
      "items": {
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "seconds",
          "detail"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "UC/GATE_RESULTS/1"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  },
  "required": [
    "schema",
    "uc_release",
    "subject",
    "executed_at_utc",
    "host",
    "gates",
    "totals",
    "verdict"
  ],
  "title": "gate results",
  "type": "object"
}
