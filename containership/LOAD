#!/bin/sh
# Unikernel_Containership/LOAD -- load a project (dir or zip) into its own berth: --name NAME --kind vm|subsystem
# Offline. Nothing here opens a socket (NETWORK=deny, BACKEND=none).
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT"
PY="${PYTHON:-python3}"
exec "$PY" -B uc.py load "$@"
