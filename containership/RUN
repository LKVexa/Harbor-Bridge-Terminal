#!/bin/sh
# Unikernel_Containership/RUN -- one tick of a berth's .tif fabric on the four engines + the hull (--sealed: the sealed bundles' programs)
# Offline. Nothing here opens a socket (NETWORK=deny, BACKEND=none).
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT"
PY="${PYTHON:-python3}"
exec "$PY" -B uc.py run "$@"
