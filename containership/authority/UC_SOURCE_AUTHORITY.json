{
  "combination_rules": [
    {
      "id": "C1",
      "rule": "The hull is carried byte-identical and installed by BUILD from the Large engine's VM package into _studio/; the ship never edits it."
    },
    {
      "id": "C2",
      "rule": "The hold is carried byte-identical; BUILD extracts it into _engines/, re-checks each container's own SHA256SUMS, builds the engines, and the ship binds them through the hold's own dfabric runtime and pacore core (one copy)."
    },
    {
      "id": "C3",
      "rule": "A loaded project is broken up script by script; each script is measured from its bytes and sorted into one node by the versioned policy (first matching rule); the decision is recorded with the rule and a sentence."
    },
    {
      "id": "C4",
      "rule": "Each project gets its own blank scaffold (a berth: four hollow node slots + a fabric slot); cargo lands in the slot of its node under its original relative path, byte-identical."
    },
    {
      "id": "C5",
      "rule": "A berth's cargo manifest (CARGO.pal, one row per script) and its declaration (BERTH.pal, <= 84 rows) are PA-LCTL bundles: parsed, verified and sealed by pacore.lang, and witnessed on the four engines (CARGO.pal in 84-row segments)."
    },
    {
      "id": "C6",
      "rule": "A berth's hull face is the LCTLC/1.2 lowering of BERTH.pal's witness registered as a studio container whose declared answer is R2 == the reference witness; studio test keeps it honest."
    },
    {
      "id": "C7",
      "rule": "The bill of lading is rebuilt from disk; VERIFY re-derives every ledger from the cargo bytes and every seal from the bundles; SKIPPED names a missing prerequisite, never PASS."
    }
  ],
