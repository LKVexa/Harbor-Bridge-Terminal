# Example PRODUCT_LINK for LinearAndroid LCTL app node
# Env override: LINEAR_ANDROID_PRODUCT_ROOT (maps to PRODUCT_ROOT in this file)
#
# Russell workstation example (Windows):
# PRODUCT_ROOT=C:\Users\russe\OneDrive\Desktop\New folder\LinearAndroid_LCTL_v0.1.0\LinearAndroid_LCTL_v0.1.0
#
PRODUCT_ROOT=
PRODUCT_VERSION=0.1.0
NODE_ID=BR-VM-LINEARANDROID-LCTL
KIND=bottle-rocket-vm-app-node
VM_SUBSTRATE=mobile-platform\bottle-rocket
LINK_TARGET=mobile-platform\nodes\android-lctl\product
NOTE=Junction only; do not commit the external product tree.