# Example PRODUCT_LINK for RODEO sidecar (Gradle substitute for Linear Android)
# Env override: RODEO_PRODUCT_ROOT (maps to PRODUCT_ROOT in this file)
#
# Russell workstation example (Windows):
# PRODUCT_ROOT=C:\Users\russe\OneDrive\Desktop\New folder\RODEO
#
PRODUCT_ROOT=
PRODUCT_VERSION=0.1.0
SIDECAR_ID=RODEO-GRADLE-SUBSTITUTE
KIND=linear-android-sidecar
PAIRS_WITH=mobile-platform\nodes\android-lctl
ROLE=gradle-substitute-build-toolchain
VM_SUBSTRATE=mobile-platform\bottle-rocket
LINK_TARGET=mobile-platform\nodes\android-lctl\sidecar-rodeo\product
NOTE=Junction only; do not commit the external product tree.